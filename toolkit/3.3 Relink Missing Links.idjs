"use strict";

/**
 * relink_missing_from_doc_folder.idjs  —  Operator Tool
 *
 * 当前(或指定)文档若有断链(LinkStatus.LINK_MISSING)，在【文档目录及其所有子文件夹】
 * 里按文件名、大小写不敏感匹配，找到同名文件就 relink 并 update；找不到的报出来、不动。
 * 同名文件多处出现时：浅层优先(文档目录 > 子文件夹)、先到先得 → 不会误抓 package 里的深层副本。
 *
 *   bridge: automationOptions = {
 *     targetPath: "Z:\\…\\foo.indd",   // 默认 = activeDocument
 *     dryRun: false                     // true = 只报告该重链哪些，不实际 relink
 *   }
 *   manual: 双击对 activeDocument 运行，结果弹 <dialog>。
 *
 * 全部 relink 包在 app.doScript(ENTIRE_SCRIPT) → 单次 Ctrl/Cmd+Z 可一并撤销。
 * 仅处理 LINK_MISSING(断链)；LINK_OUT_OF_DATE(文件还在但被改过)是 Update 的事，不在范围。
 * 报告写 <docDir>/script_outputs/log/(走 lib/script_log_paths.js；不可用则退回 docDir 顶层)。
 *
 * Created 2026-06-30 (arch app-folio · user request)。遵循闸门 #3(fullName 是 Promise)/
 * #4(双击入口 require app + 顶级 await)/ app-folio UXP 枚举铁律(status 按 String().split.pop 比 name)。
 */

var indesign = require("indesign");
var app = (typeof globalThis !== "undefined" && globalThis.app) ? globalThis.app : indesign.app;
var ScriptLanguage = indesign.ScriptLanguage;
var UndoModes = indesign.UndoModes;
var fs = require("fs");
var uxp = require("uxp");
var lfs = uxp.storage.localFileSystem;

var AutomationBridge = null;
try { AutomationBridge = require("./lib/automation_bridge.js"); } catch (e) {}
var ScriptLogPaths = null;
try { ScriptLogPaths = require("./lib/script_log_paths.js"); } catch (e) {}

var SCRIPT_ID = "relink_missing_from_doc_folder";
var MAX_DIRS = 4000;     // 防超大资源树拖死 InDesign(命中即明示，不静默截断)
var MAX_DEPTH = 12;

// ─────────────────────────── helpers ───────────────────────────

function nativePathToFileUrl(p) {
    return "file:///" + String(p).replace(/\\/g, "/").replace(/^\/+/, "");
}
function parentDir(nativePath) {
    var p = String(nativePath);
    var idx = Math.max(p.lastIndexOf("\\"), p.lastIndexOf("/"));
    return idx >= 0 ? p.substring(0, idx) : p;
}
// UXP 枚举不能 === 比；String(enum) 形如 "LinkStatus.LINK_MISSING" → split(".").pop()。
function statusName(link) {
    try { return String(link.status).split(".").pop(); } catch (e) { return "UNKNOWN"; }
}

function _resolveDoc(pathStr) {
    if (!pathStr) {
        try { return app.activeDocument; } catch (e) { return null; }
    }
    var base = String(pathStr).replace(/^.*[\\/]/, "");
    for (var i = 0; i < app.documents.length; i++) {
        var d = app.documents.item(i);
        try { if (String(d.name) === base) return d; } catch (e) {}
    }
    return null;
}

async function getDocDir(doc) {
    var fn = await doc.fullName;        // 闸门 #3：Promise
    if (!fn || !fn.nativePath) return null;
    return parentDir(fn.nativePath);
}

// 递归(BFS·浅层优先)列文档目录及所有子文件夹的文件 → { 小写文件名: UXP entry }。
// first-wins：同名多处出现时保留先到的(浅层)，故文档同目录命中优先于深层 / 包内副本。
async function buildFolderFileMap(docDir) {
    var rootFolder = await lfs.getEntryWithUrl(nativePathToFileUrl(docDir));
    var map = {};
    var stats = { files: 0, dirs: 0, capped: false, maxDepth: 0, maxDirs: MAX_DIRS };
    var queue = [{ folder: rootFolder, depth: 0 }];
    var qi = 0;
    while (qi < queue.length) {
        var cur = queue[qi]; qi++;
        if (cur.depth > stats.maxDepth) stats.maxDepth = cur.depth;
        stats.dirs++;
        if (stats.dirs > MAX_DIRS) { stats.capped = true; break; }
        var entries;
        try { entries = await cur.folder.getEntries(); } catch (e) { continue; }
        for (var i = 0; i < entries.length; i++) {            // 本层文件先收(浅层优先)
            var e = entries[i];
            var isFile = false;
            try { isFile = e.isFile; } catch (_) {}
            if (!isFile) continue;
            var key = String(e.name).toLowerCase();
            if (!map[key]) { map[key] = e; stats.files++; }    // first-wins
        }
        if (cur.depth < MAX_DEPTH) {                          // 子文件夹入队(下一层)
            for (var k = 0; k < entries.length; k++) {
                var e2 = entries[k];
                var isFolder = false;
                try { isFolder = e2.isFolder; } catch (_) {}
                if (isFolder) queue.push({ folder: e2, depth: cur.depth + 1 });
            }
        }
    }
    return { map: map, stats: stats };
}

// 建 worklist：仅同步 DOM 读 + map 查 → 可在 doScript 外做。每项预存 path + entry 两种 relink 入参。
function buildWorklist(doc, fileMap) {
    var links = doc.links;
    var total = links.length;
    var work = [];
    for (var i = 0; i < total; i++) {
        var lk = links.item(i);
        if (statusName(lk) !== "LINK_MISSING") continue;
        var name = String(lk.name);
        var entry = fileMap[name.toLowerCase()] || null;
        work.push({
            link: lk,
            name: name,
            targetPath: entry ? entry.nativePath : null,
            targetEntry: entry
        });
    }
    return { work: work, totalLinks: total };
}

// 同步突变(在 doScript 内跑)。relink 先试路径字符串(host 实测可用)，失败回退预存的 UXP entry。
function applyRelinks(work, dryRun, stats, rows) {
    for (var j = 0; j < work.length; j++) {
        var item = work[j];
        if (!item.targetPath) {
            stats.notFound++;
            rows.push({ name: item.name, result: "not_found" });
            continue;
        }
        if (dryRun) {
            stats.wouldRelink++;
            rows.push({ name: item.name, result: "would_relink", target: item.targetPath });
            continue;
        }
        try {
            try { item.link.relink(item.targetPath); }
            catch (eStr) { item.link.relink(item.targetEntry); }   // 回退 entry(已预解析，同步)
            try { item.link.update(); } catch (eU) {}
            stats.relinked++;
            rows.push({ name: item.name, result: "relinked", target: item.targetPath });
        } catch (eR) {
            stats.failed++;
            rows.push({ name: item.name, result: "failed", error: String(eR && eR.message || eR) });
        }
    }
}

// 结果反馈：manual(双击)弹 <dialog>(闸门#4：button 用 div role=button，CSS 写死 px)；
// automation/无 webview → 跳过，靠 recordAutomationResult + 返回值。
async function showResult(text) {
    try {
        if (typeof document === "undefined" || !document.body) return;
        var dlg = document.createElement("dialog");
        dlg.style.cssText = "padding:16px;min-width:380px;max-width:620px;font-family:sans-serif;font-size:12px;color:#111;background:#fff;border:1px solid #888;";
        var pre = document.createElement("pre");
        pre.style.cssText = "white-space:pre-wrap;margin:0 0 14px 0;line-height:1.5;max-height:60vh;overflow:auto;";
        pre.textContent = text;
        var btn = document.createElement("div");
        btn.setAttribute("role", "button");
        btn.setAttribute("tabindex", "0");
        btn.textContent = "关闭";
        btn.style.cssText = "display:inline-block;padding:6px 18px;background:#2b6cb0;color:#fff;border-radius:4px;cursor:pointer;";
        function close() { try { dlg.close(); } catch (e) {} try { dlg.remove(); } catch (e) {} }
        btn.addEventListener("click", close);
        globalThis.__relinkClose = close;   // 供 AI/bridge 外部关闭(probe-close 协议)
        dlg.appendChild(pre);
        dlg.appendChild(btn);
        document.body.appendChild(dlg);
        dlg.showModal();
        await new Promise(function (r) { dlg.addEventListener("close", r, { once: true }); });
    } catch (e) { /* 无 webview → 跳过 */ }
}

// 写报告(优先 script_outputs/log/；ScriptLogPaths 不可用则退回 docDir 顶层，保证双击也能写)。
async function writeReport(docDir, docName, summary) {
    if (ScriptLogPaths) {
        try {
            await ScriptLogPaths.ensureLogDirAsync(docDir);
            var p = ScriptLogPaths.resolveLogPath(docDir, SCRIPT_ID, "json");
            fs.writeFileSync(p, JSON.stringify(summary, null, 2), "utf-8");
            return p;
        } catch (e) { /* fall through */ }
    }
    try {
        var sep = (docDir.indexOf("\\") >= 0) ? "\\" : "/";
        var fp = docDir + sep + docName + "." + SCRIPT_ID + "_report.json";
        fs.writeFileSync(fp, JSON.stringify(summary, null, 2), "utf-8");
        return fp;
    } catch (e2) { return null; }
}

function buildText(docName, docDir, scan, stats, rows, dryRun) {
    var lines = [];
    lines.push("文档: " + docName);
    lines.push("同目录: " + docDir);
    lines.push("扫描目录树: 目录 " + scan.dirs + " · 文件 " + scan.files + " · 最深 " + scan.maxDepth + " 层"
        + (scan.capped ? " · ⚠ 达 " + scan.maxDirs + " 目录上限已截断，部分子文件夹未扫" : ""));
    lines.push("断链(LINK_MISSING): " + stats.missing + " / 总链接 " + stats.totalLinks);
    for (var r = 0; r < rows.length; r++) {
        var row = rows[r];
        if (row.result === "relinked") lines.push("  ✓ 已重链: " + row.name + "  →  " + row.target);
        else if (row.result === "would_relink") lines.push("  ◌ (dry) 可重链: " + row.name + "  →  " + row.target);
        else if (row.result === "not_found") lines.push("  ✗ 目录树未找到同名文件: " + row.name);
        else if (row.result === "failed") lines.push("  ! 重链失败: " + row.name + " — " + row.error);
    }
    if (stats.missing === 0) lines.push("没有断链，无需处理。");
    else if (dryRun) lines.push("[dry-run] 可重链 " + stats.wouldRelink + " · 未找到 " + stats.notFound + "(共断链 " + stats.missing + ")");
    else lines.push("完成 — 重链 " + stats.relinked + " · 未找到 " + stats.notFound + " · 失败 " + stats.failed + "(共断链 " + stats.missing + ")");
    return lines.join("\n");
}

// ─────────────────────────── main ───────────────────────────

async function main() {
    var opts = null;
    if (AutomationBridge) {
        try { opts = await AutomationBridge.readAutomationOptions(SCRIPT_ID); } catch (e) { opts = null; }
    }
    var isAutomation = !!opts;
    var dryRun = !!(opts && opts.dryRun);
    var targetPath = opts && opts.targetPath;

    var doc = _resolveDoc(targetPath);
    if (!doc) {
        var m0 = "没有打开的文档(或找不到 targetPath 指定的文档)。";
        if (!isAutomation) await showResult(m0);
        return { aborted: true, reason: "no_target_doc", message: m0 };
    }
    var docName = ""; try { docName = String(doc.name); } catch (e) {}

    var docDir = null;
    try { docDir = await getDocDir(doc); } catch (e) {}
    if (!docDir) {
        var m1 = "文档「" + docName + "」尚未保存到磁盘，无法确定同目录。请先保存后重试。";
        if (!isAutomation) await showResult(m1);
        return { aborted: true, reason: "doc_not_saved", doc: docName, message: m1 };
    }

    var built;
    try { built = await buildFolderFileMap(docDir); }
    catch (e) {
        var m2 = "扫描目录树失败: " + (e && e.message ? e.message : String(e));
        if (!isAutomation) await showResult(m2);
        return { aborted: true, reason: "scan_failed", doc: docName, message: m2 };
    }
    var wl = buildWorklist(doc, built.map);

    var stats = { totalLinks: wl.totalLinks, missing: wl.work.length, relinked: 0, wouldRelink: 0, notFound: 0, failed: 0 };
    var rows = [];

    if (wl.work.length > 0) {
        function doRun() { applyRelinks(wl.work, dryRun, stats, rows); }
        try {
            app.doScript(doRun, ScriptLanguage.JAVASCRIPT, undefined,
                UndoModes.ENTIRE_SCRIPT, "Relink Missing From Doc Folder");
        } catch (eDS) {
            var m3 = "doScript 失败: " + (eDS && eDS.message ? eDS.message : String(eDS));
            if (!isAutomation) await showResult(m3);
            return { aborted: true, reason: "doscript_failed", doc: docName, message: m3 };
        }
    }

    var summary = {
        ts: new Date().toISOString(),
        scriptId: SCRIPT_ID,
        doc: docName,
        docDir: docDir,
        dryRun: dryRun,
        scan: built.stats,
        stats: stats,
        rows: rows
    };
    summary.text = buildText(docName, docDir, built.stats, stats, rows, dryRun);
    summary.report_path = await writeReport(docDir, docName, summary);

    if (isAutomation && AutomationBridge && AutomationBridge.recordAutomationResult) {
        try { await AutomationBridge.recordAutomationResult(SCRIPT_ID, { ok: stats.failed === 0, summary: summary }); }
        catch (eAR) {}
    }
    if (!isAutomation) await showResult(summary.text);

    return summary;
}

var __result = null;
try { __result = await main(); }
catch (eTop) {
    __result = { fatal: String(eTop && (eTop.stack || eTop.message) || eTop) };
    try { if (typeof showResult === "function") await showResult("脚本出错: " + __result.fatal); } catch (e2) {}
}
module.exports = __result;
