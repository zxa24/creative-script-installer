                  + " allowDowngrade=" + (__mfWrap.allowDowngrade === true)
                  + " replaced=" + __mfWrap.replaced
                  + " skippedDowngrade=" + (__mfWrap.skippedDowngrade || 0)
                  + " failed=" + __mfWrap.failed);
