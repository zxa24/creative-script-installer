            // (findings.md#bridge-32b) — the target is a generated translated.indd.
            var __backupGate = { required: false, ok: true };
            if (__inPlaceImport) {
                if (__processing) __processing.update("Backing up before overwrite (verified)", 94);
                var __backupDir = srcDir + srcSep + "script_outputs" + srcSep + "backup";
                // 🔴 The backup dir MUST be created with the async helper, not
                // FileUtils.ensureParentDir: that one goes through
                // `fs.mkdirSync`, WHICH DOES NOT EXIST IN UXP, so it silently
                // created nothing and returned false — which runBackupGate then
                // ignored. Net effect (2026-08-28 owner run, and every in-place
