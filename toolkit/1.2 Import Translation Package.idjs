            // targets default to M5 (466fbef) → without this guard, G preset +
            // CJK = silent matched=0 falsely reported as success. Skip honestly
            // with an explicit reason instead.
            if (__pickedPresetPath) {
                try {
                    var __applyRunner = require("./lib/brand_preset_apply_runner.js");
                    var __presetExportGlue = require("./lib/brand_preset_export_glue.js");
                    var __tpPool = __presetExportGlue.collectTPStyles(workDoc);
                    if (!__tpPool || __tpPool.length === 0) {
                        report.g_apply = { skipped: true, reason: "no _T_p_* style pool (minimal-apply/M5 path) — preset not applicable" };
                        plog("G preset inline apply SKIPPED: no _T_p_* pool (M5/minimal-apply) — preset=" + __pickedPresetPath);
                    } else {
                        if (__processing) __processing.update("Applying style preset (no progress shown)", 96);
                        plog("G preset inline apply START: " + __pickedPresetPath + " (_T_p_* pool=" + __tpPool.length + ")");
                        var __covReport = __applyRunner.applyBrandStylePresetToDoc(workDoc, {
                            presetPath: __pickedPresetPath,
                            presetWins: false,
                            log: plog
                        });
                        report.g_apply = __covReport;   // 直接嵌 coverageReport (r1 [B])
                        plog("G preset inline apply DONE: ok=" + (__covReport && __covReport.ok)
                            + " appliedEntries=" + (__covReport && __covReport.applied_preset_entries)
                            + " reuse=" + (__covReport && __covReport.reuse_rate_pct) + "%"
                            + " matchedStubs=" + (__covReport && __covReport.matched_stub_count)
                            + " stamp=" + (__covReport && __covReport.stamp_written));
                    }
                } catch (eGApply) {
                    report.g_apply = { error: (eGApply && eGApply.message ? eGApply.message : String(eGApply)) };
                    plog("G preset inline apply ERROR (non-fatal, save proceeds): "
                        + (eGApply && eGApply.message ? eGApply.message : eGApply));
