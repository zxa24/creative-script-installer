        };

        if (pipelineResult && !pipelineResult.aborted && !pipelineResult.blocked) {
            __runMissingFontSweep("MissingFontRemapPreSave", "missing_fonts_remapped");
        }


        if (pipelineResult && !pipelineResult.aborted && !pipelineResult.blocked) {
            report.pipeline_stage = "save";

            // ── 8D-ext-GI: inline brand-style-preset APPLY ──────────────────
            // If the user picked a style preset (G), apply it NOW — after the
            // pipeline doScript + missing-font remap, BEFORE workDoc.save — so
            // the SAME save persists the applied geometry to the
            // .translated.indd on disk (r1 [A]#2: apply排在save后则落盘版不含
            // brand几何). The runner wraps its writes in its own ENTIRE_SCRIPT
            // doScript = an INDEPENDENT undo step. Non-fatal: an apply error is
            // logged + surfaced in the summary; it never rolls back or blocks
            // the save. Replaces the old 2-step tee-up alert (which only pointed
