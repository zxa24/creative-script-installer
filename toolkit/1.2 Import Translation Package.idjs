// 名变量。main() 把自己创建的 ProcessingDialog controller 暴露到这里，
// 顶层 try/finally 兜底关，避免 main 抛 fatal 时弹窗一直挂着。
var __topLevelProcessing = null;
var getCollectionItem = require("./lib/utils.js").getCollectionItem;

// lib/work_copy.js exists but its sync withDocumentCopy is not UXP-safe
// for file I/O (saveACopy/open/close are async in UXP). v2 inlines the
// workCopy lifecycle in main() with explicit await. work_copy.js is kept
// for future async refactor + Node-side use.
var FontMapping = require("./lib/font_mapping.js");
var SegmentLocator = require("./lib/segment_locator.js");
var StyleSheetBuilder = require("./lib/style_sheet_builder.js");
var ScriptClassifier = require("./lib/script_classifier.js");
var EmphasisExtractor = require("./lib/emphasis_extractor.js");
var StyleApplier = require("./lib/style_applier.js");
var HardErrors = require("./lib/hard_errors.js");
var StyleMergeAdvisor = require("./lib/style_merge_advisor.js");
// 2026-05-28: v2 dialog opt-in (see reorganize_styles_inplace.idjs header).
var USE_V2_DIALOG = true;
var ReorganizeDialog = USE_V2_DIALOG
    ? require("./lib/reorganize_dialog_v2.js")
    : require("./lib/reorganize_dialog.js");
var AutomationBridge = require("./lib/automation_bridge.js");
var ReorganizeDocOps = require("./lib/reorganize_doc_ops.js");
var SnapshotUtils = require("./lib/snapshot_utils.js");
var SnapshotWriter = require("./lib/snapshot_writer.js");
var StoryUtils = require("./lib/story_utils.js");
var RepairAfterApply = require("./lib/repair_after_apply.js");
var V2Pipeline = require("./lib/v2_pipeline.js");
var ZipCore = require("./lib/zip_core.js");
var DocProvenance = require("./lib/doc_provenance.js");
var ImportStateStore = require("./lib/import_state_store.js");
var ProjectMetaLabel = require("./lib/project_meta_label.js");
var ProjectMetaAssemble = require("./lib/project_meta_assemble.js");
var PreOverwriteBackup = require("./lib/pre_overwrite_backup.js");
var VersionManifest = require("./lib/version_manifest.js");
var ProjectUid = require("./lib/project_uid.js");
// 8D-ext-D step-3b: M4/M5 importer byPair wiring (mode default + hazard +
// discovery paths + ctx shape live in the lib so Node can test them).
var ByPairWiring = require("./lib/import_byPair_wiring.js");
var CjkPreference = require("./lib/cjk_preference.js");
var FontMappingPairs = require("./lib/font_mapping_pairs.js");
var LangScriptTableLib = require("./lib/lang_script_table.js");
var ByPairSweep = require("./lib/byPair_char_sweep.js");
var ScriptFontEnforcer = require("./lib/script_font_enforcer.js");
// 8D-ext-bypair-tofu-ux: early-warning (Hook A) reuses the SAME scan + resolve
// the end sweep uses, so the unowned 判据 is byte-identical (no drift).
var FMR = require("./lib/font_mapping_resolve.js");
var DocScan = require("./lib/font_mapping_doc_scan.js");

// ---------------------------------------------------------------------------
// Translation .zip support — extracts a translation package zip to a sibling
// `_unzipped_<ts>/` folder and resolves the embedded translations.json.
//
// Zip layout convention (see zip_folder.idjs + export_translation_package.idjs
// buildPackageZip): single top-level folder containing translations.json /
// segments.json / .idml / etc. The helper handles both that shape AND a
// "flat" archive (entries directly at root).
// ---------------------------------------------------------------------------
async function __extractTranslationZip(zipEntry, zipNativePath) {
    var formats = uxp.storage.formats;
    var fs2 = require("fs");

    // Read + decompress (ZipCore enforces Zip Slip + bomb limits).
    var zipBytes;
    try {
        zipBytes = new Uint8Array(await zipEntry.read({ format: formats.binary }));
    } catch (eR) {
        return { ok: false, error: "read .zip failed: " + ((eR && eR.message) || eR) };
    }
    var entries;
    try { entries = ZipCore.readZip(zipBytes); }
    catch (eU) { return { ok: false, error: "decompress failed: " + ((eU && eU.message) || eU) }; }

    var keys = Object.keys(entries);
    if (keys.length === 0) return { ok: false, error: "empty archive" };

    // Output dir: sibling of the zip, with timestamp to avoid collisions.
    var sep = (zipNativePath.indexOf("\\") >= 0) ? "\\" : "/";
    var lastSep = zipNativePath.lastIndexOf(sep);
    var parentPath = lastSep > 0 ? zipNativePath.substring(0, lastSep) : zipNativePath;
    var zipBaseName = lastSep >= 0 ? zipNativePath.substring(lastSep + 1) : zipNativePath;
    var stemMatch = zipBaseName.match(/^(.+)\.zip$/i);
    var zipStem = stemMatch ? stemMatch[1] : zipBaseName;
    var d = new Date();
    function p2(n) { return (n < 10 ? "0" : "") + n; }
    var ts = d.getFullYear() + p2(d.getMonth() + 1) + p2(d.getDate())
        + "_" + p2(d.getHours()) + p2(d.getMinutes()) + p2(d.getSeconds());
    var outDirName = zipStem + "_unzipped_" + ts;

    var parentFolder;
    try {
        var parentUrl = "file:///" + parentPath.replace(/\\/g, "/").replace(/^\/+/, "");
        parentFolder = await lfs.getEntryWithUrl(parentUrl);
    } catch (eP) {
        return { ok: false, error: "cannot access zip parent folder: " + eP.message };
    }
    var outRootFolder;
    try { outRootFolder = await parentFolder.createFolder(outDirName); }
    catch (eC) { return { ok: false, error: "createFolder " + outDirName + ": " + eC.message }; }

    async function ensureFolderChain(rootFolder, segments) {
        var cur = rootFolder;
        for (var i = 0; i < segments.length; i++) {
            var seg = segments[i];
            if (!seg) continue;
            var existing = null;
            try { existing = await cur.getEntry(seg); } catch (e) { existing = null; }
            if (existing && existing.isFolder) cur = existing;
            else if (existing && existing.isFile) {
                throw new Error("path conflict at " + seg + ": existing entry is a file");
            } else cur = await cur.createFolder(seg);
        }
        return cur;
    }

    var translationsEntry = null;
    for (var ki = 0; ki < keys.length; ki++) {
        var archivePath = keys[ki];
        var bytes = entries[archivePath];
        // Directory marker — path ends with /, zero bytes
        if (archivePath.charAt(archivePath.length - 1) === "/" && bytes.length === 0) {
            try { await ensureFolderChain(outRootFolder, archivePath.split("/").filter(Boolean)); }
            catch (eD) { return { ok: false, error: "mkdir " + archivePath + ": " + eD.message }; }
            continue;
        }
        var parts = archivePath.split("/");
        var fileName = parts[parts.length - 1];
        var folderSegs = parts.slice(0, -1);
        var leafFolder;
        try {
            leafFolder = folderSegs.length > 0
                ? await ensureFolderChain(outRootFolder, folderSegs)
                : outRootFolder;
            var f = await leafFolder.createFile(fileName, { overwrite: true });
            await f.write(bytes.buffer, { format: formats.binary });
            if (fileName === "translations.json" && !translationsEntry) {
                translationsEntry = f;
            }
        } catch (eF) {
            return { ok: false, error: "extract " + archivePath + ": " + eF.message };
        }
    }
    if (!translationsEntry) {
        return { ok: false, error: "translations.json not found inside .zip" };
    }
    // 2026-05-28: 把解压根目录路径回传出去，让 main() 在 import 成功后
    // 用 FileUtils.deleteFolderRecursiveAsync 删掉（zip 已经用完不再需要
    // 那份解压树，仅占盘）。
    return {
        ok: true,
        translationsEntry: translationsEntry,
        unzippedFolderPath: (outRootFolder && outRootFolder.nativePath) || (parentPath + sep + outDirName)
    };
}


var readUtf8File = common.readUtf8File;
var writeUtf8File = common.writeUtf8File;
var hashDjb2Hex = common.hashDjb2Hex;
var compactTimestampNow = common.compactTimestampNow;
var utcIsoNow = common.utcIsoNow;

var SCHEMA_VERSION = "translation-mvp-1";
var IMPORT_V2_REV = "2026-04-26-v2-real-workcopy";

// UXP InDesign 18+ has no Document.saveAs — must use save(File, stationery=false).
// userInteractionLevel.NEVER_INTERACT suppresses missing-link / font-fallback /
// overwrite-confirm modal dialogs that would otherwise deadlock the script.
// Both findings validated via bridge isolation test (commit f58d799).
var UserInteractionLevels = indesign.UserInteractionLevels;

// ─── Font index helpers (extracted from import_translations.idjs) ─────

var _fontIndex = null;

function buildFontIndex() {
    if (_fontIndex) return;
    _fontIndex = {};
    try {
        var allNames = app.fonts.everyItem().name;
        var allFamilies = app.fonts.everyItem().fontFamily;
        if (typeof allNames === "string") allNames = [allNames];
        if (typeof allFamilies === "string") allFamilies = [allFamilies];
        for (var i = 0; i < allNames.length; i++) {
            var nameKey = allNames[i].toLowerCase();
            var famKey = allFamilies[i].toLowerCase();
            if (!_fontIndex[nameKey]) _fontIndex[nameKey] = i;
            if (!_fontIndex[famKey]) _fontIndex[famKey] = i;
        }
    } catch (e) {
        try {
            for (var j = 0; j < app.fonts.length; j++) {
                var fi = app.fonts[j];
                var nk = fi.name.toLowerCase();
                var fk = fi.fontFamily.toLowerCase();
                if (!_fontIndex[nk]) _fontIndex[nk] = j;
                if (!_fontIndex[fk]) _fontIndex[fk] = j;
            }
        } catch (e2) {}
    }
}

function findFontByName(name) {
    if (!name) return null;
    var tryNames = [name, name + "\tRegular", name + "\tNormal", name + "\tBook", name + "\tMedium"];
    for (var t = 0; t < tryNames.length; t++) {
        try {
            var f = app.fonts.item(tryNames[t]);
            if (f.isValid && f.status !== FontStatus.NOT_AVAILABLE) return f;
        } catch (e) {}
    }
    buildFontIndex();
    var key = String(name).toLowerCase();
    var idx = _fontIndex.hasOwnProperty(key) ? _fontIndex[key] : -1;
    if (idx < 0) {
        for (var k in _fontIndex) {
            if (k.indexOf(key) >= 0) { idx = _fontIndex[k]; break; }
        }
    }
    if (typeof idx === "number" && idx >= 0) {
        try { return app.fonts[idx]; } catch (e2) {}
    }
    return null;
}

// _brandFontAvailable — 8D-ext-UNIFY-core F2 (REV gate-3): a CORRECT font
// availability check, ISOLATED from the shared findFontByName (which is
// UXP-enum-broken: `f.status !== FontStatus.NOT_AVAILABLE` is ALWAYS TRUE
// because UXP rebuilds the enum wrapper per access, and its index fallback has
// no status check at all → an UNAVAILABLE brand returns truthy → false-positive
// M4 + hazard-suppressed → silent SHS/tofu, saved). Uses the stringify-enum
// pattern proven in reorganize_inplace_core.js:150-156. Do NOT replace
// findFontByName (avoids rippling its other callers).
function _brandFontAvailable(name) {
    if (!name) return false;
    var tryNames = [name, name + "\tRegular", name + "\tBook", name + "\tMedium"];
    for (var t = 0; t < tryNames.length; t++) {
        try {
            var f = app.fonts.item(tryNames[t]);
            if (!f || !f.isValid) continue;
            var s = String(f.status);                 // stringify — enum identity is broken
            if (s.indexOf(".") >= 0) s = s.split(".").pop();
            if (s !== "NOT_AVAILABLE") return true;
        } catch (e) {}
    }
    return false;
}

// ─── Path helpers ─────────────────────────────────────────────────

function _stripIndExt(p) {
    var s = String(p || "");
    var lower = s.toLowerCase();
    if (lower.lastIndexOf(".indd") === lower.length - 5) return s.substring(0, s.length - 5);
    if (lower.lastIndexOf(".idml") === lower.length - 5) return s.substring(0, s.length - 5);
    return s;
}

function _basename(p) {
    var s = String(p || "");
    var idx = Math.max(s.lastIndexOf("/"), s.lastIndexOf("\\"));
    return idx >= 0 ? s.substring(idx + 1) : s;
}

// ─── Translations payload ─────────────────────────────────────────

function loadTranslations(jsonPath) {
    var raw = readUtf8File(jsonPath);
    var payload = JSON.parse(raw);
    var rows = [];
    if (payload && payload.translations && payload.translations.length) {
        rows = payload.translations;
    } else if (payload && payload.length) {
        rows = payload;
    }
    var byTid = {};
    for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        if (r && r.tid) byTid[r.tid] = r;
    }
    return { rows: rows, byTid: byTid, raw: payload };
}

function loadSegmentsSidecar(folderPath) {
    var sep = RuntimePaths.getSep(folderPath);
    var candidates = [
        folderPath + sep + "segments.json",
        folderPath + sep + "segments_meta.json"
    ];
    for (var i = 0; i < candidates.length; i++) {
        try {
            var t = readUtf8File(candidates[i]);
            var p = JSON.parse(t);
            var segs = (p && p.segments) ? p.segments : (p && p.length ? p : []);
            if (segs && segs.length) {
                return { path: candidates[i], segments: segs, payload: p };
            }
        } catch (e) {}
    }
    return null;
}

// ─── runPipeline + applyOnePara ─────────────────────────────────
// Moved to lib/v2_pipeline.js — required as V2Pipeline at top of file.
// Both this .idjs entry and tests/bridge/bridge_run_v2_pipeline.js use
// the same lib code, so any pipeline change has a single canonical home.

// ─── Entry point ─────────────────────────────────────────────────

async function main() {
    // Resolve the project base dir from app.activeScript so panel
    // double-click runs (where lib/*.js modules see __dirname=undefined)
    // get correct .scratch / temp_data / log paths. Idempotent and a
    // no-op once DEFAULT_BASE_DIR is non-empty. Must precede any
    // RuntimePaths.getDataDir() / getLogDir() / getScratchDir() read.
    try { await RuntimePaths.bootstrap(); } catch (eBoot) {}

    // #BRIDGE-6: consume automation options EARLY so isAutomatedRun()
    // returns true for every downstream showAlert / error gate. Without
    // this, the "Please open the source InDesign document first." alert
    // below fires a DOM dialog under bridge runs (where main() may be
    // entered with no doc open — e.g. operator closed the source while
    // troubleshooting) and the bridge's main thread sits in the modal
    // until someone clicks OK, killing the entire automation run.
    //
    // The actual options are re-read further down (Stage ⓪.0 reorganize
    // panel skip) — readAutomationOptions clears the source channel
    // after consuming, so we cache the result here on the global
    // closure for that later code to pick up. Falls back to a fresh
    // peek if cache missed (interactive run, no payload).
    var __autoOptsCached = null;
    try { __autoOptsCached = await AutomationBridge.readAutomationOptions("import_integrated"); }
    catch (eABEarly) { /* peek-only — not fatal */ }

    if (app.documents.length === 0) {
        // #BRIDGE-6: in automated runs, try to open the source from the
        // path the caller supplied via automationOptions.sourcePath —
        // this is the "operator hit re-run after closing the doc" case
        // we kept tripping on. Falls through to showAlert if no path
        // was provided (which is already bridge-aware via #26).
        var __autoSrcPath = __autoOptsCached && __autoOptsCached.sourcePath;
        if (__autoSrcPath && AutomationBridge.isAutomatedRun("import_integrated")) {
            try { app.scriptPreferences.userInteractionLevel = UserInteractionLevels.NEVER_INTERACT; } catch (eBA) {}
            try {
                // showingWindow=true so the doc becomes active and the
                // downstream `app.activeDocument` lookup at line ~573
                // resolves — opening invisible leaves app.documents
                // non-empty but app.activeDocument throws "No documents
                // are open." Source open is read-only from pipeline's
                // perspective (we fs.copyFile the bytes to the work
                // copy) so the extra UI cost is irrelevant.
                await app.open(String(__autoSrcPath), true);
            } catch (eOpenAuto) {
                showAlert("Could not open source from automationOptions.sourcePath: " + (eOpenAuto && eOpenAuto.message ? eOpenAuto.message : eOpenAuto));
                return;
            }
        }
        if (app.documents.length === 0) {
            showAlert("Please open the source InDesign document first.");
            return;
        }
    }

    // ── pick translations.json (only allowed top-level await) ──
    // Test/automation bypass: if IMPORT_PACKAGE_DIR env var is set, look
    // for translations.json inside that folder and skip the file picker.
    // Falls through to interactive picker on any failure so production
    // usage is unchanged.
    var jsonEntry = null;
    var envImportDir = "";
    try { envImportDir = (process && process.env && process.env.IMPORT_PACKAGE_DIR) || ""; } catch (eEnvI) {}
    if (envImportDir) {
        try {
            var envSep = (envImportDir.indexOf("\\") >= 0) ? "\\" : "/";
            var envJsonPath = envImportDir.replace(/[\\\/]+$/, "") + envSep + "translations.json";
            var envFileUrl = "file:///" + envJsonPath.replace(/\\/g, "/").replace(/^\/+/, "");
            jsonEntry = await lfs.getEntryWithUrl(envFileUrl);
        } catch (eEnvJson) {
            jsonEntry = null;
        }
    }
    if (!jsonEntry) {
        // Accept either a translations.json directly OR a .zip package (which
        // we auto-extract to a sibling folder, then locate translations.json
        // inside it). Same picker invocation handles both.
        jsonEntry = await lfs.getFileForOpening({ types: ["json", "zip"] });
    }
    if (!jsonEntry) {
        // 取消不弹窗（owner 2026-08-30）：**主动取消是有意行为，不需要被告知**
        // —— 同元数据那一区的裁决。以前这里 showAlert，现在只留痕、不打扰。
        //
        // 🔴 为什么是 console.log 而不是 plog：**plog 在这一行是【静默 no-op】。**
        // 它定义在 :512（函数声明提升 ⇒ 这里调得到），但闭包依赖
        // progressLogPath/_logBuffer/_fsRef 在 :509-511 才赋值 ⇒ 此处 _fsRef 是
        // undefined，写盘抛 TypeError，又被 plog 自己的 try/catch 吞掉：一个字不写、
        // 也不报错。**行 381-510 整段都是这个死窗口**，本文件四个早退点
        // （425 / 430 / 本行 / 477）全在里面 —— 那四处「只弹窗不记日志」不是风格，
        // 是那里只有这一个通道。详见 findings.md#plog-is-a-silent-noop-before-its-deps
        // （发现者 panelfix，2026-08-29）。
        //
        // ⚠ console.log 的弱点要说清：**要开着 UDT 控制台才看得到** ——
        // 它是「留痕存在」，⛔ 不是「可靠可发现」。取消是良性路径，这个强度够用；
        // ⛔ 但别把同样的强度用在【失败】路径上（425/430/477 仍然弹窗，见下方测试的反向控制）。
        //
        // ⚠ 并且这一支分不开两件事：`getFileForOpening` 回空既可能是【用户点了取消】，
        // 也可能是【装置返回了空】（同 picker_outcome 的那个混淆）；该调用无 try/catch，
        // 真抛会往上冒、不走这里。所以下面这句措辞只说「没有选包」，⛔ 不断言是谁的意图。
        try { console.log("[import_integrated] cancelled: no translation package selected (no alert by design)"); } catch (eFPC) {}
        return;
    }

    // ZIP branch: extract package to <zipParent>/<zipName>_unzipped_<ts>/ and
    // point jsonEntry at the translations.json inside.
    // 2026-05-28: __zipExtractedFolderToCleanup 记录解压根目录路径；
    // import 成功结尾会用 FileUtils.deleteFolderRecursiveAsync 删除该
    // 文件夹（zip 已经用完、解压树纯占盘）。失败路径不删，保留供调试。
    var __zipExtractedFolderToCleanup = "";
    if (jsonEntry.name && /\.zip$/i.test(jsonEntry.name)) {
        var zipPath = jsonEntry.nativePath;
        var zipExtracted = await __extractTranslationZip(jsonEntry, zipPath);
        if (!zipExtracted.ok) {
            showAlert("Failed to extract .zip package:\n" + zipExtracted.error);
            return;
        }
        jsonEntry = zipExtracted.translationsEntry;
        __zipExtractedFolderToCleanup = zipExtracted.unzippedFolderPath || "";
    }

    var jsonPath = jsonEntry.nativePath;
    var parentDir = FileUtils.getOutputDirectory(jsonPath);
    var sep = RuntimePaths.getSep(parentDir);

    // 2026-05-28: Progress log moved to <docDir>/script_outputs/log/.
    // When the active doc has a path we use its parent dir; else fall back
    // to the unzipped package's parentDir so the log is still next to the
    // payload being imported. Report JSON (line ~1790) stays in parentDir.
    var __logBaseDir = "";
    try {
        if (app.documents.length > 0) {
            var __ad = app.activeDocument;
            try {
                var __adFn = __ad.fullName;
                if (__adFn && typeof __adFn.then === "function") __adFn = await __adFn;
                var __adPath = (__adFn && (__adFn.nativePath || __adFn.fsName)) || "";
                if (__adPath) {
                    var __lp = Math.max(__adPath.lastIndexOf("\\"), __adPath.lastIndexOf("/"));
