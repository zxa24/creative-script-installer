"use strict";

/**
 * import_translations_v2.idjs — UXP version (Phase 1-4 lib pipeline)
 *
 * Single-doc flow (2026-04-30 revision):
 *
 *   ⓪.0 Reorganize panel  — user picks dimensions / KDE / colorTol /
 *                            soft-break / safety / edit-mode / spacing-merge
 *   ⓪.a Capture source path
 *   ⓪.b INTERACT_WITH_ALL → saveACopy(source) → <stem>.translated.indd
 *        app.open(<stem>.translated.indd, true) → workDoc visible + active
 *        (user resolves missing fonts/links once at this point)
 *        NEVER_INTERACT for pipeline body
 *   ⓪.c Preflight snapshot (runSafety)
 *   ① Analyze     — buildStylePlan + locateAllSegments + runPreflight
 *   ② Gate        — block on preflight.blocking
 *   ③ Commit      — commitStylePlanGuarded + applyCluster/Annotations + write target
 *                   (preceded by splitSoftBreaks preclean inside same doScript)
 *   ④ Postflight  — runPostflight (overset / cluster_apply_failure / mixed)
 *   ④.5 Repair    — RepairAfterApply.runRepair (runSafety)
 *   ⑤ Save        — INTERACT_WITH_ALL restored
 *                   Success → workDoc.save() in place; doc stays open
 *                   Failure → close workDoc + delete .translated.indd
 *
 * Single open, single state — no save→close→reopen cycle. The previous
 * close/reopen cycle caused recomposition divergence (silent font
 * substitution during pipeline vs. user-confirmed substitution after
 * reopen → ~13 frames overflowed post-reopen even though repair logged
 * overflows=false on the workDoc). Now everything happens in one doc
 * with one font-resolution state.
 *
 * Source doc is opened READ-ONLY for saveACopy and never written.
 * Postflight no longer routes to QUARANTINED — postflight stats stay
 * in report.json but don't change filename suffix (postflight passing
 * doesn't certify acceptance, postflight failing doesn't mean unusable;
 * both need human review).
 *
 * Coexists with import_translations.idjs (the legacy in-place writeback);
 * routing/feature-flag is the user's choice via which command they invoke.
 */

var indesign = require("indesign");
var app = indesign.app;
var ScriptLanguage = indesign.ScriptLanguage;
var UndoModes = indesign.UndoModes;
var SaveOptions = indesign.SaveOptions;
var FontStatus = indesign.FontStatus;
var LinkStatus = indesign.LinkStatus;
var ColorSpace = indesign.ColorSpace;
var ColorModel = indesign.ColorModel;
var Position = indesign.Position;
var Justification = indesign.Justification;
var Leading = indesign.Leading;
var ListType = indesign.ListType;
var MeasurementUnits = indesign.MeasurementUnits;
var RuleWidth = indesign.RuleWidth;
var TabStopAlignment = indesign.TabStopAlignment;   // [indent-general] tab-stop enum for style_sheet_builder._applyTabStops

var uxp = require("uxp");
var lfs = uxp.storage.localFileSystem;

var common = require("./lib/translation_common.js");
var RuntimePaths = require("./lib/runtime_paths.js");
var ScriptLogPaths = require("./lib/script_log_paths.js");
var ProcessingDialog = require("./lib/processing_dialog.js");
var FileUtils = require("./lib/file_utils.js");
var HostEnvGuard = require("./lib/host_env_guard.js");

