        ctx.splitSoftBreaks       = true;
        ctx.runSafety             = true;
        ctx.splitMasterFromBody   = !(translations && translations.split_master_from_body === false);
        report.reorganize_choice = {
            auto_merge: "hybrid",
            hybrid_preset_index: 2,
            color_tol: 1,
            space_preserving_merge: ctx.spacePreservingMerge,
            edit_mode: false,
            split_soft_breaks: true,
            run_safety: true,
            split_master_from_body: ctx.splitMasterFromBody,
            dimensions: null,
            from_translations_skip: true
        };
        plog("reorganize: translations.skip_reorganize_dialog override → operator defaults applied");
    } else {
        plog("reorganize panel skipped (skipReorganizeDialog=" + skipReorganizeDialog
            + " skipStyleCleanup=" + ctx.skipStyleCleanup + ")");
    }

    // TODO#42 (2026-08-13): ProcessingDialog used to open HERE ("用户已经过完
    // 所有交互" — true when written 2026-05-28, when the only interactions were
    // the zip pick + reorganize panel above). Later stages FALSIFIED that
    // assumption without anyone touching this line: the byPair import-mode
    // dialog, the font-mapping panels and the M4-CJK hazard dialog were all
    // inserted DOWNSTREAM of it, so two kinds of "waiting for the operator"
    // windows opened underneath a "processing" indicator — the owner-reported
    // "can't tell if it's waiting for me or working" symptom. The show() now
    // lives AFTER the last interactive stage (past the hazard dialog, before
    // the in-place/saveACopy fork). Only the declaration stays here — every
    // later use is `if (__processing)`-guarded, so the null window is safe.
    var __processing = null;

    // ── Single-doc flow (2026-04-30 revision) ──
    //
    // Goal: avoid the recomposition divergence we saw on real translations.
    // The previous flow opened workDoc with showingWindow=false +
    // NEVER_INTERACT during pipeline, then save → close → reopen with
    // INTERACT_WITH_ALL afterwards. The two font-resolution states
    // (silent substitution during pipeline vs. user-confirmed substitution
    // after reopen) produced different line metrics → fit-to-content frame
    // heights set during repair were too small for the reopen state →
    // ~13 frames overflowed post-reopen even though repair logged
    // overflows=false on the workDoc.
    //
    // New sequence — single open, single state, no reopen:
    //   ⓪.a Capture source path
    //   ⓪.b Set INTERACT_WITH_ALL (let user resolve missing fonts/links once)
    //       saveACopy(source) → <stem>.translated.indd  (target path directly)
    //       app.open(.translated.indd, true) → workDoc visible + active
    //       Now switch to NEVER_INTERACT for pipeline body
    //   ⓪.c Preflight snapshot (runSafety)
    //   ① runPipeline(workDoc) inside app.doScript
    //   ④.5 RepairAfterApply.runRepair(workDoc is already activeDocument)
    //   ⑤ Restore INTERACT_WITH_ALL
    //       Success → workDoc.save() in place (same path it was opened from)
    //                  Doc stays open as the deliverable.
    //       Failure → close workDoc + delete .translated.indd (it was a
    //                  source clone before pipeline; nothing useful to keep)
    //
    // saveACopy/app.open/save/close are async-aware in UXP, so we await
    // them outside doScript. Pipeline body (sync DOM mutations) stays
    // inside doScript.
    var pipelineResult = null;
    var saveTargetPath = null;
    var workDoc = null;
    // #BRIDGE-6: app.activeDocument throws "No documents are open." when
    // every open doc is invisible (no UI window — happens when BRIDGE-6
    // above had to open the source from automationOptions.sourcePath and
    // showingWindow=true didn't materialize a window in the bridge's
    // headless context, or when a prior run left the doc open invisible).
    // Fall back to app.documents.firstItem() in that case.
    var sourceDoc = null;
    try { sourceDoc = app.activeDocument; }
    catch (eAD) {
        try { if (app.documents.length > 0) sourceDoc = app.documents.firstItem(); } catch (eFD) {}
    }
    if (!sourceDoc) {
        showAlert("No source document available after auto-open attempt.");
        return;
    }
    var sourcePathStr = "";

    // #E2E-11 guardrail: refuse to import when the active document is a
    // previously-translated output (e.g. "*.translated.indd"). Letting that
    // through cascades into "*.translated.translated.indd" + double-applied
    // cluster styles + emphasis runs colliding with already-baked
    // _T_p_* / _T_c_emp_* / _T_c_link styles — InDesign crashed in
    // runPipeline on the e2e re-run after a stale active-doc state. Surface
    // a clear error to the operator instead of corrupting their working
    // copy. The check covers `.translated`, `.aborted`, and `.BLOCKED`
    // markers since import emits all three suffixes.
    // Provenance check: classify the source doc to decide between fresh
    // import (saveACopy → .translated.indd) and in-place edit-mode re-import
    // (workDoc = sourceDoc, no copy). The decision driver is the presence of
    // a valid translation_import_state_v1 label written by a prior import —
    // not the filename. See lib/doc_provenance.js for signal hierarchy.
    var __sourceProv = null;
    try { __sourceProv = DocProvenance.classify(sourceDoc); }
    catch (eProv) { plog("WARN: DocProvenance.classify threw: " + eProv.message); }
    var __inPlaceImport = !!(__sourceProv && __sourceProv.state === "imported-with-state");
    // Legacy promotion: source has _T_p_* clusters but no import-state label
    // (= imported by a build of the toolkit older than the label-write
    // feature, OR label was lost / deleted). Without promotion these docs
    // would get full-pipeline → duplicate cluster pool → paragraphs
    // reassigned → headings can disappear. With promotion, the pipeline
    // synthesizes a sidecar from the workDoc's current state after locate,
    // so edit-mode classify protects unchanged paragraphs.
    var __legacyPromotion = !!(__sourceProv && __sourceProv.state === "imported-legacy");
    if (__sourceProv) {
        var __mode = __inPlaceImport
            ? "in-place edit-mode import"
            : (__legacyPromotion ? "saveACopy + legacy-promotion edit-mode" : "fresh saveACopy import");
        plog("source provenance: " + DocProvenance.formatSummary(__sourceProv) + " → " + __mode);
    }
    // Honor reorganize dialog's "Force full pipeline" checkbox: operator can
    // override edit-mode detection even when a valid label is present
    // OR override legacy promotion when they intentionally want a re-cluster.
    if ((__inPlaceImport || __legacyPromotion) && ctx.__forceFullImportFromDialog) {
        __inPlaceImport = false;
        __legacyPromotion = false;
        plog("user override: forceFullImport=true → reverting to fresh saveACopy path (no edit-mode)");
    }
    // Late-bind ctx fields. ctx was initialized way above (line ~471) before
    // sourceDoc was available; assign the provenance-derived fields now so
    // v2_pipeline's edit-mode classify block sees correct values.
    //   editImportMode triggers the classify path (either real or synthetic sidecar)
    //   sidecarState = real label payload (in-place) OR null (legacy promotion synthesizes)
    //   legacyPromotion = synthesize-sidecar flag consumed inside v2_pipeline after locate
    ctx.editImportMode = __inPlaceImport || __legacyPromotion;
    ctx.sidecarState = (__sourceProv && __sourceProv.importState) || null;
    ctx.legacyPromotion = __legacyPromotion;

    try {
        var __srcName = String(sourceDoc.name);
        // Relax the .translated/.aborted/.BLOCKED guard when the source doc
        // carries a valid import-state label — that's the legitimate
        // re-import-into-translated-doc entry path. Without the label we
        // still refuse to prevent .translated.translated.indd cascades.
        if (/\.translated|\.aborted|\.BLOCKED/i.test(__srcName) && !__inPlaceImport) {
            var msg = "Import aborted: active document `" + __srcName + "` looks like a previous import output (`.translated` / `.aborted` / `.BLOCKED` suffix) and has no import-state label. Open the original `.indd` instead, or close this one first.";
            try { plog(msg); } catch (ePM) {}
            report.errors.push(msg);
            try { showAlert(msg); } catch (eShow) {}
            return;
        }
    } catch (eGuard) {
        report.errors.push("Source-doc guard failed: " + (eGuard && eGuard.message ? eGuard.message : eGuard));
    }

    // Stage ⓪.a: capture source path (sync property reads).
    // Modal-dialog suppression is deferred — we WANT INTERACT_WITH_ALL
    // during app.open so missing-link / font-fallback prompts surface
    // to the user once, in the state that will persist through save.

    try {
        report.document_name = String(sourceDoc.name);
        // UXP DOM source path resolution. Two properties:
        //   sourceDoc.fullName — the full FILE path (e.g. "...\foo.indd")
        //   sourceDoc.filePath — the PARENT FOLDER of the file
        // We need the full file path so save-target computation puts the
        // .translated.indd / .aborted.indd / .BLOCKED.indd next to the source file
        // (not in the grandparent directory). Prefer fullName; fall back to
        // filePath only if fullName fails.
        //
        // Both can be Promises in UXP (resolving to a File/Folder entry).
        // Synchronous String() yields "[object Promise]" — must await before
        // doScript (which can't await).
        try {
            var fnRaw = sourceDoc.fullName;
            if (fnRaw && typeof fnRaw.then === "function") fnRaw = await fnRaw;
            if (fnRaw && fnRaw.nativePath) sourcePathStr = String(fnRaw.nativePath);
            else if (fnRaw && fnRaw.fsName) sourcePathStr = String(fnRaw.fsName);
            else if (fnRaw) sourcePathStr = String(fnRaw);
        } catch (eFN) {}
        if (!sourcePathStr || sourcePathStr.indexOf("[object") === 0) {
            // Fallback: filePath (folder) + doc name → reconstruct full path.
            // Without joining, save target ends up one directory too high.
            try {
                var fpRaw = sourceDoc.filePath;
                if (fpRaw && typeof fpRaw.then === "function") fpRaw = await fpRaw;
                var folder = "";
                if (fpRaw && fpRaw.nativePath) folder = String(fpRaw.nativePath);
                else if (fpRaw) folder = String(fpRaw);
                if (folder && folder.indexOf("[object") < 0) {
                    var sep = folder.indexOf("\\") >= 0 ? "\\" : "/";
                    sourcePathStr = folder.replace(/[\\/]+$/, "") + sep + String(sourceDoc.name);
                }
            } catch (eFP) {}
        }
        if (!sourcePathStr || sourcePathStr.indexOf("[object") === 0) {
            sourcePathStr = report.document_name || "untitled.indd";
        }
        report.source_doc_path = sourcePathStr;
        plog("source: " + sourcePathStr);
    } catch (ePath) { plog("WARN: source path resolve: " + ePath.message); }

    var stem = _stripIndExt(sourcePathStr);
    var srcDir = FileUtils.getOutputDirectory(sourcePathStr) || parentDir;
    var srcSep = RuntimePaths.getSep(srcDir);
    saveTargetPath = srcDir + srcSep + _basename(stem) + ".translated.indd";
    report.save_target_path = saveTargetPath;
    plog("save target: " + saveTargetPath);

    // ── 8D-ext-D step-3b: M4/M5 mode pick + byPair font-mapping wiring ──
    // Position pinned by spec (DR3 split-entry, task_plan :2242/:2258-2266):
    // AFTER ctx construction (:553) + provenance late-bind, BEFORE workCopy
    // creation and the runPipeline/runMinimalApply branch — a block/cancel
    // here aborts with ZERO doc mutation. The importer owns the M4/M5 pick;
    // the panel owns M1/M2/M3.
    //
    // 1. _meta + mode default.
    // 1B (2026-06-16, project_meta_consolidated_spec §3.1 Tier-1): PREFER the
    // loose `_meta.json` sibling — the canonical delivery the webapp writes.
    // Fall back to the legacy embedded translations.json._meta (8D-ext-A0) for
    // older packages. Fixes a live drift: the webapp writes a separate
    // _meta.json (never embeds), so the embedded-only read was null on every
    // current package → workflow_mode block + source/target prefill silently dead.
    var __meta = null;
    try {
        var __metaPath = parentDir + RuntimePaths.getSep(parentDir) + "_meta.json";
        var __metaRaw = null;
        try { __metaRaw = common.readUtf8File(__metaPath); } catch (eRead) { __metaRaw = null; }
        if (__metaRaw) {
            var __PMimp = await require("./lib/project_meta_uxp.js").load();
            var __parsedMeta = __PMimp.parse(__metaRaw);
            if (__parsedMeta.ok) {
                __meta = __parsedMeta.data;
                plog("_meta: loose _meta.json (" + __metaRaw.length + "B)");
            } else {
                plog("WARN: _meta.json present but unparseable, ignoring");
            }
        }
    } catch (eMetaFile) {
        plog("WARN: _meta.json read: " + (eMetaFile && eMetaFile.message ? eMetaFile.message : eMetaFile));
    }
    if (!__meta) {
        try {
            var __rawPayload = translations && translations.raw;
            if (__rawPayload && typeof __rawPayload === "object"
                    && __rawPayload._meta && typeof __rawPayload._meta === "object"
                    && !Array.isArray(__rawPayload._meta)) {
                __meta = __rawPayload._meta;
                plog("_meta: embedded translations.json._meta (legacy fallback)");
            }
        } catch (eMeta) {}
    }
    // Effective skip flag: ctx.skipStyleCleanup (:553) ORed with the raw
    // payload field — the :553 read goes through the loadTranslations wrapper
    // ({rows, byTid, raw}) which does not carry payload top-level keys, while
    // the DR3 pseudocode keys the M5 default off translations.json's
    // skip_style_cleanup. The dropdown default must come FROM the same flag
    // it later overrides (spec consistency note), so both sources feed it.
    var __effSkipCleanup = !!(ctx.skipStyleCleanup
        || (translations && translations.raw && translations.raw.skip_style_cleanup === true)
        || (translations && translations.raw && translations.raw.skipStyleCleanup === true));
    var __modeDefault = ByPairWiring.resolveImporterModeDefault(__meta, __effSkipCleanup);
    if (__modeDefault.block) {
        var __bMsg = "Import aborted: " + __modeDefault.blockReason;
        plog(__bMsg);
        report.errors.push(__bMsg);
        showAlert(__bMsg);
        return;
    }
    if (__modeDefault.hint) plog("byPair wiring: " + __modeDefault.hint);

    // 2. brand_config discovery (spec :2253 priority):
    //    (1) <docStem>_brand_config.json next to the doc;
    //    (2) package-root brand_config.json — ZIP packages were fully
    //        extracted by __extractTranslationZip above, so a brand_config.json
    //        zip entry materializes on disk next to translations.json (the
    //        same path covers plain non-zip package folders);
    //    (3) user picker — skipped for now (TODO step-5) → fallback byPair=[].
    //    First EXISTING candidate decides; parse/validate failure on it →
    //    warn + byPair=[] (no fall-through past an existing file — a typo'd
    //    tier-1 config must not be silently masked by a stale tier-2 one).
    var __brandConfig = null;
    // FIX 2a: track discovery outcome so the persisted report distinguishes
    // "no config file at any tier" (not_found) from "found a file but it was
    // unparseable / invalid" (found_but_invalid) from "loaded ok" (found:<path>).
    // Both non-found cases currently collapse to byPair=[] (a valid no-op), so
    // without this the saved report cannot tell the operator WHY no font
    // mapping was applied.
    var __bcLoadedPath = "";
    var __bcFoundInvalid = false;
    // brand_config discovery — the interactive PICKERS moved UP FRONT to the
    // first-screen config selection (see __pickedBrandPath / __pickedPresetPath
    // set before the unified dialog above). Here we just resolve picked / auto
    // path into candidates, with auto-discovery (doc-stem / package-root) as the
    // fallback when nothing was picked at the first screen.
    var __effectiveBrandPath = __autoBrandPath || __pickedBrandPath;
    var __bcCandidates = __effectiveBrandPath
        ? [{ tier: 0, path: String(__effectiveBrandPath) }]
        : ByPairWiring.buildBrandConfigCandidatePaths(sourcePathStr, parentDir);

    // TODO#63 (b) — say what was LOOKED FOR, not only what was found.
    //
    // 🔴 Measured before writing this (35 historical logs): 20 loads, ALL tier 0;
    // tier 1 and tier 2 have never once been hit; 12 runs found nothing. And a run
    // that finds nothing logs exactly `brand_config status: not_found` — no list of
    // what it tried. So the operator cannot tell whether it even looked, or where.
    //
    // ⚠ Priority is NOT touched (owner: 「用另选的」). The loop below still takes
    // the first existing candidate, and with a tier-0 pick that is the only candidate
    // it ever builds. This block only NAMES the rungs — including the ones the loader
    // never constructs, which is the sole place they are ever mentioned.
    var __ladder = ByPairWiring.describeBrandConfigLadder(
        sourcePathStr, parentDir, __effectiveBrandPath ? String(__effectiveBrandPath) : "");
    for (var __li = 0; __li < __ladder.length; __li++) {
        var __lr = __ladder[__li];
        try { readUtf8File(__lr.path); __lr.exists = true; }
        catch (eLd) { __lr.exists = false; }
    }
    plog("brand_config: where it looked —");
    var __ladderLines = ByPairWiring.formatBrandConfigLadder(__ladder);
    for (var __lli = 0; __lli < __ladderLines.length; __lli++) plog(__ladderLines[__lli]);
    // The case arch specifically asked to stop being silent: a pick that hides a file
    // which is really there. owner confirmed 「use the one you picked」 — he did not
    // confirm 「and don't tell me what got hidden」.
    var __shadowedPresent = __ladder.filter(function (r) {
        return r.role === "shadowed" && r.exists === true;
    });
    if (__shadowedPresent.length) {
        plog("brand_config: " + "\u26a0 using the config you selected (" + String(__effectiveBrandPath)
            + "); these also exist and were NOT used: "
            + __shadowedPresent.map(function (r) { return "tier " + r.tier + " " + r.path; }).join(" | "));
    }
    for (var __bci = 0; __bci < __bcCandidates.length; __bci++) {
        var __cand = __bcCandidates[__bci];
        var __bcRaw = null;
        try { __bcRaw = readUtf8File(__cand.path); }
        catch (eBcR) { continue; }   // not present → next tier
        try {
            var __bcParsed = JSON.parse(__bcRaw);
            var __bcValid = FontMappingPairs.validateBrandConfig(__bcParsed);
            if (__bcValid.ok) {
                __brandConfig = __bcParsed;
                __bcLoadedPath = __cand.path;
                plog("brand_config: loaded (tier " + __cand.tier + ") " + __cand.path);
            } else {
                __bcFoundInvalid = true;
                plog("brand_config: INVALID (tier " + __cand.tier + ") " + __cand.path + ": "
                    + __bcValid.errors.slice(0, 5).join("; ") + " — byPair disabled ([])");
            }
        } catch (eBcP) {
            __bcFoundInvalid = true;
            plog("brand_config: parse failed (tier " + __cand.tier + ") " + __cand.path + ": "
                + (eBcP && eBcP.message ? eBcP.message : eBcP) + " — byPair disabled ([])");
        }
        break;
    }
    // TODO#63 (a) — question the chosen config, never block it.
    // arch: 「tier 0 也要过归属校验（不符出声，不硬拦）」.
    // 🔴 An empty doubt list means "nothing to say", NOT "verified correct" — the
    // only facts available here are the package `_meta` languages, and a brand config
    // legitimately need not enumerate every language a job touches. Silence when
    // there is nothing to compare (no `_meta`, or a config with no fonts_by_language):
    // "I could not check" is not evidence of "wrong".
    if (__brandConfig) {
        var __attrDoubts = [];
        try {
            __attrDoubts = ByPairWiring.checkBrandConfigAttribution(
                __brandConfig,
                {
                    targetLang: (__meta && typeof __meta.target_language === "string") ? __meta.target_language : "",
                    sourceLang: (__meta && typeof __meta.source_language === "string") ? __meta.source_language : ""
                },
                (function () {
                    try { return require("./lib/font_identity_groups.js").sameLang; }
                    catch (eSL) { return null; }
                })()
            );
        } catch (eAttr) { __attrDoubts = []; }
        if (__attrDoubts.length) {
            plog("brand_config: \u26a0 this config may not be for this job — "
                + __attrDoubts.join("; ") + " (using it anyway)");
        }
    }
    var __langScriptTable = ByPairWiring.resolveLangScriptTable(__brandConfig);
    // FIX 2a: derive + record the discovery status now (early), so even the
    // pre-sweep early-return paths below carry it; the sweep summary (FIX 1)
    // merges onto this SAME report.bypair_sweep object near the report write.
    var __bcStatus = ByPairWiring.brandConfigStatus(__bcLoadedPath, __bcFoundInvalid);
    report.bypair_sweep = { brand_config_status: __bcStatus };
    plog("brand_config status: " + __bcStatus);

    // 3. mode/langs/runEnforcer/per-pair skips — dialog (interactive) or
    //    automationOptions (bridge). Langs prefill from _meta when present.
    var __metaSrcLang = (__meta && typeof __meta.source_language === "string") ? __meta.source_language : "";
    var __metaTgtLang = (__meta && typeof __meta.target_language === "string") ? __meta.target_language : "";
    var __bpMode = __modeDefault.mode;
    // A1 (REV gate-2 rung 2): the headless byPairMode override. Declared at
    // function scope so the post-projection authoritative block can re-apply it
    // (`__bpMode = __aoMode ? __aoMode : __derivedMode`). null on interactive /
    // unified paths (only the automation branch below assigns it).
    var __aoMode = null;
    // Headless Hook-B (tofu gate) auto-resolution — OPT-IN via
    // automationOptions.tofuResolution (automation/test only; null on every
    // interactive run so production saves still gate). "accept"/"skip" → the
    // late tofu dialog is replaced by a programmatic accept-tofu (font_skip every
    // unowned run) so a bridge-driven import can run to completion + save instead
    // of staying blocked. See the Hook B block (Stage ④.6) below.
    var __hbAutoResolve = null;
    // ── #85 und-归一化：单一入口，且它在【赋值】边界而不是【读取】边界 ──────
    //
    // 导出侧在 operator 没填源语言时写 BCP-47 的 `und`（否则 schema 的
    // minLength:2 + pattern 会让整个 `_meta.json` 写不出来 —— 那正是 #85 那个
    // 自维持循环的根因）。对本文件的下游，`und` 必须等价于【未设置】：
    //   · `:1451` 的投影闸靠 `__bpSrcLang &&`，`und` 是 truthy ⇒ 闸会从跳过变成放行
    //   · `:2812/:2815/:2873/:2878` 的 `|| "en"` 兜底会被 `und` 顶掉
    // ⇒ 不归一化，就是拿「面板是空的」去换「字体配对路径的行为变了」。
    //
    // 🔴 为什么归一化在赋值侧（而不是让每个读点调 Effective()）：
    //   赋值只有 4 处、读有 15 处。放在赋值侧，那 15 处一个都不用改，
    //   **「将来有人新增一处读却忘了归一化」在结构上就不可能发生** ——
    //   而放在读侧，正确性要靠每一个未来的作者【记得】。今天一整天都在换掉
    //   「必须记得」这种东西（见 findings 的 `#27` 侧信道条目）。
    //   需要纪律的只剩这 4 处赋值，而它们由
    //   `tests/bypair_srclang_norm_tests.js` 盯着：新增一处裸赋值 ⇒ 套件红。
    //
    // ⚠ `und` 不被机器强制：schema 的 pattern 是纯结构的，`zz` / `qaa` 同样
    //   valid ⇒ 「未确定」是【约定】，不是校验器保证的语义。
    //
    // 🔴 `__bpSrcLangRaw` 只允许被【报告那一行】读（测试断言其读取点恰为 1）。
    //   它存在只是为了让 report 如实记录包里到底声明了什么；任何**功能**判断
    //   都必须用 `__bpSrcLang`。多一个读者 = 变成 findings 里那个侧信道形状。
    var __bpSrcLangRaw = "";
    function __setSrcLang(v) {
        __bpSrcLangRaw = (typeof v === "string") ? v : "";
        // ⛔ 不在这里重写「什么算占位」—— 问那个唯一的判定函数（同一条判定也
        //    驱动导出对话框的三态提示；两份拷贝正是 findings `#27` 的侧信道形状）。
        return ProjectMetaAssemble.isUndetermined(__bpSrcLangRaw) ? "" : __bpSrcLangRaw;
    }
    var __bpSrcLang = __setSrcLang(__metaSrcLang);
    var __bpTgtLang = __metaTgtLang;
    var __bpRunEnforcer = true;
    var __bpSkipDecisions = {};
    var __bpByPair = [];
    var __bpInteractive = (typeof document !== "undefined")
        && !AutomationBridge.isAutomatedRun("import_integrated");
    if (__integratedFontChoice) {
        // import_integrated: the UNIFIED settings dialog (shown up front in
        // place of the reorganize dialog) already gathered the font half —
        // reuse it instead of popping a second dialog. Langs come from the
        // unified dialog's dropdowns; if left blank they fall back to the
        // package _meta langs. Per-pair skips weren't shown there (brand_config
        // resolves after), so skipDecisions = {} (apply all projected pairs).
        // F1 (8D-ext-UNIFY-core piece 2): the dialog no longer feeds mode — the
        // M4/M5 dropdown is deleted; __bpMode comes from the DERIVATION, set
        // authoritatively in the post-projection block below. (Was
        // `__bpMode = __integratedFontChoice.mode;` — neutralized.)
        __bpSrcLang = __setSrcLang(__integratedFontChoice.sourceLanguage || __metaSrcLang);
        __bpTgtLang = __integratedFontChoice.targetLanguage || __metaTgtLang;
        __bpRunEnforcer = __integratedFontChoice.runEnforcer;
        __bpSkipDecisions = __integratedFontChoice.skipDecisions || {};
        plog("byPair wiring: using unified-dialog font choice — mode=" + __bpMode
            + " src=" + (__bpSrcLang || "(unset)") + " tgt=" + (__bpTgtLang || "(unset)")
            + " runEnforcer=" + __bpRunEnforcer);
        __meta = __mergeImportDialogMeta(__meta, __integratedFontChoice);
    } else if (__bpInteractive) {
        var __bpChoice = await __showByPairImportDialog({
            defaultMode: __modeDefault.mode,
            hint: __modeDefault.hint,
            srcLang: __metaSrcLang,
            tgtLang: __metaTgtLang,
            projectName: (__meta && __meta.project_name) || "",
            workflow: (__meta && __meta.workflow_mode) || "translation",
            deadline: (__meta && __meta.deadline) || "",
            designer: (__meta && __meta.contributors && __meta.contributors.designer) || "",
            brandConfig: __brandConfig
        });
        if (!__bpChoice) {
            plog("user cancelled at import-mode/byPair dialog");
            // 取消不弹窗（owner 2026-08-31「都去」）。⛔ 只去弹窗，上面那行 plog 必须留。
            // ⚠ 若将来要把提示加回来：这一支是 `if (!__bpChoice)` 的 falsy 检查，**分不开**
            // 「用户关掉」与「对话框回了空」⇒ 措辞⛔ 不许断言是谁的意图（同 :463 那条）。
            return;
        }
        // F1: dialog no longer feeds mode (dropdown deleted). Was
        // `__bpMode = __bpChoice.mode;` — neutralized; derivation is authoritative.
        __bpSrcLang = __setSrcLang(__bpChoice.sourceLanguage);
        __bpTgtLang = __bpChoice.targetLanguage;
        __bpRunEnforcer = __bpChoice.runEnforcer;
        __bpSkipDecisions = __bpChoice.skipDecisions || {};
        __meta = __mergeImportDialogMeta(__meta, __bpChoice);
    } else {
        // Bridge/automation path: NO dialog. Optional automationOptions
        // fields byPairMode / sourceLanguage / targetLanguage / runEnforcer /
        // brandConfigPath override the same _meta-derived defaults; missing →
        // defaults stand, byPair=[] if langs stay unresolved.
        var __ao = __autoOptsCached || {};
        // A1: seed the rung-2 override (declared at function scope above). The
        // post-projection block re-applies it AFTER re-derivation so the
        // dropdown-deletion never silently clobbers a headless caller's choice.
        __aoMode = ByPairWiring.normalizeModeOverride(__ao.byPairMode);
        if (__aoMode) __bpMode = __aoMode;
        // Headless tofu-gate auto-resolution (automation/test only). "accept" or
        // "skip" → Hook B accept-tofu (font_skip every unowned) so the import
        // completes + saves instead of staying blocked; anything else → null
        // (gate normally). Only honored on this non-interactive branch.
        if (typeof __ao.tofuResolution === "string") {
            var __tr = __ao.tofuResolution.trim().toLowerCase();
            if (__tr === "accept" || __tr === "skip" || __tr === "skip-all") __hbAutoResolve = "accept";
        }
        if (typeof __ao.sourceLanguage === "string" && __ao.sourceLanguage) __bpSrcLang = __setSrcLang(__ao.sourceLanguage);
        if (typeof __ao.targetLanguage === "string" && __ao.targetLanguage) __bpTgtLang = __ao.targetLanguage;
        if (typeof __ao.runEnforcer !== "undefined") __bpRunEnforcer = (__ao.runEnforcer !== false);
        // FIX 2b: headless callers can pass per-pair skip decisions in the SAME
        // { "pairingId|dstLang": "skip" } shape the dialog's checkboxes produce.
        // Absent / malformed → {} (prior behavior). Threaded into
        // ctx.preloadedFontMapping.skipDecisions via buildPreloadedFontMapping
        // below; the facade re-keys them to canonical langs at its choke point.
        __bpSkipDecisions = ByPairWiring.normalizeSkipDecisions(__ao.skipDecisions);
        plog("byPair wiring (automation): mode=" + __bpMode
            + " src=" + (__bpSrcLang || "(unset)") + " tgt=" + (__bpTgtLang || "(unset)")
            + " runEnforcer=" + __bpRunEnforcer
            + " skipDecisions=" + Object.keys(__bpSkipDecisions).length);
    }

    // 4. Directional projection — byPair stays [] until BOTH langs resolved.
    //    projectByPairWithIndex canonicalizes both match sides internally
    //    (step-3a) and the facade re-canonicalizes at its choke point — do
    //    NOT add another normalize here.
    // ── import_integrated: no-config → inline font-mapping UI ──
    // If no brand_config was picked/discovered but the user set BOTH langs,
    // offer the lean inline font-mapping dialog → its pairs become the
    // brand_config the projection consumes (turns a "no font mapping" import
    // into a mapped one without leaving the flow). Headless runs skip this.
    // 8D-ext-bypair-tofu-ux Phase 2: track whether the no-config branch already
    // opened the font panel — so Hook A (config-selected, below) does NOT re-open it
    // (the no-config panel already showed the red outlines + Done popup this run).
    var __earlyPanelShown = false;
    if (!__brandConfig && __bpInteractive && sourceDoc) {
        // ── no-config → full font_apply_panel React UI (config-only re-host) ──
        // Primary: the rich React panel (lib/font_mapping_panel_ui.js, a
        // config-only re-host — produces a brand_config, does NOT apply; the
        // import's own byPair sweep applies below). Fallback (panel lib fails
        // to load): the lean inline HTML dialog __showFontMappingUI.
        var __fpRes = null;
        try {
            var FontPanelUI = require("./lib/font_mapping_panel_ui.js");
            __earlyPanelShown = true;
            __fpRes = await FontPanelUI.showFontMappingPanelForConfig(RuntimePaths.getBaseDir(),
                { italicDemand: __italicDemand });
        } catch (eFp) { plog("font UI (React) load/run failed: " + (eFp && eFp.message ? eFp.message : eFp)); }
        if (__fpRes && __fpRes.ok && __fpRes.config && ByPairWiring.configHasMeaning(__fpRes.config)) {
            // re-audit残留-2 fix: accept the panel's config when it has PAIRS *or*
            // a font_skip set (or other meaningful content) — NOT pairs-only. A
            // user who triages EVERY unowned-CJK font via Skip produces a config
            // with `pairs: []` + `font_skip: [...]`; the old pairs.length-only
            // gate dropped it → __brandConfig stayed null → the facade re-derived
            // those CJK fonts as .unowned → M4/M5 BLOCKED the very save the user
            // skipped to unblock. With the config kept, its font_skip rides
            // ctx.preloadedFontMapping.brandConfig → buildFontSkipSet → resolver
            // routes them to .skipped (non-blocking). byPair stays [] (no swaps),
            // which is correct for a skip-only config.
            __brandConfig = __fpRes.config;
            __langScriptTable = ByPairWiring.resolveLangScriptTable(__brandConfig);
            report.bypair_sweep.brand_config_status = "inline_font_ui_react";
            plog("font UI (React): user created brand_config ("
                + (__fpRes.config.pairs || []).length + " pairs, "
                + ((Array.isArray(__fpRes.config.font_skip) && __fpRes.config.font_skip.length) || 0) + " skips)");
        } else if (__fpRes && __fpRes.ok && __fpRes.validateErrors && __fpRes.validateErrors.length) {
            // 8D-ext-MM step 5 (on-reject surface 1): the panel returned a config
            // that FAILED validateBrandConfig (distinct from cancel/empty). Do NOT
            // silently fall through to "cancelled" — surface it: the import still
            // proceeds (no abort) but with NO font mapping, and that is now loud.
            report.bypair_sweep.brand_config_status = "invalid_rejected";
            plog("font UI (React): NOTICE — brand_config INVALID, REJECTED (no font "
                + "mapping applied): " + __fpRes.validateErrors.slice(0, 5).join("; "));
        } else if (!__fpRes || !__fpRes.ok) {
            // React panel unavailable → lean inline HTML fallback (needs langs)
            plog("font UI: React panel unavailable (" + ((__fpRes && __fpRes.error) || "load failed") + ") → lean fallback");
            if (__bpSrcLang && __bpTgtLang) {
                var __leanCfg = await __showFontMappingUI({ srcLang: __bpSrcLang, tgtLang: __bpTgtLang, sourceDoc: sourceDoc });
                if (__leanCfg && Array.isArray(__leanCfg.pairs) && __leanCfg.pairs.length) {
                    // 8D-ext-MM step 5 (on-reject surface 1, lean): validate the
                    // lean config too — a validate-fail must not silently become a
                    // no-mapping import. (The lean dialog builds simple pairs but a
                    // future MM/eg overlap could still trip II-d.)
                    var __leanValid = FontMappingPairs.validateBrandConfig(__leanCfg);
                    if (__leanValid.ok) {
                        __brandConfig = __leanCfg;
                        __langScriptTable = ByPairWiring.resolveLangScriptTable(__brandConfig);
                        report.bypair_sweep.brand_config_status = "inline_font_ui_lean";
                        plog("font UI (lean): user created brand_config (" + __leanCfg.pairs.length + " pairs)");
                    } else {
                        report.bypair_sweep.brand_config_status = "invalid_rejected";
                        plog("font UI (lean): NOTICE — brand_config INVALID, REJECTED (no font "
                            + "mapping applied): " + __leanValid.errors.slice(0, 5).join("; "));
                    }
                }
            }
        } else {
            plog("font UI (React): skipped / no pairs (cancelled or empty)");
        }
    }
    if (__brandConfig && Array.isArray(__brandConfig.pairs) && __bpSrcLang && __bpTgtLang) {
        __bpByPair = FontMappingPairs.projectByPairWithIndex(__brandConfig.pairs, __bpSrcLang, __bpTgtLang, __brandConfig);
    }

    // ── 4.6 Hook A: early tofu WARNING (source-present unowned, pre-pipeline) ──
    // 8D-ext-bypair-tofu-ux §3 + Phase 2 (§12.4). BONUS for the source-present case:
    // scan the source doc, predict which SOURCE fonts will become unowned-CJK tofu
    // using the SAME resolveByPairActions the end sweep uses (judgment 同源 — no
    // drift); if any, OPEN the font panel SEEDED with the selected config (pre-wired
    // pairings + every doc font as a node) so the operator can wire/accept them — the
    // panel shows the red outlines + the Done-time confirm popup (Phase 2 replaces the
    // old standalone __showTofuResolutionDialog here; that dialog now serves Hook B
    // only). The PIPELINE-INTRODUCED case (e.g. M4 fallback to Minion Pro Bold — the
    // test_doc_1 repro) is NOT visible here and is caught by Hook B at the end. Gate:
    // config+pairs present, CJK target,
    // interactive, and source IS the active doc (scanActiveDoc is hardwired to
    // app.activeDocument; sourceDoc may differ via the BRIDGE-6 fallback). targetIsCJK
    // is computed INLINE from the module-level CJK set (NOT __routing — built later L1387).
    var __earlyTgtCJK = !!(__bpTgtLang && ByPairWiring.CJK_LANG_SET[LangScriptTableLib.normalizeBcp47Identity(__bpTgtLang)]);
    if (__brandConfig && Array.isArray(__brandConfig.pairs) && __brandConfig.pairs.length
            && __earlyTgtCJK && __bpInteractive) {
        var __earlyActiveId = null, __srcId = null;
        try { __earlyActiveId = app.activeDocument ? app.activeDocument.id : null; } catch (eAI) {}
        try { __srcId = sourceDoc ? sourceDoc.id : null; } catch (eSI) {}
        if (__srcId === null || __earlyActiveId === null || __srcId !== __earlyActiveId) {
            plog("Hook A (early tofu warn): SKIPPED — source not active (scanActiveDoc binds activeDocument); Hook B backstops");
        } else {
            var __earlyScan = null;
            try { __earlyScan = DocScan.scanActiveDoc({ config: __brandConfig }); }
            catch (eES) { plog("Hook A: scanActiveDoc threw (" + (eES && eES.message || eES) + ") — skip, Hook B backstops"); }
            if (__earlyScan && __earlyScan.ok) {
                try {
                    var __canonTgt = LangScriptTableLib.normalizeBcp47Identity(__bpTgtLang);
                    var __synScan = ByPairWiring.buildSyntheticTofuScan(__earlyScan, __canonTgt, ByPairWiring.CJK_LANG_SET, LangScriptTableLib.normalizeBcp47Identity);
                    var __earlyCanon = ByPairSweep._canonicalizeSweepInputs(__bpByPair, __bpSkipDecisions);
                    var __earlyFontSkip = ByPairWiring.buildFontSkipSet(null, __brandConfig);
                    var __earlyRes = FMR.resolveByPairActions(__synScan, __earlyCanon.byPair, __earlyCanon.skipDecisions, __brandConfig, __langScriptTable, __earlyFontSkip);
                    var __earlyUnowned = __tofuDedupeUnowned((__earlyRes.diagnostics && __earlyRes.diagnostics.unmappedCjk && __earlyRes.diagnostics.unmappedCjk.unowned) || []);
                    // Phase 2 (§12.4): source-present unpaired fonts exist → OPEN the font
                    // panel SEEDED with the selected config (pre-wired pairings + every doc
                    // font as a node so the unpaired ones red-outline). The panel itself shows
                    // the red outlines + Done popup; it returns the (possibly user-edited)
                    // config. Skip if the no-config branch already ran the panel this run.
                    if (__earlyUnowned.length && !__earlyPanelShown) {
                        plog("Hook A: " + __earlyUnowned.length + " source-present unpaired font(s) — opening seeded font panel");
                        var __fprA = await require("./lib/font_mapping_panel_ui.js")
                            .showFontMappingPanelForConfig(RuntimePaths.getBaseDir(),
                                { seedConfig: __brandConfig, targetLang: __bpTgtLang,
                                  italicDemand: __italicDemand });
                        if (__fprA && __fprA.cancelled) {
                            plog("Hook A: user cancelled at font panel — abort import (no doc write)");
                            // 取消不弹窗（owner 2026-08-31「都去」）。⛔ 只去弹窗，上面那行 plog 必须留。
                            // 🟢 这一支与另两处不同：它查的是显式的 `__fprA.cancelled`，**确实是真取消**
                            // （面板把 failure 走下一支 `ok === false`，只 plog 不弹窗）。
                            return;   // zero doc mutation — workCopy not yet created
                        }
                        if (__fprA && __fprA.ok === false) {
                            plog("Hook A: font panel unavailable (" + (__fprA.error || "?") + ") — keep disk config, Hook B backstops");
                        } else if (__fprA && __fprA.validateErrors && __fprA.validateErrors.length) {
                            plog("Hook A: panel config invalid — keep disk config, Hook B backstops: " + __fprA.validateErrors.slice(0, 3).join("; "));
                        } else if (__fprA && __fprA.config) {
                            __brandConfig = __fprA.config;
                            __langScriptTable = ByPairWiring.resolveLangScriptTable(__brandConfig);
                            __bpByPair = FontMappingPairs.projectByPairWithIndex(__brandConfig.pairs, __bpSrcLang, __bpTgtLang, __brandConfig);
                            plog("Hook A: panel returned updated config — re-projected byPair=" + __bpByPair.length);
                        }
                    } else if (__earlyUnowned.length) {
                        plog("Hook A: " + __earlyUnowned.length + " source-present unpaired font(s), but no-config panel already shown this run — Hook B backstops");
                    } else {
                        plog("Hook A: no source-present unpaired font (0) — proceeding");
                    }
                } catch (eHookA) {
                    plog("Hook A: error (" + (eHookA && eHookA.message || eHookA) + ") — skip, Hook B backstops");
                }
            }
        }
    }

    // byPair-preview cosmetic (8D-ext-MM): __bpByPair is FANNED OUT (N rows per
    // MM pairing). The honest "pairing-direction count" is the distinct
    // (pairingId, dstLang) group count; __bpByPair.length is the raw ENTRY count.
    var __bpPairingCount = FontMappingPairs.groupByPairKey(__bpByPair).length;
    plog("byPair wiring: mode=" + __bpMode + " projected_pairs=" + __bpPairingCount
        + " projected_entries=" + __bpByPair.length
        + " brandConfig=" + (__brandConfig ? "yes" : "no")
        + " langScriptTable=" + (__langScriptTable === LangScriptTableLib.LANG_SCRIPT_TABLE ? "vendored" : "brand_config"));
    // FIX 2a: no brand_config + BOTH langs resolved → a font mapping WAS
    // expected but byPair is []. That stays a valid no-op (no abort), but it
    // must not be silent: surface it in the log + report. (Interactive runs
    // also see the in-dialog "No brand_config found — font mapping disabled"
    // hint via __showByPairImportDialog/renderPairs; this covers the headless
    // path + leaves a durable trace either way.)
    if (!__brandConfig && __bpSrcLang && __bpTgtLang && __bpByPair.length === 0) {
        plog("byPair wiring: NOTICE — No brand_config found (" + __bcStatus + "); no font mapping "
            + "applied for this import (src=" + __bpSrcLang + " tgt=" + __bpTgtLang + ").");
    }

    // 4.5 AUTHORITATIVE mode + brand-CJK injection (8D-ext-UNIFY-core, REV
    //     gate-2 B2). Placement: AFTER projection (above), BEFORE the "5. ctx
    //     wiring" step — because buildCtxFields sets ctx.skipStyleCleanup (the
    //     real M4/M5 pipeline switch, :553/:560) FROM __bpMode. So __bpMode must
    //     be authoritative here, not from the deleted dropdown.
    //
    // Piece 1: inject ctx.fontPolicy so M4 rebuild lands the BRAND CJK family
    // (not force-SHS). buildCjkPreference is pure (F3 uniqueness + F5
    // canonicalize); the install check uses _brandFontAvailable (F2/gate-3:
    // correct stringify-enum probe, NOT the UXP-enum-broken findFontByName).
    var __cjkPref = CjkPreference.buildCjkPreference(__brandConfig, __bpTgtLang, __bpByPair);
    var __brandCjkOk = !!(__cjkPref && _brandFontAvailable(__cjkPref[0]));
    if (__brandCjkOk) {
        ctx.fontPolicy = { cjk: { preference: __cjkPref } };   // else stays null (:532) → SHS, byte-identical to today
        plog("brand-CJK injection: ctx.fontPolicy.cjk.preference = [" + __cjkPref.join(", ") + "]");
    }
    // F4 routing inputs (REV gate-2 rung 4). normalizeBcp47Identity + CJK_LANG_SET
    // are the SAME canonicalize + set the apply path uses.
    var __normLang = LangScriptTableLib.normalizeBcp47Identity;
    var __cjkSet = ByPairWiring.CJK_LANG_SET;
    var __routing = {
        targetIsCJK: !!(__bpTgtLang && __cjkSet[__normLang(__bpTgtLang)]),
        srcIsCJK:    !!(__bpSrcLang && __cjkSet[__normLang(__bpSrcLang)]),
        brandCjkResolvable: __brandCjkOk
    };
    var __derivedMode = ByPairWiring.resolveImporterModeDefault(__meta, __effSkipCleanup, __routing).mode;
    // A1 (rung 2): the headless byPairMode override wins over the re-derivation;
    // on interactive/unified paths __aoMode is null → __bpMode takes the F1 derivation.
    __bpMode = __aoMode ? __aoMode : __derivedMode;
    plog("byPair wiring: authoritative mode=" + __bpMode
        + " (derived=" + __derivedMode + (__aoMode ? ", override=" + __aoMode : "") + ")"
        + " targetIsCJK=" + __routing.targetIsCJK + " srcIsCJK=" + __routing.srcIsCJK
        + " brandCjkResolvable=" + __brandCjkOk);
    // F2-preflight (PROMOTED to REQUIRED): a CJK target whose brand CJK family is
    // NOT installed (or non-unique) degrades to M5 (preserve char-level) — make
    // it VISIBLE, not silent. No copy mechanism (that's UNIFY-fonts-ux).
    if (__routing.targetIsCJK && !__brandCjkOk) {
        var __cjkWarn = "brand CJK font not installed / non-unique for target "
            + __bpTgtLang + " → preserving via M5 (char-level swaps). "
            + "Install the brand CJK family + restart InDesign to rebuild to brand CJK.";
        plog("byPair wiring: WARNING — " + __cjkWarn);
        report.bypair_sweep.brand_cjk_warning = __cjkWarn;
    }

    // 5. ctx wiring (spec :2247/:2264). The dropdown OVERRIDES the :553
    //    ctx.skipStyleCleanup (its default came FROM that value, so
    //    no-override keeps it); a manual flip is logged because the
    //    reorganize-panel stage above already ran against the old value.
    if (ctx.skipStyleCleanup !== (__bpMode === "M5")) {
        plog("byPair wiring: mode override flips skipStyleCleanup "
            + !!ctx.skipStyleCleanup + " → " + (__bpMode === "M5"));
    }
    var __ctxFields = ByPairWiring.buildCtxFields(
        __bpMode,
        ByPairWiring.buildPreloadedFontMapping(__bpByPair, __bpSkipDecisions, __brandConfig, __langScriptTable),
        __bpRunEnforcer
    );
    ctx.skipStyleCleanup = __ctxFields.skipStyleCleanup;
    ctx.preloadedFontMapping = __ctxFields.preloadedFontMapping;
    ctx.runEnforcer = __ctxFields.runEnforcer;   // TOP-LEVEL ctx field, not nested (r19 iter3)
    report.bypair_wiring = {
        mode: __bpMode,
        source_language: __bpSrcLangRaw || null,   // 🔴 唯一允许读 Raw 的地方（测试钉死）
        target_language: __bpTgtLang || null,
        projected_pairs: __bpPairingCount,    // distinct (pairingId, dstLang) groups (8D-ext-MM cosmetic)
        projected_entries: __bpByPair.length, // raw fan-out rows (N per MM pairing)
        skip_decisions: __bpSkipDecisions,
        run_enforcer: ctx.runEnforcer,
        brand_config_found: !!__brandConfig,
        lang_script_table_source: (__langScriptTable === LangScriptTableLib.LANG_SCRIPT_TABLE) ? "vendored" : "brand_config",
        meta_present: !!__meta,
        mode_default_hint: __modeDefault.hint || null
    };

    // 6. detectM4CJKHazard — M4 only; consumes the PROJECTED byPair via ctx
    //    (r25 P3 ordering: after step 5, before runPipeline), modal BEFORE
    //    any doc mutation (workCopy creation is below). Cluster psFont is
    //    force-SHS under M4 → CJK byPair entries silently no-op; no silent
    //    succeed allowed (r18 P1).
    //
    // CHANGE-SITE C (8D-ext-UNIFY-core F2): the hazard is OBSOLETE when brand-CJK
    // injection is VERIFIED-ACTIVE (__brandCjkOk) — the CJK clusters now rebuild
    // to the brand CJK family, so byPair CJK entries become correct no-ops. Gate
    // off ONLY on verified-installed (NOT injection-present alone, r1's bug). If
    // __brandCjkOk is false, F4 has already routed mode→M5 (so this M4 branch
    // isn't entered) — UNLESS a headless caller forced M4 via byPairMode, in
    // which case the hazard stays the safety net (correct: explicit M4 honored).
    if (__bpMode === "M4" && !__brandCjkOk) {
        var __hazards = ByPairWiring.detectM4CJKHazard(
            ctx.preloadedFontMapping.byPair, ctx.preloadedFontMapping.langScriptTable);
        if (__hazards.length > 0) {
            plog("M4 CJK hazard: " + __hazards.length + " byPair entries will NOT apply (cluster force-SHS)");
            var __hazardAccepted = false;
            if (__bpInteractive) {
                __hazardAccepted = await __showM4CJKHazardDialog(__hazards);
            } else {
                // Headless: no operator to accept — require an explicit
                // automation opt-in, otherwise abort (cleanly, pre-mutation).
                __hazardAccepted = !!(__autoOptsCached && __autoOptsCached.acceptM4CJKHazard === true);
                plog("M4 CJK hazard (automation): acceptM4CJKHazard=" + __hazardAccepted);
            }
            if (!__hazardAccepted) {
                var __hzMsg = "Import aborted: M4 rebuilds CJK cluster fonts (force-SHS); "
                    + __hazards.length + " CJK byPair entr" + (__hazards.length === 1 ? "y" : "ies")
                    + " would NOT apply. Use M5 for char-level CJK swaps, or re-run and accept the warning.";
                plog(__hzMsg);
                report.errors.push(__hzMsg);
                showAlert(__hzMsg);
                return;
            }
            ctx.M4CJKWarningAccepted = true;
        }
    }

    // TODO#42 (2026-08-13): non-modal "processing" indicator — moved here from
    // the pre-config spot (see the note at the `var __processing` declaration).
    // Every OPERATOR-interactive stage (zip pick, reorganize panel, byPair
    // import-mode dialog, font-mapping panels, M4-CJK hazard dialog) is now
    // BEHIND us on both forks (in-place and saveACopy); everything from here on
    // is machine work, which is exactly what this indicator claims.
    // dialog.show() (non-modal) does not block InDesign DOM ops (probe
    // 20260528_03). InDesign's own missing-fonts modal during app.open
    // (INTERACT_WITH_ALL) is a HOST modal that stacks above this — unchanged
    // behavior. Entry-point note: with automationOptions present
    // (isAutomatedRun), no dialog at all; a BARE bridge run does show it, and
    // the bridge's plugin document persists across requests — so close() (and
    // the fatal-path safety close via __topLevelProcessing) must always run,
    // there is no script-death teardown to catch a leak like double-click has.
    if (typeof document !== "undefined" && !AutomationBridge.isAutomatedRun("import_integrated")) {
        try {
            __processing = ProcessingDialog.show("Starting import pipeline");
            if (__processing) __processing.update("Starting import pipeline", 5);
            try { __topLevelProcessing = __processing; } catch (eExp) {}
        } catch (eP) { plog("processing dialog show threw: " + (eP && eP.message || eP)); }
    }

    // ── IN-PLACE EDIT-MODE BRANCH ──────────────────────────────────
    // When the source doc carries a valid import-state label, skip the
    // saveACopy step entirely. workDoc IS the source doc — operator's
    // hand-tweaked .translated.indd state stays intact across imports.
    // The provenance branch above already cleared the .translated guard
    // for this path.
    if (__inPlaceImport) {
        plog("in-place mode: workDoc = sourceDoc (skipping saveACopy + open)");
        workDoc = sourceDoc;
        // Redirect saveTargetPath to the source's own path so the end-of-run
        // workDoc.save(saveTargetPath, false) writes back in place rather
        // than spawning a "<stem>.translated.indd" sibling.
        saveTargetPath = sourcePathStr;
        // The earlier "save target: …" line was logged BEFORE this redirect, so
        // it still names the fresh-import "<stem>.translated.translated.indd"
        // that in-place mode never writes. Re-log the real one — a stale target
        // in the log sent an investigation looking for a file that never existed
        // (2026-08-28).
        plog("save target (in-place, supersedes the line above): " + saveTargetPath);
        report.in_place_import = true;
        report.save_target_path = sourcePathStr;
        try {
            app.scriptPreferences.userInteractionLevel = UserInteractionLevels.NEVER_INTERACT;
        } catch (eUI1ip) { plog("WARN: NEVER_INTERACT post-open (in-place): " + eUI1ip.message); }
    } else {

    // Stage ⓪.b: saveACopy → target path directly + open visible.
    //
    // INTERACT_WITH_ALL during app.open: any missing fonts / links surface
    // their substitution dialog to the user ONCE here, in the state that
    // will persist through pipeline + save. After open, switch to
    // NEVER_INTERACT for pipeline body so commit/apply doesn't get
    // interrupted by per-frame prompts.
    //
    // #BRIDGE-2: in headless / MCP runs there's no operator to dismiss
    // the missing-font dialog. Worse, on some docs (observed on
    // DOC-0000 which references unmapped CJK fonts) the dialog
    // leaves the doc in a "transaction pending" state — every subsequent
    // workDoc.save() then fails with "Cannot save document because there
    // are open transactions in process on the database." Stay in
    // NEVER_INTERACT through app.open in that case: InDesign applies
    // its default substitution silently and the doc commits cleanly.
    var __isAutomated = AutomationBridge.isAutomatedRun("import_integrated");

    // ── host 环境自检（2026-08-07）──────────────────────────────────────────
    // 卡死的 Adobe Fonts 激活会把整条后台任务队列堵住（实测堆到 550 条、16 分钟
    // 零变化），而**脚本无法取消后台任务**（DOM 无 cancel 接口）→ 跑完也救不回来，
    // 只能重启 InDesign。所以在开文档之前就报，别一头扎进去。
    // 判据是「Adding Font 卡在 RUNNING」，**不是任务总数** —— 正常开一个文档就有
    // 22 条、几十秒排空。详 findings.md#adobe-fonts-auto-activation-jams-the-task-queue
    try {
        var __jam = HostEnvGuard.findStuckFontActivations(app);
        if (__jam.jammed) {
            var __jamMsg = HostEnvGuard.formatJamReport(__jam);
            plog("HOST ENV WARN: " + __jamMsg.replace(/\n/g, " | "));
            report.warnings = report.warnings || [];
            report.warnings.push("host_env_jam: " + __jam.stuck.length + " stuck '"
                + HostEnvGuard.FONT_TASK_NAME + "' task(s); restart InDesign recommended");
            if (!__isAutomated) { try { showAlert(__jamMsg); } catch (eJA) {} }
        }
    } catch (eJam) { plog("WARN: host env self-check failed (non-fatal): " + (eJam && eJam.message)); }

    try {
        app.scriptPreferences.userInteractionLevel = __isAutomated
            ? UserInteractionLevels.NEVER_INTERACT
            : UserInteractionLevels.INTERACT_WITH_ALL;
    }
    catch (eUI0) { plog("WARN: failed to set interaction level pre-open: " + eUI0.message); }

    // #BRIDGE-4: if the prior run's .translated.indd is still open in
    // the app (common in headless re-runs where bridge can't always
    // force-close stale work copies via the docs collection), close it
    // first so saveACopy doesn't fail with "the file is already open".
    // Match by save_target name suffix — robust to path normalization
    // differences (UXP fullName / nativePath / Promise quirks).
    try {
        var __stalePrior = null;
        var __wantSuffix = "/" + _basename(saveTargetPath);
        var __wantSuffixWin = "\\" + _basename(saveTargetPath);
        for (var __pdi = app.documents.length - 1; __pdi >= 0; __pdi--) {
            var __pd = app.documents.item(__pdi);
            try {
                if (String(__pd.name) === _basename(saveTargetPath)) { __stalePrior = __pd; break; }
            } catch (eND) {}
        }
        if (__stalePrior) {
            plog("bridge: closing stale prior workCopy " + __stalePrior.name + " before saveACopy");
            try {
                app.scriptPreferences.userInteractionLevel = UserInteractionLevels.NEVER_INTERACT;
            } catch (ePB) {}
            var __targetName = _basename(saveTargetPath);
            // Try close; verify it ACTUALLY closed by re-scanning the docs
            // collection. UXP close() can return without error but leave the
            // doc open when the doc has lingering font-substitution state.
            // In that case, fall back to ENTIRE_SCRIPT undo + revert which
            // forces InDesign to drop pending edits and release the doc.
            var __closeRetries = 0;
            while (__closeRetries < 4) {
                // Drop UI bindings first: closing the doc's windows
                // releases the Pages / Layers / Stories panel refs that
                // otherwise keep doc.close() silently no-op'ing (the
                // root cause behind the earlier DOC-0000 "resource busy
                // or locked" repro on rerun).
                try {
                    var __wins = __stalePrior.windows;
                    for (var __wi = __wins.length - 1; __wi >= 0; __wi--) {
                        try { await __wins.item(__wi).close(); } catch (eWC) {}
                    }
                } catch (eWS) {}
                try { await __stalePrior.close(require("indesign").SaveOptions.NO); }
                catch (eCl) { plog("bridge: stale workCopy close attempt " + (__closeRetries+1) + " threw: " + (eCl && eCl.message ? eCl.message : eCl)); }
                // Verify
                var __stillOpen = false;
                for (var __vk = 0; __vk < app.documents.length; __vk++) {
                    try { if (String(app.documents.item(__vk).name) === __targetName) { __stillOpen = true; break; } } catch (eVK) {}
                }
                if (!__stillOpen) { plog("bridge: stale workCopy closed (attempt " + (__closeRetries+1) + ")"); break; }
                __closeRetries++;
                if (__closeRetries < 4) {
                    // Try revert-then-close: revert discards all pending
                    // edits including stuck font-substitution transactions.
                    try { await __stalePrior.revert(); plog("bridge: reverted stale workCopy (attempt " + __closeRetries + ")"); }
                    catch (eRev) { plog("bridge: revert failed: " + (eRev && eRev.message ? eRev.message : eRev)); }
                    // Re-acquire the reference (revert can invalidate it).
                    __stalePrior = null;
                    for (var __va = 0; __va < app.documents.length; __va++) {
                        try { if (String(app.documents.item(__va).name) === __targetName) { __stalePrior = app.documents.item(__va); break; } } catch (eVA) {}
                    }
                    if (!__stalePrior) { plog("bridge: stale workCopy gone after revert"); break; }
                }
            }
            if (__closeRetries >= 4) {
                plog("bridge: stale workCopy refused to close after 4 attempts — falling back to timestamped workCopy filename");
                // #BRIDGE-4b: rename strategy. Append a timestamp to
                // saveTargetPath so fs.writeFileSync can land on a
                // fresh file even when the canonical one is locked.
                // The deliverable name diverges from <stem>.translated.indd
                // but at least the run completes; operator can manually
                // delete stale canonical name later.
                var __ts = String(Date.now());
                saveTargetPath = saveTargetPath.replace(/\.translated\.indd$/i, ".translated_" + __ts + ".indd");
                report.save_target_path = saveTargetPath;
                plog("bridge: workCopy path retargeted to " + saveTargetPath);
            }
        }
    } catch (eStaleScan) {
        plog("bridge: stale workCopy scan threw: " + (eStaleScan && eStaleScan.message ? eStaleScan.message : eStaleScan));
    }

    // #BRIDGE-5: disk-level workCopy creation. Replaces the prior
    // `sourceDoc.saveACopy(saveTargetPath)` call, which routed through
    // InDesign's transaction-aware save path — that path fails with
    // "Cannot save document because there are open transactions in
    // process on the database." whenever the user-opened source has a
    // pending font-substitution transaction (the missing-fonts dialog
    // route). Worse, we'd previously try to clear it with a close+
    // reopen of the source doc; InDesign refused to release its
    // outstanding references and emitted a Protective Shutdown
    // ("CloseDocCmd - document is still referenced. Document has 3
    // extra references"), killing the whole app.
    //
    // The disk-level copy bypasses InDesign entirely: `fs.copyFile`
    // duplicates the .indd bytes on disk, then `app.open` reads that
    // copy as a fresh document with no transaction baggage. Same path,
    // same final deliverable, but never touches the user's open source.
    //
    // The copy lives at saveTargetPath (next to the source .indd) so
    // InDesign's relative path resolution finds the same `Document
    // fonts/` folder and `Links/` images the source uses — moving the
    // copy elsewhere would re-trigger the missing-font dialog because
    // those relative references would break.
    // #BRIDGE-32b guard REMOVED (2026-06-24, guard-ux line) ───────────────
    // The old guard here (BRIDGE-9 / BRIDGE-32b) aborted (headless) or popped
    // a "source has unsaved changes — save first?" dialog (interactive)
    // whenever sourceDoc.modified === true and the source had an on-disk
    // .indd. Original intent: stop the disk-level workCopy (which reads
    // sourcePathStr bytes off disk) from silently dropping in-memory operator
    // edits that hadn't been saved yet.
    //
    // Why it's gone (user decision): this workflow NEVER modifies the
    // operator's original project file. The modified===true we see here is
    // InDesign auto-marking the doc dirty on open (font / link resolution),
    // not a real operator edit — so the guard was a pure false-positive and
    // pure friction (its cancel branch only plog+return'd, so it looked like a
    // crash). Importing the disk version IS the workflow intent, so proceed
    // unconditionally and just leave one visible trace for forensics.
    // See IT findings.md (#bridge-32b-guard-removed).
    try {
        var __srcModified = false;
        try { __srcModified = !!sourceDoc.modified; } catch (eMod) {}
        if (__srcModified) {
            plog("source had unsaved changes (likely InDesign auto-mark on open); proceeding with disk version per workflow policy — BRIDGE-32b guard removed");
        }
    } catch (eGuardModified) {
        plog("modified-check threw: " + (eGuardModified && eGuardModified.message ? eGuardModified.message : eGuardModified));
    }

    try {
        report.pipeline_stage = "save_copy";

        // #BRIDGE-32: detect when the source is not a real .indd on disk
        // — typical case: operator opened an .idml directly in InDesign,
        // so sourceDoc.fullName throws "Unsaved documents have no full
        // name." and sourcePathStr falls through to report.document_name
        // (just the bare stem, no path). The disk-level workCopy below
        // would then `fs.readFileSync(bare-stem)` and ENOENT out.
        //
        // Fall back to sourceDoc.saveACopy(saveTargetPath) which uses
        // InDesign's own save engine to materialize the in-memory doc to
        // .indd. This works for IDML-opened, unsaved-new, and unsaved-
        // edited sources. The transaction-pending failure mode that
        // BRIDGE-5 originally moved AWAY from saveACopy for is still a
        // concern, but only fires on docs with pending font-substitution
        // transactions — IDML-opened docs typically don't have those
        // (InDesign resolves font substitution at IDML import time).
        //
        // Detection: try readFileSync's existsSync-equivalent (statSync)
        // first; on ENOENT, switch to saveACopy. Avoids changing the hot
        // path for the 99% normal-INDD case.
        var __fs = require("fs");
        var __sourceFileExists = false;
        try {
            var __stat = __fs.lstatSync(sourcePathStr);
            __sourceFileExists = !!(__stat && (__stat.isFile() || (typeof __stat.isFile !== "function")));
        } catch (eStat) {
            __sourceFileExists = false;
        }
        if (!__sourceFileExists) {
            plog("source disk file not found (sourcePathStr='" + sourcePathStr + "') — falling back to sourceDoc.saveACopy() (IDML-opened or unsaved doc)");
            try {
                await sourceDoc.saveACopy(saveTargetPath);
                plog("workCopy saveACopy DONE → " + saveTargetPath);
            } catch (eSaveCopy) {
                var __scMsg = "workCopy saveACopy failed: " + (eSaveCopy && eSaveCopy.message ? eSaveCopy.message : eSaveCopy);
                report.errors.push(__scMsg);
                plog("workCopy saveACopy FAIL: " + (eSaveCopy && eSaveCopy.message ? eSaveCopy.message : eSaveCopy));
                // guard-ux UX sweep: this early-return used to be silent.
                try { showAlert("Import stopped — could not stage the working copy of the source document.\n\n" + __scMsg); } catch (eSCA) {}
                return;
            }
            report.pipeline_stage = "open_workdoc";
        } else {
        // 进度 % 基于 5/28 实测 3 轮 import log 的实际时间分布（见 DEV_LOG）：
        // 总时长 ~60s，commit 阶段 70% / apply 10% / repair 11% / 其他 9%
        if (__processing) __processing.update("Copying source to translated.indd", 7);
        plog("readFileSync+writeFileSync(source → " + saveTargetPath + ") — disk-level workCopy");
        // UXP fs ships readFileSync / writeFileSync but NOT copyFile /
        // copyFileSync — the Node-style helpers we'd prefer were never
        // surfaced in the UXP host. Doing the byte-copy by hand (read
        // → write) is portable and stays synchronous, so the await
        // Promise in the bridge harness resolves deterministically
        // even on the Z: SMB share where async copyFile callbacks
        // sometimes never fire within the 30-second kickoff window.
        var __bytes = __fs.readFileSync(sourcePathStr);
        __fs.writeFileSync(saveTargetPath, __bytes);
        plog("workCopy disk copy DONE (" + (__bytes && __bytes.length ? __bytes.length : "?") + " bytes)");
        }

        report.pipeline_stage = "open_workdoc";
        // showingWindow=true so app.activeDocument resolves throughout
        // the pipeline body. runRepairCore (RepairAfterApply) consults
        // app.activeDocument internally rather than taking a doc
        // parameter — opening invisible in headless runs made the
        // repair step abort with "No documents are open." even though
        // pipeline + save themselves succeeded. We don't close the
        // workCopy at the end of headless runs (it stays open as the
        // deliverable, opened_translated=true), so the panel-binding
        // ref cost the invisible mode was meant to avoid never matters
        // — the original Protective Shutdown was triggered by closing
        // the user's SOURCE doc, not the script's workCopy.
        if (__processing) __processing.update("Opening translated document", 10);
        // 作用域式关掉 Adobe Fonts 自动激活（只包住 open —— 激活正是在这一刻触发的）。
        // 它是一种**静默兜底**：背地里替我们补字体，与 design-intent §8「config 权威·
        // 缺则显式·NO fallback」相反；而且请求若永不返回就会卡死后台队列。关掉之后，
        // 缺字体退化成 doc.fonts 里一条 NOT_AVAILABLE —— 可读、可当闸的信号。
        // 恢复在下方 try/catch 之后（成功/失败两条路都会走到）。
        var __prevAutoFont = null, __autoFontToggled = false;
        try {
            var __fsp = app.fontSyncPreferences;
            if (__fsp && typeof __fsp.autoActivateFont === "boolean") {
                __prevAutoFont = __fsp.autoActivateFont;
                __fsp.autoActivateFont = false;
                __autoFontToggled = true;
                plog("host env: autoActivateFont " + __prevAutoFont + " -> false (scoped to app.open)");
            }
        } catch (eAF0) { plog("WARN: could not scope autoActivateFont (non-fatal): " + (eAF0 && eAF0.message)); }
        plog("await app.open(saveTargetPath, true)");
        workDoc = await app.open(saveTargetPath, true);
        plog("app.open DONE — workDoc visible + active, font/link dialogs handled");
    } catch (eOpen) {
        report.errors.push("workCopy setup failed: " + (eOpen && eOpen.message ? eOpen.message : eOpen));
        plog("workCopy setup FAIL: " + (eOpen && eOpen.message ? eOpen.message : eOpen));
        // copyFile may have created the target file before open failed.
        // Clean it up so the next run isn't confused.
        // #70: this used to discard the result AND say nothing at all — quieter
        // than a false success and just as blind. If the stray file survives,
        // the NEXT run inherits it, so the failure has to be visible here.
        try {
            var __rmOrphan = await FileUtils.removeFileVerified(saveTargetPath);
            if (!__rmOrphan.ok) {
                plog("cleanup of partial workCopy FAILED — " + saveTargetPath
                    + " is STILL THERE and the next run will see it: " + __rmOrphan.err);
            }
        } catch (eRm) {
            plog("cleanup of partial workCopy threw: " + (eRm && eRm.message ? eRm.message : eRm));
        }
    }

    // 恢复 autoActivateFont —— 成功/失败两条路都会走到这里（try/catch 已结束）。
    // 只在 open 期间关，之后还回去，不改 user 交互使用时的行为。
    if (__autoFontToggled) {
        try {
            app.fontSyncPreferences.autoActivateFont = __prevAutoFont;
            plog("host env: autoActivateFont restored -> " + __prevAutoFont);
        } catch (eAF1) { plog("WARN: failed to restore autoActivateFont: " + (eAF1 && eAF1.message)); }
    }

    // Switch to NEVER_INTERACT for the pipeline body — prevents per-frame
    // missing-font / missing-link dialogs from interrupting commit + apply.
    // The font/link substitution policy was already locked in during open.
    if (workDoc) {
        try { app.scriptPreferences.userInteractionLevel = UserInteractionLevels.NEVER_INTERACT; }
        catch (eUI1) { plog("WARN: failed to set NEVER_INTERACT post-open: " + eUI1.message); }
    }

    // [Fix A — P1 root · ported from retired import_translations_v2.idjs] Re-derive
    // edit-mode routing from the OPENED workDoc's provenance, NOT the pre-copy in-memory
    // sourceDoc. Here workDoc is a DISK-BYTE copy (readFileSync/writeFileSync, #BRIDGE-5
    // above — UXP fs ships no copyFile) which can
    // be STALE vs an in-memory-reorganized sourceDoc: a standalone reorganize turns
    // sourceDoc into a clustered doc IN MEMORY ONLY, so sourceDoc classifies
    // "imported-legacy" (has _T_p_* clusters) while the disk copy has ZERO clusters. The
    // pre-copy classify (:1006) then sent this to legacy-promotion edit mode → commit
    // SKIPPED → _T_p_* bullet styles never rebuilt from segments.json (P1 root cause).
    // Classifying workDoc — the actual bytes the pipeline operates on — closes that
    // state-epoch mismatch.
    //   • saveACopy branch ONLY (this whole else is !__inPlaceImport; the in-place path
    //     workDoc == sourceDoc so its classify already matches its workDoc).
    //   • Recompute the FULL classification (imported-legacy AND imported-with-state), not
    //     just legacyPromotion — else a genuinely-labeled saveACopy workDoc could be pushed
    //     to full pipeline → duplicate cluster pool.
    //   • Set ONLY editImportMode / legacyPromotion / sidecarState. NEVER flip
    //     __inPlaceImport (keeps failure-cleanup's stray-copy removal intact).
    //   • forceFullImport override WINS: if set, :995-998 already zeroed the flags; leave
    //     them (no re-derive), honoring the operator directive.
    if (workDoc) {
        if (ctx.__forceFullImportFromDialog) {
            plog("Fix A: forceFullImport override active → keeping full-pipeline flags (no workDoc re-derive)");
        } else {
            var __workProv = null;
            try { __workProv = DocProvenance.classify(workDoc); }
            catch (eWP) { plog("WARN: Fix A workDoc classify threw: " + (eWP && eWP.message ? eWP.message : eWP)); }
            if (__workProv) {
                var __wLegacy = (__workProv.state === "imported-legacy");
                var __wWithState = (__workProv.state === "imported-with-state");
                ctx.editImportMode = __wLegacy || __wWithState;
                ctx.legacyPromotion = __wLegacy;
                // imported-with-state → re-extract the label payload from the workDoc
                // (mirror the :1007 wiring) so edit-mode bypass stays true on a genuinely-
                // labeled doc; else null (legacy promotion synthesizes it after locate).
                ctx.sidecarState = __wWithState ? (__workProv.importState || null) : null;
                plog("Fix A: workDoc provenance re-derive → state=" + __workProv.state
                    + " editImportMode=" + ctx.editImportMode
                    + " legacyPromotion=" + ctx.legacyPromotion
                    + " sidecarState=" + (ctx.sidecarState ? "yes" : "null"));
            }
        }
    }

    } // end else (!__inPlaceImport)

    // Stage ⓪.c: pre-flight scratch dir setup (async; can't go inside
    // doScript). UXP fs has no mkdirSync; pre-create scratch dirs via
    // async mkdir before runPreflightSnapshot does its sync writeTextFile.
    // The actual snapshot capture (which mutates DOM via geom-split
    // expand) runs INSIDE the main doScript below — #1 fix.
    var snapshotInfo = null;
    if (workDoc && ctx.runSafety) {
        try {
            await FileUtils.ensureDirAsync(RuntimePaths.getDataDir());
            await FileUtils.ensureDirAsync(RuntimePaths.getLogDir());
        } catch (eEnsure) {
            plog("preflight: ensureDir warn " + (eEnsure && eEnsure.message ? eEnsure.message : eEnsure));
        }
    }

    // Stage ①-④: preflight snapshot + pipeline + repair, all inside ONE
    // ENTIRE_SCRIPT undo so a single Cmd/Ctrl+Z reverts the whole import
    // (preflight geom-expand + commit + apply + repair). Previously
    // preflight ran outside doScript (orphan geom-expand on Undo) and
    // repair opened its own ENTIRE_SCRIPT (#2 — two undo items).
    if (workDoc) {
        // #25 fix: capture caller's enableRedraw so the finally below
        // restores it (mirrors reorganize_styles_inplace.idjs:423/860,
        // i.e. the #11 fix). Previously this block forced false then
        // unconditionally true, polluting any parent script that had
        // intentionally disabled redraw.
        if (origEnableRedraw === null) {
            try { origEnableRedraw = app.scriptPreferences.enableRedraw; } catch (eER0) {}
        }
        app.scriptPreferences.enableRedraw = false;
        // 2026-05-28: 接下来的 sync app.doScript(..., ENTIRE_SCRIPT) 块
        // 是个 30-60 秒的整段 InDesign 内部锁（commit 阶段独占 ~70%）。
        // Probe 09 / 10 验证：sync 期间 JS 事件循环全停（setInterval / CSS
        // keyframe / DOM patch 都排队），dialog 真的没法在期间显示进度。
        // 务实方案：进入前把进度条设到 "约一半" 位置 + 诚实文案告诉用户
        // 这段是不可视化的，期望管理。doScript 退出后下面会迅速推到
        // 90 → 95 → 98 → 100% 给真实进度反馈。
        if (__processing) {
            try {
                __processing.update(
                    "Applying translations + style cleanup (InDesign busy ~50s, no progress shown)",
                    50
                );
            } catch (eUI) {}
        }
        try {
            app.doScript(function () {
                try {
                    // ── Preflight snapshot (#1 fix: inside undo block) ──
                    if (ctx.runSafety) {
                        plog("preflight: snapshot begin (INSIDE undo block)");
                        try {
                            snapshotInfo = ReorganizeDocOps.runPreflightSnapshot(workDoc, plog, {
                                getCollectionItem: getCollectionItem,
                                safe: function (v) { try { return String(v); } catch (e) { return ""; } },
                                ListType: ListType,
                                RuntimePaths: RuntimePaths,
                                SnapshotWriter: SnapshotWriter,
                                SnapshotUtils: SnapshotUtils,
                                StoryUtils: StoryUtils,
                                FileUtils: FileUtils
                            });
                            report.preflight_snapshot = snapshotInfo
                                ? { story_count: snapshotInfo.storyCount, snapshot_path: snapshotInfo.snapshotPath }
                                : { story_count: 0, snapshot_path: null };
                            plog("preflight: snapshot end stories=" + (snapshotInfo ? snapshotInfo.storyCount : 0));
                        } catch (ePF) {
                            report.preflight_snapshot = { error: (ePF && ePF.message ? ePF.message : String(ePF)) };
                            plog("preflight: snapshot FAIL " + (ePF && ePF.message ? ePF.message : ePF));
                            // #21 fix: under Safety mode, snapshot failure
                            // must fail-closed. Re-throw so the inner catch
                            // records it; pipelineResult stays null and the
                            // save branch will close workDoc + delete the
                            // .translated.indd clone (no mutation reaches
                            // user's deliverable). Mirrors the fail-closed
                            // treatment #13 added to reorganize_styles_inplace.idjs.
                            if (ctx.runSafety) {
                                report.preflight_aborted = true;
                                throw new Error("preflight snapshot failed (Safety mode fail-closed): "
                                    + (ePF && ePF.message ? ePF.message : String(ePF)));
                            }
                        }
                    }

                    // Preclean (splitSoftBreaks): runs INSIDE doScript so it
                    // shares the ENTIRE_SCRIPT undo with the pipeline — user
                    // can revert the whole import (preclean + commit + apply)
                    // with a single Cmd/Ctrl+Z. Skipped when checkbox unchecked
                    // OR when skipStyleCleanup is on (no style pool to align).
                    if (ctx.splitSoftBreaks && !ctx.skipStyleCleanup) {
                        plog("doScript: preclean splitSoftBreaks begin");
                        try {
                            var docOpsDeps = {
                                getCollectionItem: getCollectionItem,
                                safe: function (v) { try { return String(v); } catch (e) { return ""; } },
                                ListType: ListType,
                                RuntimePaths: RuntimePaths,
                                SnapshotWriter: SnapshotWriter,
                                SnapshotUtils: SnapshotUtils,
                                StoryUtils: StoryUtils,
                                FileUtils: FileUtils
                            };
                            var beforeOverflow = ReorganizeDocOps.snapshotOverflowState(workDoc, docOpsDeps);
                            var splitRes = ReorganizeDocOps.splitSoftBreaksWithFormatChange(
                                workDoc, ctx.fingerprintDimensions || null, plog, docOpsDeps
                            );
                            var revertRes = ReorganizeDocOps.revertSplitsThatCausedOverflow(
                                workDoc, splitRes.splitRefsByStoryId, splitRes.splitDeltasByStoryId,
                                beforeOverflow, plog, docOpsDeps
                            );
                            report.preclean = {
                                soft_break_found:        splitRes.found,
                                soft_break_split:        splitRes.split,
                                soft_break_reverted:     revertRes.revertedTotal,
                                stories_fixed:           revertRes.storiesFixed,
                                stories_unfixable:       revertRes.storiesUnfixable,
                                paragraphs_before:       splitRes.paragraphsBefore,
                                paragraphs_after:        splitRes.paragraphsAfter
                            };
                            // #E2E-12 (B): hand the FINAL splitDeltasByStoryId
                            // (post-revert) into v2_pipeline so runPipeline can
                            // shift each segment.paragraph_index by the cumulative
                            // tailCount of splits at lower paraIdx in the same
                            // story. Without this, preclean inflates story
                            // paragraph counts (e.g. 17 → 19) while
                            // segments.json's paragraph_index is still based on
                            // pre-preclean indices — segment_locator then maps
                            // multiple segments to the same post-split paragraph,
                            // and the second write_target call clobbers / merges
                            // content (we saw 6 of 17 paragraphs lost on the
                            // Client-A Product-4 doc round-trip).
                            ctx.splitDeltasByStoryId = splitRes.splitDeltasByStoryId;
                            plog("doScript: preclean DONE found=" + splitRes.found
                                + " split=" + splitRes.split + " reverted=" + revertRes.revertedTotal);
                        } catch (ePC) {
                            report.errors.push("preclean threw: " + (ePC && ePC.message ? ePC.message : ePC));
                            plog("doScript: preclean FAIL " + (ePC && ePC.message ? ePC.message : ePC));
                        }
                    }

                    plog("doScript: runPipeline begin (skipStyleCleanup=" + !!ctx.skipStyleCleanup
                        + " applyStyleToUntranslated=" + !!ctx.applyStyleToUntranslated + ")");
                    // #FAST-PAGE: park the active layout window on the LAST
                    // page (or any page far from where edits actually land)
                    // so live composition / panel-event listeners don't
                    // re-fit the visible page after every cluster/annotation
                    // apply. Manual runs measured 17× slower than headless
                    // bridge runs (185s vs 11s for the Client-A Product-2 doc)
                    // because the focused page kept invalidating its
                    // composition each per-paragraph mutation. Parking on a
                    // page that doesn't contain the edited stories lets
                    // InDesign batch the recomposition until save / scroll.
                    //
                    // 🔴 2026-09-08: THIS BLOCK HAD NEVER EXECUTED. It read
                    // `workDoc.activeLayoutWindow`, and **that property does not exist** —
                    // it appears nowhere in the InDesign DOM reference (`Adobe_docs/
                    // indesign-18-dom-main`); the real accessors are `Document.layoutWindows`
                    // (a collection) and `Application.activeWindow`. So `__fastPageWin` was
                    // `undefined` on every run, the `if` fell through, the surrounding
                    // `try/catch` swallowed nothing because nothing threw, and the whole
                    // remedy was inert — silently, for as long as it has existed.
                    // The 185s-vs-11s figure quoted above measures the PROBLEM; there is no
                    // recorded measurement that this fix ever helped, and now we know why.
                    // It became visible only when a line was added saying it did NOT happen:
                    // a device that quietly does nothing is indistinguishable from one that
                    // works, until something makes the absence itself a reading.
                    // The correct idiom was already in this repo, twice — lib/
                    // repair_after_apply.js:69 and cjk_style_apply.idjs:633 — so this is a
                    // working pattern that failed to propagate, the mirror image of the
                    // usual "fix one line, leave the concept unswept".
                    // ⚠ Deliberately NO `app.layoutWindows` fallback (repair_after_apply has
                    // one): item 0 there can belong to a DIFFERENT document, and parking it
                    // would move a page in a document this import was never asked to touch.
                    // No window for workDoc = genuinely headless = correctly skipped.
                    var __fastPageOrigPage = null;
                    var __fastPageWin = null;
                    try {
                        try {
                            if (workDoc.layoutWindows && workDoc.layoutWindows.length) {
                                __fastPageWin = getCollectionItem(workDoc.layoutWindows, 0);
                            }
                        } catch (eLW) { __fastPageWin = null; }
                        if (__fastPageWin) {
                            try { __fastPageOrigPage = __fastPageWin.activePage; } catch (eOP) {}
                            try {
                                var __pages = workDoc.pages;
                                var __lastPg = __pages.item(__pages.length - 1);
                                if (__lastPg && __lastPg.isValid) {
                                    __fastPageWin.activePage = __lastPg;
                                    // #HANG-LOG (20260908): say whether the park actually
                                    // happened. An unparked run is several times slower for
                                    // a reason no other line reports, so "it was on" must be
                                    // readable from the log rather than assumed.
                                    plog("#FAST-PAGE: parked window from page "
                                        + ((__fastPageOrigPage && __fastPageOrigPage.name) || "?")
                                        + " to " + (__lastPg.name || "?")
                                        + " (covers pipeline + repair + byPair + enforcer + emphasis settle)");
                                }
                            } catch (eLP) {}
                        }
                        if (!__fastPageWin) plog("#FAST-PAGE: NOT parked — workDoc.layoutWindows is empty (genuinely headless / bridge-opened)");
                    } catch (eFP0) {}

                    var entry = ctx.skipStyleCleanup
                        ? V2Pipeline.runMinimalApply
                        : V2Pipeline.runPipeline;
                    // 不再传 ctx.onProgress：probe 09 验证 sync doScript 期间
                    // dialog DOM patch 全排队，每次 callback 都是空调用。
                    // 进度条状态在 doScript 开始前已经设好，退出后下方 update
                    // 接管。__PROGRESS_MAP 的内部 plog 日志仍会写、便于追踪。
                    // #FAST-PAGE (widened 20260908). The park above used to be released
                    // in a `finally` around runPipeline ALONE. Everything after it —
                    // repair, the byPair sweep, the enforcer, and the emphasis settle
                    // pass — therefore ran with the window back on the page the operator
                    // left it on, i.e. with exactly the per-mutation visible-page
                    // recomposition the park exists to avoid. That is the whole reason a
                    // double-clicked run diverges from a bridge-driven one, and the
                    // divergence was only ever fixed for the first of the five phases.
                    // The release now lives in the `finally` of the enclosing try, so the
                    // park covers every phase inside this doScript and a throw anywhere
                    // still restores the operator's page.
                    pipelineResult = entry(workDoc, ctx, {
                            lib: {
                                fontMapping: FontMapping,
                                segmentLocator: SegmentLocator,
                                styleSheetBuilder: StyleSheetBuilder,
                                scriptClassifier: ScriptClassifier,
                                emphasisExtractor: EmphasisExtractor,
                                styleApplier: StyleApplier,
                                hardErrors: HardErrors,
                                styleMergeAdvisor: StyleMergeAdvisor
                            },
                            findFont: findFontByName,
                            hashFn: hashDjb2Hex,
                            getCollectionItem: getCollectionItem,
                            LinkStatus: LinkStatus,
                            ColorSpace: ColorSpace,
                            ColorModel: ColorModel,
                            Position: Position,
                            Justification: Justification,
                            Leading: Leading,
                            ListType: ListType,
                            TabStopAlignment: TabStopAlignment,   // [indent-general] for _applyTabStops
                            MeasurementUnits: MeasurementUnits,
                            RuleWidth: RuleWidth,
                            // #REALTIME-LOG (2026-05-26): pass plog through so
                            // runPipeline + commitStylePlan can flush progress
                            // markers during long sub-phases. Without this,
                            // commitStylePlan's 160s+ manual run produces zero
                            // log output and the .log file is useless if the
                            // process freezes mid-commit.
                            plog: plog
                        });
                    plog("doScript: runPipeline DONE (window still parked — released at the end of this doScript)");

                    // ── Repair inside same undo block (#2 fix) ──
                    // Use runRepairCore() (no nested doScript) so this
                    // joins the outer ENTIRE_SCRIPT undo. Previously
                    // ran AFTER doScript with runRepair() (two undo
                    // items, single Cmd+Z couldn't revert reorg+repair).
                    if (ctx.runSafety && pipelineResult
                            && !pipelineResult.aborted && !pipelineResult.blocked
                            && snapshotInfo) {
                        plog("repair: begin (runRepairCore — inside same undo)");
                        if (__processing) __processing.update("Running frame repair", 83);
                        // Bug#1 (1A): bridge the para_deltas contract. preclean's
                        // soft-break splits live in ctx.splitDeltasByStoryId (memory);
                        // repair reads para_deltas_latest.json (file). Serialize them
                        // now (bound to this run's snapshot) so computeOrdinalAdjustment
                        // compensates the split → ordinalRepair stops shrinking
                        // soft-break-split frames into overset. See
                        // findings.md#para-deltas-contract-drift.
                        var __pdOk = false, __pdFailMsg = null;
                        try {
                            var __pdRes = ReorganizeDocOps.writeParaDeltasForRepair(
                                workDoc, ctx.splitDeltasByStoryId, snapshotInfo,
                                { RuntimePaths: RuntimePaths, FileUtils: FileUtils, generatedBy: "import_integrated" }
                            );
                            plog("repair: para_deltas " + (__pdRes.ok ? "written" : "WRITE-FAILED")
                                + " stories=" + __pdRes.storiesWritten
                                + " snapshotCapturedAt=" + (__pdRes.snapshotCapturedAt || "null"));
                            __pdOk = !!__pdRes.ok;
                            if (!__pdOk) __pdFailMsg = (__pdRes.error && __pdRes.error.message ? __pdRes.error.message : String(__pdRes.error));
                        } catch (ePDw) {
                            __pdOk = false;
                            __pdFailMsg = (ePDw && ePDw.message ? ePDw.message : String(ePDw));
                            plog("repair: para_deltas write THREW " + __pdFailMsg);
                        }
                        // [audit A1] fail-closed: a para_deltas write failure under
                        // runSafety would let repair run with no/stale deltas → soft-break
                        // split frames silently shrink to overset (or a same-doc legacy
                        // file applies wrong ordinals). BLOCK so the doc is not saved as a
                        // clean .translated (routes to .BLOCKED for retry) rather than a
                        // silently-wrong layout. Save gates on pipelineResult.blocked.
                        if (!__pdOk) {
                            pipelineResult.blocked = true;
                            report.errors.push("para_deltas write failed → import BLOCKED (fail-closed, repair skipped): " + (__pdFailMsg || "unknown"));
                            plog("repair: SKIPPED — para_deltas write failed → BLOCKED (fail-closed)");
                        } else try {
                            var repairResult = RepairAfterApply.runRepairCore({});
                            report.repair = {
                                status_line: (repairResult && repairResult.statusLine) ? repairResult.statusLine : "(no status)",
                                log_lines:   (repairResult && typeof repairResult.logLines === "number") ? repairResult.logLines : 0
                            };
                            plog("repair: end status=" + report.repair.status_line);
                        } catch (eRP) {
                            report.repair = { status_line: "FAIL " + (eRP && eRP.message ? eRP.message : String(eRP)) };
                            report.errors.push("runRepair threw: " + (eRP && eRP.message ? eRP.message : eRP));
                            plog("repair: FAIL " + (eRP && eRP.message ? eRP.message : eRP));
                        }
                    } else if (ctx.runSafety && !snapshotInfo) {
                        plog("repair: SKIPPED (no preflight snapshot to read)");
                    } else if (ctx.runSafety) {
                        plog("repair: SKIPPED (pipeline did not commit)");
                    }

                    // ── 8D-ext-D step-3b: byPair char-sweep facade (M4/M5) ──
                    // INSIDE this ENTIRE_SCRIPT closure, AFTER runPipeline/
                    // runMinimalApply + repair (spec :2001; :2299 "已过所有
                    // internal restore steps"). The facade RETURNS {blocked}
                    // (uniform shape) which we OR into pipelineResult.blocked
                    // — never un-block; a facade EXCEPTION marks blocked and
                    // re-throws (task_plan :2313 verbatim) so the no-save
                    // branch discards the workCopy. Empty byPair → facade
                    // no-ops (shipped guard) but still yields diagnostics.
                    if (pipelineResult && !pipelineResult.aborted && !pipelineResult.blocked
                            && ctx.preloadedFontMapping) {
                        var __bpSweepMode = ctx.skipStyleCleanup ? "M5" : "M4";
                        var __bpSweepOut = null;
                        plog("byPair: begin sweep entries="
                            + ((ctx.preloadedFontMapping.byPair || []).length)
                            + " mode=" + __bpSweepMode);
                        try {
                            // r22 P3: ensure workDoc active before the facade
                            // (it asserts activeDocument identity — scan is
                            // hardwired to activeDocument). Writability of
                            // app.activeDocument is probe-pending (r25 P2#3,
                            // step-5); if the set fails, the facade's own
                            // assertion throws into the catch below →
                            // blocked + no save (no silent wrong-doc sweep).
                            try {
                                if (app.activeDocument !== workDoc) app.activeDocument = workDoc;
                            } catch (eBpAct) {}
                            __bpSweepOut = ByPairSweep.applyByPairSweep(workDoc, ctx.preloadedFontMapping.byPair, {
                                mode: __bpSweepMode,
                                skipDecisions: ctx.preloadedFontMapping.skipDecisions || {},
                                brandConfig: ctx.preloadedFontMapping.brandConfig || {},
                                langScriptTable: ctx.preloadedFontMapping.langScriptTable || {}
                            });
                            pipelineResult.byPairSweep = __bpSweepOut;
                            pipelineResult.blocked = pipelineResult.blocked || __bpSweepOut.blocked;
                            plog("byPair: end swapped=" + __bpSweepOut.swapped
                                + " errors=" + __bpSweepOut.errors
                                + " blocked=" + __bpSweepOut.blocked
                                + " warnings=" + (((__bpSweepOut.diagnostics || {}).warnings) || []).length);
                        } catch (eBpFacade) {
                            pipelineResult.blocked = true;
                            pipelineResult.facadeError = String(eBpFacade && eBpFacade.message ? eBpFacade.message : eBpFacade);
                            plog("byPair: facade THREW " + pipelineResult.facadeError);
                            throw eBpFacade;
                        }

                        // ── post-sweep full-doc script-font enforcer ──
                        // M4: the per-para enforcer already ran inside
                        // applyOnePara; a second pass is only needed when the
                        // sweep actually swapped (designer-CS chars whose font
                        // matched a byPair srcFont). M5: runMinimalApply has
                        // ZERO enforcer calls — this is THE enforcer site,
                        // full-doc scope, NOT just swept ranges. Both gated on
                        // ctx.runEnforcer (default-on). preserve list from
                        // appliedActions so this pass can't revert facade
                        // swaps (r26 P3; mirrors reorganize_inplace_core
                        // :1328-1380; gate-11 table-cell walk).
                        var __bpWantEnforcer = (ctx.runEnforcer !== false)
                            && !pipelineResult.blocked
                            && (__bpSweepMode === "M5"
                                || (__bpSweepOut && __bpSweepOut.swapped > 0));
                        if (__bpWantEnforcer) {
                            var __bpAllParas = [];
                            try {
                                var __bpStories = workDoc.stories;
                                for (var __bpSi = 0; __bpSi < __bpStories.length; __bpSi++) {
                                    var __bpStory = getCollectionItem(__bpStories, __bpSi);
                                    if (!__bpStory || !__bpStory.isValid) continue;
                                    var __bpSp = __bpStory.paragraphs;
                                    for (var __bpPi = 0; __bpPi < __bpSp.length; __bpPi++) {
                                        var __bpPr = getCollectionItem(__bpSp, __bpPi);
                                        if (__bpPr) __bpAllParas.push(__bpPr);
                                    }
                                    var __bpTbls = __bpStory.tables;
                                    for (var __bpTi = 0; __bpTi < __bpTbls.length; __bpTi++) {
                                        var __bpTbl = getCollectionItem(__bpTbls, __bpTi);
                                        if (!__bpTbl) continue;
                                        var __bpCells = __bpTbl.cells;
                                        for (var __bpCi = 0; __bpCi < __bpCells.length; __bpCi++) {
                                            var __bpCell = getCollectionItem(__bpCells, __bpCi);
                                            if (!__bpCell) continue;
                                            var __bpCps = __bpCell.paragraphs;
                                            for (var __bpCpi = 0; __bpCpi < __bpCps.length; __bpCpi++) {
                                                var __bpCpr = getCollectionItem(__bpCps, __bpCpi);
                                                if (__bpCpr) __bpAllParas.push(__bpCpr);
                                            }
                                        }
                                    }
                                }
                            } catch (eBpCollect) {
                                plog("enforcer(post-sweep): para-collect partial: "
                                    + (eBpCollect && eBpCollect.message ? eBpCollect.message : eBpCollect));
                            }
                            plog("enforcer(post-sweep): begin mode=" + __bpSweepMode
                                + " full-doc paras=" + __bpAllParas.length);
                            try {
                                var __bpPreserve = ByPairWiring.buildEnforcerPreserveList(
                                    (__bpSweepOut && __bpSweepOut.appliedActions) || []);
                                var __bpEnfTotals = { cjkEnforced: 0, latinEnforced: 0, preserved: 0, errors: 0 };
                                for (var __bpEi = 0; __bpEi < __bpAllParas.length; __bpEi++) {
                                    var __bpEp = __bpAllParas[__bpEi];
                                    if (!__bpEp || !__bpEp.isValid) continue;
                                    var __bpEs = ScriptFontEnforcer.enforceScriptFontsInParagraph(
                                        __bpEp, { preserve: __bpPreserve });
                                    __bpEnfTotals.cjkEnforced += __bpEs.cjkEnforced;
                                    __bpEnfTotals.latinEnforced += __bpEs.latinEnforced;
                                    __bpEnfTotals.preserved += (__bpEs.skippedPreservedFont || 0);
                                    __bpEnfTotals.errors += __bpEs.errors;
                                }
                                pipelineResult.postSweepEnforcer = __bpEnfTotals;
                                plog("enforcer(post-sweep): end cjk=" + __bpEnfTotals.cjkEnforced
                                    + " latin=" + __bpEnfTotals.latinEnforced
                                    + " preserved=" + __bpEnfTotals.preserved
                                    + " errors=" + __bpEnfTotals.errors);
                            } catch (eBpEnf) {
                                pipelineResult.postSweepEnforcerError =
                                    (eBpEnf && eBpEnf.message ? eBpEnf.message : String(eBpEnf));
                                plog("enforcer(post-sweep): FAIL " + pipelineResult.postSweepEnforcerError);
                            }
                        } else if (ctx.runEnforcer === false) {
                            plog("enforcer(post-sweep): SKIPPED (ctx.runEnforcer === false)");
                        }
                    }

                    // ── #ac-overset-widen PASS 2: emphasis on the settled layout ──
                    //
                    // WHY HERE, AND WHY THIS EXACT SPOT (host-isolated 20260715 — do not
                    // move without re-probing):
                    //
                    // The bug: applying an emphasis char style to characters sitting in a
                    // frame's OVERSET region SILENTLY no-ops (no throw → the report said
                    // failed:0 while the headline tail stayed baseline weight). Pass 1
                    // (ctx.deferEmphasis) therefore skips every emphasis site and records a
                    // worklist; this drives it once the layout is settled and the widen can
                    // read frame.overflows correctly.
                    //
                    // AFTER the byPair sweep + enforcer, and that is not cosmetic: applying
                    // BEFORE the sweep perturbs it (measured: swapped 4→2, and the emphasis
                    // ranges surface as unmappedCjk.owned_missing_target). Same final fonts,
                    // but a divergence in a stage that isn't ours to change.
                    //
                    // INSIDE this doScript, deliberately: a save is NOT needed to settle the
                    // layout. The probe applied emphasis with no save and a deliberately
                    // STALE handle and it landed in full — refuting both "only a save-level
                    // flush settles it" and "the merge staled the handles". Both earlier
                    // claims came from a CONFOUNDED test (save→reopen changes the settle AND
                    // the handles at once). Staying inside the transaction keeps :1919's
                    // single-Ctrl+Z whole-import undo, needs no second save, and keeps the
                    // one #BRIDGE-17 sweep below (which runs AFTER this, so it still catches
                    // any not-installed font this pass puts on characters).
                    //
                    // THE DEPENDENCY (arch-accepted, 20260715): the settle is supplied by
                    // what runs BEFORE this — the apply loop completing, plus repair /
                    // postflight walking the frames and forcing composition. The MINIMAL
                    // sufficient condition was NOT isolated (every probe arm ran after those
                    // stages), so this position is empirically verified, not mechanistically
                    // explained. If someone reorders repair/postflight and this stops
                    // working, it will NOT fail silently: the part-B per-char read-back
                    // (style_applier.js) surfaces overset_silent_drop, which is the
                    // regression backstop that made spending no further host rounds here an
                    // acceptable trade.
                    if (pipelineResult && pipelineResult.__emphasisPending) {
                        try {
                            var __empOut = V2Pipeline.runEmphasisSettlePass(workDoc, pipelineResult.__emphasisPending);
                            if (__empOut && __empOut.ok) {
                                // Merge over report.apply: the pipeline materialized those
                                // fields while pass 1 was still deferring, so they read zero
                                // until now. Same object (report === ctx.report) → in-place.
                                if (report.apply && __empOut.fields) {
                                    for (var __fk in __empOut.fields) {
                                        if (Object.prototype.hasOwnProperty.call(__empOut.fields, __fk)) {
                                            report.apply[__fk] = __empOut.fields[__fk];
                                        }
                                    }
                                }
                                report.emphasis_settle_pass = {
                                    paras_applied: __empOut.parasApplied,
                                    skipped_invalid: __empOut.skippedInvalid,
                                    throws: __empOut.throws
                                };
                                // 🔴 2026-09-08: this used to print `readbackFailures=<n>`.
                                // The name was wrong and the number was unusable. The array
                                // is `summary.surfaced` (style_applier.js:1300 returns
                                // "surfaced", not "failed"), and it carries ~20 distinct
                                // reasons — at least three of which fire on sub-runs that
                                // APPLIED CORRECTLY. The clearest is `collision_skipped_chars`
                                // (style_applier.js:1386-1394 via the per-char gate at :1688):
                                // an emphasis run overlapping a translator annotation, a
                                // hyperlink CS or a designer CS applies to the rest of the run,
                                // correctly preserves the annotation, and increments the count
                                // by one. Zero defect, guaranteed +1.
                                // So a bare count conflates a by-design skip with a silently
                                // dropped emphasis, under a name that asserts the latter — a
                                // reading whose precision is below the claim its own name makes.
                                // Print the reason histogram instead: same cost, and it says
                                // WHAT IT COVERS, which is what makes the number usable at all.
                                var __surf = (__empOut.fields && __empOut.fields.target_emphasis_run_failures) || [];
                                var __hist = {}, __hk;
                                for (var __si = 0; __si < __surf.length; __si++) {
                                    __hk = String((__surf[__si] && __surf[__si].reason) || "(no reason)");
                                    __hist[__hk] = (__hist[__hk] || 0) + 1;
                                }
                                var __histParts = [];
                                for (__hk in __hist) {
                                    if (Object.prototype.hasOwnProperty.call(__hist, __hk)) __histParts.push(__hk + "=" + __hist[__hk]);
                                }
                                __histParts.sort();
                                plog("emphasis settle pass: paras=" + __empOut.parasApplied
                                    + " skippedInvalid=" + __empOut.skippedInvalid
                                    + " throws=" + __empOut.throws
                                    + " framesWidened=" + ((__empOut.fields && __empOut.fields.frames_widened) || []).length
                                    + " surfaced=" + __surf.length
                                    + (__histParts.length ? " [" + __histParts.join(" ") + "]" : "")
                                    + "  (surfaced != failed — some of these reasons fire on runs that applied)");
                            } else {
                                report.emphasis_settle_pass = { ok: false, error: __empOut && __empOut.error };
                                report.errors.push("emphasis settle pass did not run"
                                    + (__empOut && __empOut.error ? (": " + __empOut.error) : "")
                                    + " — target text + styles landed, emphasis did NOT");
                            }
                        } catch (eEP) {
                            report.emphasis_settle_pass = { ok: false, error: (eEP && eEP.message ? eEP.message : String(eEP)) };
                            report.errors.push("emphasis settle pass threw: " + (eEP && eEP.message ? eEP.message : eEP));
                            plog("emphasis settle pass THREW: " + (eEP && eEP.message ? eEP.message : eEP));
                        }
                        pipelineResult.__emphasisPending = null;
                    }

                    // ── #ac-overset-widen AC3: re-run postflight AFTER the emphasis pass ──
                    //
                    // The pipeline's own postflight (v2_pipeline.js:3662) runs inside pass 1,
                    // so with emphasis deferred it now judges an incomplete world in TWO ways
                    // (both found by the 20260715 impl-audit, both A-class):
                    //
                    //  1. It does not merely scan the doc — it DERIVES raw errors from the
                    //     same `applyResults` the emphasis sites write: `cluster_apply_failure`
                    //     (blocking) and `format_mixed_not_restored` (warning), hard_errors.js
                    //     :354-375. Everything pass 2 writes lands after it. Step 4 is gated
                    //     `!deferEmphasis`, so in production `formatMixedNotRestored` was
                    //     GUARANTEED empty at that point — the warning channel was 100% dead,
