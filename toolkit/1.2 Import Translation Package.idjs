                // downgrade. Opt-in ON only where the save-time dialog would
                // otherwise deadlock (BRIDGE-17 headless 5-min stalls): set
                // ctx.allowFontDowngrade or globalThis.__IMPORT_ALLOW_FONT_DOWNGRADE.
                // NOTE: the ② brand pair-authority emphasis fix means real brand
                // weights now resolve to INSTALLED faces (Semibold→MHei Xbold), so
                // this remap should rarely fire for brand fonts at all now.
                var __allowFontDowngrade = false;
                try { if (typeof ctx === "object" && ctx && ctx.allowFontDowngrade === true) __allowFontDowngrade = true; } catch (eADF) {}
                try { if (typeof globalThis !== "undefined" && globalThis && globalThis.__IMPORT_ALLOW_FONT_DOWNGRADE === true) __allowFontDowngrade = true; } catch (eADF2) {}
                __mfStats.allowDowngrade = __allowFontDowngrade;
                __mfStats.skippedDowngrade = 0;
                // For each invalid combo, find/change to a fallback variant.
                try {
                    app.findTextPreferences = __NothingEnum.NOTHING;
                    app.changeTextPreferences = __NothingEnum.NOTHING;
                } catch (eRP) {}
                for (var __ici = 0; __ici < __invalidCombos.length; __ici++) {
                    var __inv = __invalidCombos[__ici];
                    if (!__allowFontDowngrade) {
                        // Brand policy: do NOT silently downgrade. Record loudly +
                        // leave the missing font visible (surfaces at save).
                        __mfStats.skippedDowngrade++;
                        __mfStats.details.push({ from: __inv.name, to: null, reason: "downgrade_off" });
                        continue;
                    }
                    var __replName = __pickFallback(__inv.family, __inv.style);
                    if (!__replName) {
                        __mfStats.failed++;
                        __mfStats.details.push({ from: __inv.name, to: null, reason: "no_fallback" });
                        continue;
                    }
                    try {
                        try {
                            app.findTextPreferences = __NothingEnum.NOTHING;
                            app.changeTextPreferences = __NothingEnum.NOTHING;
                        } catch (eRP2) {}
                        app.findTextPreferences.appliedFont = __inv.name;
                        app.changeTextPreferences.appliedFont = __replName;
                        var __hits = workDoc.changeText();
                        __mfStats.replaced++;
                        __mfStats.details.push({
                            from: __inv.name,
                            to: __replName,
                            ranges: (__hits && __hits.length) ? __hits.length : 0
                        });
                    } catch (eCh) {
                        __mfStats.failed++;
                        __mfStats.details.push({
                            from: __inv.name, to: __replName,
                            error: (eCh && eCh.message) ? eCh.message : String(eCh)
                        });
                    }
                }
                try {
                    app.findTextPreferences = __NothingEnum.NOTHING;
                    app.changeTextPreferences = __NothingEnum.NOTHING;
                } catch (eRP3) {}
