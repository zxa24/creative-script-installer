        // so visual weight is preserved when possible.
        // #BRIDGE-17 ungate (2026-05-26): also run for manual invocations.
        // Original gate was `&& __isAutomated`, intent being "let user
        // resolve missing fonts via the dialog in manual mode". But the
        // save-time Missing Fonts dialog category doesn't honor
        // userInteractionLevel and freezes save indefinitely behind
        // another window in some cases (observed on Client-A Product-2 2026-05-26).
        // Pre-remapping is safer for manual too: missing fonts get a
        // visible-named "_T_*" fallback the user can re-link later.
        // #ac-overset-widen: extracted to a function (single caller) purely to keep this
        // ~200-line sweep from burying the save sequence below. It is what stands between
        // workDoc.save() and the one modal NEVER_INTERACT does not suppress (gate #8), so
        // it must stay AHEAD of every save. It still covers the emphasis pass: that pass
        // now runs inside the pipeline doScript, i.e. BEFORE this — which matters, because
        // it is the first moment the `_T_c_emp_*` styles are APPLIED to characters, and
        // this sweep finds missing fonts via findText over the chars USING them. A style
        // merely DEFINED with a not-installed font is invisible to it. That ordering is
        // not academic: v2_pipeline.js:164-176 records a real workDoc.save deadlock of
        // exactly that shape (an emphasis run rewritten to a not-installed
        // "EJ Sans Text | Bold").
        var __runMissingFontSweep = function (__label, __reportKey) {
          // #BRIDGE-17b: wrap the changeText sweep in an ENTIRE_SCRIPT
          // doScript so InDesign auto-commits all internal transactions
          // before workDoc.save runs. Without this wrap the changeText
          // calls accumulate uncommitted transactions and the subsequent
          // save throws "Cannot save document because there are open
          // transactions in process on the database."
          var __mfWrap = null;
          try {
              var __indesignMF = require("indesign");
              app.doScript(function () {
            try {
                var __mfStats = { combosScanned: 0, combosInvalid: 0, replaced: 0, failed: 0, details: [] };
                var __indesign = require("indesign");
                var __NothingEnum = __indesign.NothingEnum;

                // Probe whether a (family, style) combination is an
                // INSTALLED variant. `workDoc.fonts.itemByName("Fam\tStyle")`
                // returns a valid Font when the variant is registered;
                // status === INSTALLED confirms it's usable. This catches
                // requests like "Source Han Sans CN | Semibold" where the
                // family is installed (so workDoc.fonts only lists "SHS")
                // but the specific variant isn't, which is exactly what
                // triggers the save-time Missing Fonts dialog.
                var __installedCache = {};
                function __isVariantInstalled(family, style) {
                    var key = family + "\t" + (style || "Regular");
                    if (Object.prototype.hasOwnProperty.call(__installedCache, key)) return __installedCache[key];
                    var ok = false;
                    try {
                        var probe = workDoc.fonts.itemByName(key);
                        if (probe && probe.isValid) {
                            var st = ""; try { st = String(probe.status); } catch (eS) {}
                            if (st && st.indexOf("INSTALLED") >= 0) ok = true;
                        }
                    } catch (e) {}
                    __installedCache[key] = ok;
                    return ok;
                }

                var __shsWeights = ["Regular", "Bold", "Medium", "Heavy", "Light", "Normal", "ExtraLight"];
                function __pickFallback(family, style) {
                    // Prefer same family with another weight if available
                    // (e.g. EJ Sans Text Semibold → EJ Sans Text Bold);
                    // else collapse to SHS Regular which is the project's
                    // baseline guaranteed-installed.
                    if (family === "Source Han Sans CN") {
                        for (var w = 0; w < __shsWeights.length; w++) {
                            if (__isVariantInstalled(family, __shsWeights[w])) {
                                return family + "\t" + __shsWeights[w];
                            }
                        }
                    } else {
                        // Try Latin family's nearest installed style.
                        var __latinFallback = ["Regular", "Bold", "Medium", "Light"];
                        for (var lw = 0; lw < __latinFallback.length; lw++) {
                            if (__isVariantInstalled(family, __latinFallback[lw])) {
                                return family + "\t" + __latinFallback[lw];
                            }
                        }
                    }
                    if (__isVariantInstalled("Source Han Sans CN", "Regular")) {
                        return "Source Han Sans CN\tRegular";
                    }
                    return null;
                }

                // Collect ALL (family, style) combinations actually used
                // by characters in this doc. Scan paragraph styles +
                // character styles + raw char-level appliedFont overrides.
                // Char-level scan walks every character; expensive but
                // unavoidable since findText needs the exact source
                // (family, style) to filter.
                var __usedCombos = {};   // key "family\tstyle" → true
                function __noteCombo(family, style) {
                    if (!family) return;
                    var k = family + "\t" + (style || "Regular");
                    __usedCombos[k] = true;
                }
                // Paragraph + character styles
                try {
                    var __ps = workDoc.paragraphStyles;
                    for (var pi = 0; pi < __ps.length; pi++) {
                        var p = __ps.item(pi);
                        try { __noteCombo(p.appliedFont && p.appliedFont.fontFamily, p.fontStyle); } catch (e) {}
                    }
                } catch (e) {}
                try {
                    var __cs = workDoc.characterStyles;
                    for (var ci0 = 0; ci0 < __cs.length; ci0++) {
                        var c0 = __cs.item(ci0);
                        try { __noteCombo(c0.appliedFont && c0.appliedFont.fontFamily, c0.fontStyle); } catch (e) {}
                    }
                } catch (e) {}
                // Char-level
                try {
                    var __sts = workDoc.stories;
                    for (var si = 0; si < __sts.length; si++) {
                        var __st = __sts.item(si);
                        var __chs = __st.characters;
                        var __nc = 0; try { __nc = __chs.length; } catch (e) {}
                        for (var ci = 0; ci < __nc; ci++) {
                            try {
                                var __ch = __chs.item(ci);
                                __noteCombo(__ch.appliedFont && __ch.appliedFont.fontFamily, __ch.fontStyle);
                            } catch (e) {}
                        }
                    }
                } catch (e) {}

                var __combosList = Object.keys(__usedCombos);
                __mfStats.combosScanned = __combosList.length;

                // Identify combos whose variant is NOT installed.
                var __invalidCombos = [];
                for (var __cci = 0; __cci < __combosList.length; __cci++) {
                    var __k = __combosList[__cci];
                    var __ps0 = __k.split("\t");
                    var __fam = __ps0[0];
                    var __sty = __ps0[1] || "Regular";
                    if (!__isVariantInstalled(__fam, __sty)) {
                        __invalidCombos.push({ family: __fam, style: __sty, name: __k });
                    }
                }
                __mfStats.combosInvalid = __invalidCombos.length;

