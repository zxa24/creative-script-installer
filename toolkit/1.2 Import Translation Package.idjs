                // "backup write failed: no such file or directory", i.e. a
                // permanent dead end on the ONE path it was written to protect.
                // ensureDirVerifiedAsync uses async fs.mkdir (the call that
                // creates script_outputs/package today) and then re-resolves the
                // path through lfs, so "created" is verified, not assumed.
                var __bkDir = { ok: false, error: "not attempted" };
                try { __bkDir = await FileUtils.ensureDirVerifiedAsync(__backupDir); }
                catch (eBkDir) { __bkDir = { ok: false, error: String((eBkDir && eBkDir.message) || eBkDir) }; }
                if (__bkDir.ok) { plog("AC9 backup dir ready (verified): " + __backupDir); }
                else { plog("AC9 backup dir NOT ready: " + __bkDir.error); }
                var __fsBackup = require("fs");
                __backupGate = PreOverwriteBackup.runBackupGate({
                    fs: __fsBackup,
                    hashBytesHex: VersionManifest.sha256HexOfBytes,
                    targetPath: saveTargetPath,
                    backupDir: __backupDir,
                    sep: srcSep,
                    baseName: _basename(_stripIndExt(saveTargetPath)),
