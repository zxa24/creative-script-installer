                // happens. ⇒ one Ctrl+Z cannot revert the import.
                // ⚠ Whether that outside label write is even its own undo entry is a HOST
                //   question and is NOT answered here — which is why the text no longer
                //   promises anything about undo, and names close-without-saving (which
                //   does not depend on the undo stack at all) as the discard path.
                showAlert("Import aborted — the safety backup could not be made, so the translated document on disk was NOT overwritten:\n\n"
                    + __backupGate.error
                    + "\n\nON DISK: unchanged —\n" + saveTargetPath
                    + "\n\nON YOUR SCREEN: the open document DOES contain this import's changes. They are unsaved."
                    + "\n\n\u26A0 Saving it (Ctrl+S, or \"Save\" when closing) would perform the very overwrite this gate refused — with NO backup."
                    + "\n\n\u26A0 Ctrl+Z is NOT a reliable way out. This import is not one undo step:"
                    + " it opens up to THREE separate undo entries, and writes a document label outside all of them."
                    + "\n  \u2022 To KEEP this translation: File > Save As, under a NEW name."
                    + "\n  \u2022 To DISCARD it: close the document WITHOUT saving.");
            } else {
                if (__processing) __processing.update("Saving translated document", 95);
                plog("await workDoc.save(" + saveTargetPath + ", false) — in-place save"
                    + (__backupGate.required ? " (backup verified: " + __backupGate.backupPath + ")" : ""));
                try {
                    await workDoc.save(saveTargetPath, false);
                    report.output = { path: saveTargetPath, ok: true, backup: __backupGate.backupPath || null };
                    report.opened_translated = true;   // doc has been open since stage ⓪.b
                    plog("save DONE — workDoc remains open as the deliverable");
                    // (8D-ext-GI: the old 2-step tee-up alert was removed — the
                    //  style preset is now applied INLINE before this save, above.)
                } catch (eSA) {
                    report.output = { path: saveTargetPath, ok: false, error: eSA.message };
                    report.errors.push("save failed: " + eSA.message);
                    plog("save FAIL " + eSA.message);
                }
            }
        } else {
            // No save: pipeline produced nothing usable. Close workDoc
            // without writing back + delete the source-clone file on disk.
            var skipReason = "unknown";
            if (!pipelineResult) skipReason = "pipeline returned null";
            else if (pipelineResult.aborted) skipReason = "aborted at stage: " + (pipelineResult.stage || "unknown");
            else if (pipelineResult.blocked) {
                // UNIFY model rule-2 (block reason reflects TRUE cause) [A-3]: the
                // block can come from preflight OR from the byPair char-sweep gate
                // (unmapped-CJK-unowned → rejection → blocked; coverage rejections;
                // M4-empty-langScriptTable; or a facade exception). The old code
                // hard-attributed EVERY block to preflight, so an unowned-CJK tofu
                // block was mis-reported as a preflight block (and, with the
                // length-gated persist above, left no surfaced cause at all). Probe
                // the byPair sweep FIRST (it ORs into pipelineResult.blocked LAST,
                // so a sweep block is the proximate cause) and fall back to preflight.
                var __pfBlocking = pipelineResult.preflight && pipelineResult.preflight.blocking_count;
                var __sw = pipelineResult.byPairSweep;
                var __swRej = (__sw && __sw.diagnostics && __sw.diagnostics.rejections) || [];
                var __swUnowned = (__sw && __sw.diagnostics && __sw.diagnostics.unmappedCjk &&
                    __sw.diagnostics.unmappedCjk.unowned) || [];
                if (pipelineResult.facadeError) {
                    skipReason = "blocked by byPair font sweep (facade error: " + pipelineResult.facadeError + ")";
                } else if (__sw && __sw.blocked) {
                    // 2026-06-20 (bypair-tofu-ux): name the offending font(s) so the
                    // operator sees WHICH font is unpaired-on-CJK (e.g. "Minion Pro
                    // Bold") instead of an anonymous count — the bare count left the
                    // operator with no actionable target ("add a pair" for WHAT?).
                    var __unownedNames = "";
                    if (__swUnowned.length > 0) {
                        var __seenUF = {}, __ufList = [];
                        for (var __ufi = 0; __ufi < __swUnowned.length; __ufi++) {
                            var __ufe = __swUnowned[__ufi] || {};
                            var __ufKey = ((__ufe.sourceFont || "?") + " " + (__ufe.sourceWeight || "")).replace(/\s+$/, "");
                            if (!__seenUF[__ufKey]) { __seenUF[__ufKey] = 1; __ufList.push(__ufKey); }
                        }
                        __unownedNames = __ufList.join(", ");
                    }
                    skipReason = "blocked by byPair font sweep ("
                        + (__swUnowned.length > 0
                            ? __swUnowned.length + " CJK run(s) in unpaired/Latin font [" + __unownedNames + "] — would save as tofu; add a pair for it or skip that font"
                            : __swRej.length + " rejection(s)") + ")";
                } else if (__pfBlocking) {
                    skipReason = "blocked by preflight (blocking=" + __pfBlocking + ")";
                } else {
                    skipReason = "blocked (cause unclassified — see report.bypair_sweep / report.preflight)";
                }
            }
            report.output = { path: null, ok: false, skipped: true, reason: skipReason };
            report.opened_translated = false;
            report.errors.push("save skipped: " + skipReason);
            plog("save SKIPPED: " + skipReason);

            // In-place mode: workDoc IS the operator's doc. Do NOT close or
            // delete — leave it open + on disk so the operator can inspect /
            // undo. Any partial changes were inside the ENTIRE_SCRIPT undo
            // step. ⚠ NOT a single undo step overall — see the abort-alert note above:
            // this file opens up to three ENTIRE_SCRIPT blocks plus label writes outside
            // them, so "one Ctrl+Z reverts everything" is not true of the whole import.
            if (__inPlaceImport) {
                plog("in-place mode: skipping close + cleanup of source doc on failure");
            } else {
                plog("await workDoc.close(SaveOptions.NO)");
                try {
                    await workDoc.close(SaveOptions.NO);
                    plog("close DONE");
                } catch (eC) {
                    report.errors.push("workDoc.close failed: " + eC.message);
                    plog("close FAIL " + eC.message);
                }
                plog("await removeFileVerified(" + saveTargetPath + ") — clean up source clone");
                // #70 WITNESS SITE. This line used to print "translated cleanup
                // DONE" unconditionally, discarding removeFileAsync's return
                // value. Measured 2026-08-22: it said DONE while the file was
                // still on disk and had to be removed by hand. Now the claim is
                // only made when the delete was verified, and a failure says why.
                try {
                    var __rmRes = await FileUtils.removeFileVerified(saveTargetPath);
                    if (__rmRes.ok) { plog("translated cleanup DONE (verified gone)"); }
                    else { plog("translated cleanup FAILED — file is STILL THERE: " + __rmRes.err); }
                }
                catch (eRm) { plog("translated cleanup FAIL " + eRm.message); }
            }
        }
    }

    // FIX 1: persist the byPair sweep summary into report.json. The facade
    // returns its diagnostics onto the EPHEMERAL pipelineResult.byPairSweep only
    // — without this, an uninstalled-dstFont Stage-1 skip (r25 P2#5 softer
    // routing: correctly does NOT block) leaves no trace in the saved report.
    // Merges onto report.bypair_sweep (already carrying brand_config_status from
    // FIX 2a).
    //
    // UNIFY model rule-2 (persist diagnostics UNCONDITIONALLY) [A-3]: the guard
    // USED to also require `__bpByPair.length > 0`, on the (now-false) premise that
    // an empty byPair no-ops the facade. It does NOT — applyByPairSweep falls
    // through with byPair=[] and STILL scans + classifies every CJK run as
    // unowned / owned_missing_target / skipped, converting unowned→rejection→
    // blocked (byPair_char_sweep.js:162). So an empty/skip-only/owned-missing run
    // produces real diagnostics (and possibly a BLOCK) that the length-gate then
    // dropped from the persisted report — the operator saw a blocked save with no
    // surfaced cause. Persist whenever the sweep object exists, regardless of
    // byPair length. projectedEntries reports the true length (may be 0).
    if (pipelineResult && pipelineResult.byPairSweep) {
        var __bpSweepSummary = ByPairWiring.buildByPairSweepSummary(
            pipelineResult.byPairSweep,
            { mode: __bpMode, projectedPairs: __bpPairingCount,
              projectedEntries: (__bpByPair && __bpByPair.length) || 0 });
        if (!report.bypair_sweep) report.bypair_sweep = {};
        for (var __ssk in __bpSweepSummary) {
            if (Object.prototype.hasOwnProperty.call(__bpSweepSummary, __ssk)) {
                report.bypair_sweep[__ssk] = __bpSweepSummary[__ssk];
            }
        }
        plog("byPair: persisted sweep summary swapped=" + report.bypair_sweep.swapped
            + " errors=" + report.bypair_sweep.errors
            + " skipped=" + (report.bypair_sweep.skipped || []).length
            + " warnings=" + (report.bypair_sweep.warnings || []).length
            + " rejections=" + (report.bypair_sweep.rejections || []).length
            + " blocked=" + report.bypair_sweep.blocked);
    }

    // Report files (always written, regardless of outcome)
    //
    // 🔴 2026-09-08: this used to be written into `parentDir` — the UNZIPPED PACKAGE
    // FOLDER — which the clean-success path then deletes a few lines below. The run
    // printed `Report: <path>` for a file it had just removed, on every successful
    // import. Verified: after a clean run neither the file nor its folder existed.
    // The report is the ONLY irreproducible thing in that folder (everything else
    // came out of the .zip, and the .zip survives), and it is the only artifact that
    // carries the per-entry `reason` behind the emphasis surfaced-count — so its
    // deletion is what makes that count unclassifiable.
    //
    // It now goes next to the durable log, under <docDir>/script_outputs/ — the same
    // move the .log itself was given on 2026-05-28 and for the same reason.
    // ⚠ NOT inside script_outputs/log/: `purgeOldLogsAsync` (lib/script_log_paths.js)
    // sweeps that directory by age (14d) and size with NO extension filter, so parking
    // the one irreproducible diagnostic there would re-create this bug on a delay.
    // ⚠ This also satisfies the 2026-08-22 「路径就够」 ruling rather than fighting it:
    // no copy inside the zip, nothing beside the zip, no unzipped folder kept, and no
    // second drifting copy of anything.
    if (__processing) __processing.update("Writing import report", 98);
    var stamp = compactTimestampNow();
    var __reportDir = __logBaseDir + sep + "script_outputs";
    var reportJsonPath = __reportDir + sep + "writeback_v2_report_" + stamp + ".json";
    var __reportBody = JSON.stringify(report, null, 2);
    var __reportWritten = false;
    try {
        writeUtf8File(reportJsonPath, __reportBody);
        __reportWritten = true;
    } catch (eR0) {
        // Durable location unavailable (script_outputs/ absent because ensureLogDir
        // failed, permissions, …). Fall back to the OLD location rather than losing the
        // report — and say so, because in the fallback it is the cleanup guard below
        // that keeps it alive, not the path.
        plog("report: durable write failed (" + (eR0 && eR0.message || eR0)
            + ") — falling back to the package folder");
        reportJsonPath = parentDir + sep + "writeback_v2_report_" + stamp + ".json";
    }
    try {
        if (!__reportWritten) writeUtf8File(reportJsonPath, __reportBody);
        plog("report: written to " + reportJsonPath);
    } catch (eR) {
        if (__processing) { try { __processing.close(); } catch (eCp) {} __processing = null;
                            try { __topLevelProcessing = null; } catch (eExp) {} }
        showAlert("Pipeline finished, but report write failed:\n" + eR.message);
        return;
    }
    // 主流程结束，先关 processing 再弹 summary（让用户先看到"完成 100%"
    // 一瞬间再被 summary alert 接管视觉）
    if (__processing) {
        try { __processing.close(); } catch (eCp) {}
        __processing = null;
        try { __topLevelProcessing = null; } catch (eExp) {}
    }

    // 2026-05-28: 清理 zip 解压出来的中间文件夹（仅在 import 成功路径
    // 才走到这里——失败 / cancel 路径上面已经 return 了，文件夹保留供
    // 调试）。`EXPORT_KEEP_FOLDER` env var 不适用 import，import 用
    // `IMPORT_KEEP_UNZIPPED` opt-out。
    // 2026-06-20 (bypair-tofu-ux): a BLOCKED / skipped save does NOT early-return
    // — it falls through to here, so a block would otherwise clean away the payload
    // an operator needs to inspect (the unowned-CJK list). Treat a skipped output
    // like the early-return failures the comment above intends: keep the folder.
    // ⚠ REWRITTEN 2026-09-08 — the original reason given here was "the writeback
    // report is written into this same unzipped folder, so cleaning it on a block
    // deletes the very diagnostics". That is no longer true: the report now lives in
    // <docDir>/script_outputs/ and survives every path. The guard is kept because the
    // PAYLOAD is still worth keeping on a block, which is a different reason — left
    // explicit so the next reader does not inherit a premise that has been retired.
    //
    // 🔴 And a second guard, which is what actually closes the class: refuse to delete
    // a folder that contains the log or the report. Both normally live under the
    // document's directory, but both fall back to `parentDir` when there is no open
    // document with a path (see __logBaseDir above, and the report fallback) — and in
    // that case the run would delete its own only surviving evidence. The condition is
    // cheap and it is checked against the ACTUAL paths, not against the assumption
    // that they are elsewhere.
    var __keepUnzipped = false;
    try { __keepUnzipped = !!(process && process.env && process.env.IMPORT_KEEP_UNZIPPED); } catch (eKE) {}
    var __outputSkipped = !!(report.output && report.output.skipped);
    var __holdsEvidence = false;
    try {
        var __folderPfx = String(__zipExtractedFolderToCleanup || "");
        if (__folderPfx) {
            __holdsEvidence = (String(reportJsonPath || "").indexOf(__folderPfx) === 0)
                || (String(progressLogPath || "").indexOf(__folderPfx) === 0);
        }
    } catch (eHE) { __holdsEvidence = true; }   // unreadable → keep, never delete on a guess
    if (__holdsEvidence) {
        plog("cleanup: SKIPPED — the folder holds this run's log and/or report "
            + "(no document directory to put them in); deleting it would remove the only evidence");
    }
    if (__zipExtractedFolderToCleanup && !__keepUnzipped && !__outputSkipped && !__holdsEvidence) {
        plog("cleanup: 删除 zip 解压文件夹 " + __zipExtractedFolderToCleanup);
        try {
            var cleanupRes = await FileUtils.deleteFolderRecursiveAsync(__zipExtractedFolderToCleanup, plog);
            if (cleanupRes.ok) {
                plog("cleanup: OK (" + cleanupRes.removed + " entries removed)");
            } else {
                plog("cleanup: 失败 (" + cleanupRes.error + ") — 文件夹保留");
            }
        } catch (eCU) {
            plog("cleanup: 抛错 " + (eCU && eCU.message || eCU));
        }
    } else if (__keepUnzipped) {
        plog("cleanup: skipped (IMPORT_KEEP_UNZIPPED=1)");
    } else if (__outputSkipped && __zipExtractedFolderToCleanup) {
        plog("cleanup: skipped — output blocked/skipped, unzipped folder + writeback report kept for debug: " + __zipExtractedFolderToCleanup);
    }

    var summary = "Import v2 stage: " + report.pipeline_stage + "\n";
    if (report.style_plan) {
        summary += "Para styles: " + report.style_plan.para_styles_count
                + " | Latin pool: " + report.style_plan.latin_pool_size + "\n";
    }
    if (report.locate) {
        summary += "Located: " + report.locate.located + "/" + report.locate.total + "\n";
    }
    if (report.preflight) {
        summary += "Preflight: " + report.preflight.blocking_count + " blocking, "
                + report.preflight.warning_count + " warning\n";
    }
    if (report.preclean) {
        summary += "Preclean: " + (report.preclean.soft_break_split || 0) + "/"
                + (report.preclean.soft_break_found || 0) + " soft breaks split"
                + ((report.preclean.soft_break_reverted || 0) > 0
                    ? " (reverted " + report.preclean.soft_break_reverted + " due to overflow)"
                    : "")
                + "\n";
    }
    if (report.apply) {
        summary += "Applied: " + report.apply.cluster_styles_applied + " styles, "
                + report.apply.target_text_written + " texts, "
                + report.apply.annotations_applied + " annotations\n";
        if (report.apply.untranslated_restyled) {
            summary += "  (incl. " + report.apply.untranslated_restyled
                    + " untranslated paragraphs restyled, "
                    + (report.apply.untranslated_emphasis_applied || 0)
                    + " emphasis runs re-applied)\n";
        }
    }
    if (report.repair) {
        summary += "Repair: " + report.repair.status_line + "\n";
    }
    if (report.postflight) {
        summary += "Postflight: " + report.postflight.blocking_count + " blocking, "
                + report.postflight.warning_count + " warning\n";
    }
    if (report.output) {
        if (report.output.skipped) {
            summary += "Output: SKIPPED — " + (report.output.reason || "no usable output") + "\n";
            summary += "  (pipeline didn't reach save stage; nothing was written to disk)\n";
        } else {
            summary += "Output: " + (report.output.path || "?") + (report.output.ok ? " OK" : " FAIL") + "\n";
            if (report.opened_translated === true) {
                summary += "  (opened in InDesign)\n";
            } else if (report.opened_translated === false) {
                summary += "  (auto-open failed — open the file manually)\n";
            }
        }
    }
    // 8D-ext-GI: inline style-preset apply result (applied / skipped / error).
    // The apply is an INDEPENDENT undo step (its own ENTIRE_SCRIPT doScript) —
    // one Ctrl+Z reverts the preset geometry without touching the import.
    if (report.g_apply) {
        if (report.g_apply.error) {
            summary += "Style preset: APPLY FAILED (non-fatal) — " + report.g_apply.error + "\n";
        } else if (report.g_apply.skipped) {
            summary += "Style preset: skipped — " + (report.g_apply.reason || "not applicable") + "\n";
        } else if (report.g_apply.ok === false) {
            // runner in-band failure (preset unreadable / validatePreset failed):
            // returns ok:false BEFORE the doScript — nothing applied, no undo step.
            summary += "Style preset: APPLY FAILED (non-fatal) — "
                + (report.g_apply.reason || "preset load/validate failed") + "\n";
        } else {
            summary += "Style preset: applied " + (report.g_apply.applied_preset_entries || 0)
                + "/" + (report.g_apply.total_preset_entries || 0) + " entries"
                + " (reuse " + (report.g_apply.reuse_rate_pct || 0) + "%)\n";
            summary += "  (separate undo step — Ctrl+Z reverts the preset only)\n";
        }
    }
    summary += "Errors: " + report.errors.length + "\n";
    summary += "Report: " + reportJsonPath + "\n";
    summary += "Log: " + progressLogPath;
    var __importElapsedMs = Date.now() - __importStartMs;
    var __importElapsedSec = (__importElapsedMs / 1000).toFixed(2);
    report.elapsed_ms = __importElapsedMs;
    report.elapsed_sec = Number(__importElapsedSec);
    summary += "\nElapsed: " + __importElapsedSec + "s";
    plog("=== import_translations_v2 complete in " + __importElapsedSec + "s ===");
    // #26: route trailing summary to result file when headless;
    // see reorganize_styles_inplace.idjs for the same pattern.
    if (AutomationBridge.isAutomatedRun("import_integrated")) {
        plog("automation: suppressing summary dialog (headless run); writing __auto_result file");
        try {
            await AutomationBridge.recordAutomationResult("import_integrated", {
                ok: report.errors.length === 0,
                summary: summary,
                report: report,
                reportJsonPath: reportJsonPath,
                progressLogPath: progressLogPath
            });
        } catch (eAR) {
            plog("automation: recordAutomationResult failed: " + (eAR && eAR.message ? eAR.message : eAR));
        }
    } else {
        // ── #62 C-4 — result panel (owner's shape, 2026-08-22) ──────────────
        //
        // The panel appears ONLY when something needs the operator's attention,
        // and when it does it says ONE sentence and hands over the log path.
        // The five readings (Located / Preflight / Applied / Repair /
        // Postflight) are deliberately NOT shown: a clean run must be silent,
        // and a problem run must not bury the one actionable fact — where to
        // look — under numbers the operator cannot act on in a modal.
        //
        // 🔴 The readings are not lost, they moved: `locate` (with the tid of
        // every paragraph that could not be located), the classify breakdown,
        // and the blocking-gate override now all print into the log (#62 C-1..3).
        // The log is the single place to look, so the panel's whole job is to
        // point at it.
        //
        // Path only — owner ruled: do NOT copy the log into the zip, do NOT
        // drop it beside the zip, do NOT leave an unzipped folder behind.
        //
        // The full summary still goes to the log (below) and to the automation
        // result, so nothing that used to be visible has been discarded.
        plog("summary (panel shows only a pointer to this log):\n" + summary);
        if (importRunHadProblem(report)) {
            var __why = [];
            if (report.errors && report.errors.length > 0) __why.push(report.errors.length + " error(s)");
            if (report.locate && Number(report.locate.miss) > 0) {
                __why.push(report.locate.miss + " paragraph(s) could not be located and were left unchanged");
            }
            if (report.preflight_blocking_overridden) __why.push("a blocking preflight gate was bypassed");
            showAlert("Import finished with issues (" + __why.join("; ") + ").\n"
                + "Full details — including every affected paragraph — are in the log:\n"
                + progressLogPath);
        } else {
            plog("result panel: not shown (clean run — no errors, no locate misses,"
                + " no bypassed blocking gate).");
        }
    }
}

// ─── UXP dialog helper ───────────────────────────────────────────

// #62 C-4: the predicate lives in lib/hard_errors.js — that module already
// owns "what counts as blocking", and putting it there makes the rule
// testable (tests/hard_errors_tests.js). A visibility gate nobody can test
// is how the previous one stopped working.
function importRunHadProblem(report) {
    return HardErrors.runHadOperatorVisibleProblem(report);
}

function showAlert(msg) {
    // #26: route every alert to plog when headless (DOM dialogs block bridge).
    if (AutomationBridge.isAutomatedRun("import_integrated")) {
        try { plog("alert (suppressed in automation): " + String(msg).replace(/\r?\n|\r/g, " | ")); } catch (eP) {}
        return;
    }
    try {
        var dlg = app.dialogs.add({ name: "Import v2", canCancel: false });
        var col = dlg.dialogColumns.add();
        var parts = String(msg).split(/\r?\n|\r/);
        for (var i = 0; i < parts.length; i++) {
            col.staticTexts.add({ staticLabel: parts[i] });
        }
        dlg.show();
        dlg.destroy();
    } catch (e) {}
}

// ─── 8D-ext-D step-3b dialogs ─────────────────────────────────────
// HTML <dialog> idiom per lib/export_dialog.js (gate-4: plain px values,
// explicit colors, no CSS min()/calc()/var()). showModal + promise resolve;
// dlg.remove() after close.

function __bpEscHtml(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
        .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

var __BP_DIALOG_STYLES = [
    'dialog.bp-dlg {',
    '  padding: 0; border: 1px solid #494949;',
    '  max-width: none; max-height: none;',  // neutralise the :modal cap; the fixed-size .bp-shell child carries the real size
    '  background: #1f1f1f; color: #e6e6e6; color-scheme: dark;',
    '}',
    // Fixed-size child carries the real px size so the OS window locks to it +
    // contents stay INSIDE the box (proven font_mapping pattern; see export_dialog).
    '.bp-shell {',
    '  width: 560px; height: 640px;',
    '  max-width: none !important; max-height: none !important;',
    '  box-sizing: border-box; overflow-y: auto; background: #1f1f1f;',
    '}',
    '.bp-body { font-family: "Adobe Clean", sans-serif; padding: 18px 22px; background: #1f1f1f; color: #e6e6e6; }',
    '.bp-body h2 { margin: 0 0 12px 0; font-size: 15px; font-weight: 600; color: #f0f0f0; }',
    '.bp-body p { margin: 4px 0 10px 0; font-size: 12px; color: #9b9b9b; }',
    '.bp-body p.bp-hint-warn { color: #f5a142; }',
    '.bp-body label { font-size: 12px; color: #e6e6e6; }',
    '.bp-body .field-row { margin: 10px 0; }',
    '.bp-body .field-row label { display: block; margin-bottom: 4px; }',
    '.bp-body .field-row select, .bp-body .field-row input[type="text"] {',
    '  width: 100%; padding: 5px 8px; font-size: 12px;',
    '  background: #2a2a2a; color: #e6e6e6;',
    '  border: 1px solid #5a5a5a; border-radius: 2px;',
    '}',
    '.bp-body .bp-cols { display: flex; gap: 10px; }',
    '.bp-body .bp-cols > div { flex: 1; }',
    '.bp-body .opt-row { margin: 4px 0; font-size: 12px; }',
    '.bp-body .opt-row input { margin-right: 6px; accent-color: #2680eb; }',
    '.bp-body .bp-pairs-box {',
    '  margin-top: 4px; padding: 6px 8px; max-height: 160px; overflow-y: auto;',
    '  background: #262626; border: 1px solid #444444; border-radius: 2px;',
    '}',
    '.bp-body .bp-pairs-box p { margin: 2px 0; font-size: 11px; color: #8a8a8a; }',
    '.bp-body button {',
    '  background: #393939; color: #e6e6e6; border: 1px solid #5a5a5a;',
    '  border-radius: 3px; padding: 5px 16px; font-size: 12px; cursor: pointer;',
    '}',
    '.bp-body .footer { margin-top: 18px; display: flex; justify-content: flex-end; gap: 8px; }',
    '.bp-body .footer button.primary { background: #2680eb; border-color: #2680eb; color: #fff; }',
    '.bp-body .warn-list { margin: 8px 0; padding: 8px 10px; background: #3d2a1a; border: 1px solid #b86d2a; border-radius: 3px; }',
    '.bp-body .warn-list div { font-size: 12px; color: #f0d0a0; margin: 2px 0; }'
].join("\n");

// A3a': fold the import dialog's project-metadata edits (project name / workflow
// / deadline / source+target lang / designer) back into the carried _meta so they
// persist on the doc label (stored at save) → the export reads them forward.
function __mergeImportDialogMeta(meta, dlgChoice) {
    if (!dlgChoice || typeof dlgChoice !== "object") return meta;
    if (!meta || typeof meta !== "object") meta = {};
    if (dlgChoice.project_name) meta.project_name = dlgChoice.project_name;
    if (dlgChoice.workflow_mode) meta.workflow_mode = dlgChoice.workflow_mode;
    if (typeof dlgChoice.deadline === "string") meta.deadline = dlgChoice.deadline || null;
    if (dlgChoice.sourceLanguage) meta.source_language = dlgChoice.sourceLanguage;
    if (dlgChoice.targetLanguage) meta.target_language = dlgChoice.targetLanguage;
    if (dlgChoice.designer) {
        if (!meta.contributors || typeof meta.contributors !== "object") meta.contributors = {};
        meta.contributors.designer = dlgChoice.designer;
    }
    if (typeof meta.schema_version !== "number") meta.schema_version = 1;
    return meta;
}

function __bpPairLabel(p) {
    return p.srcFont + "/" + p.srcWeight + " → " + p.dstFont + "/" + p.dstWeight
        + " (" + p.srcLang + "→" + p.dstLang + ")";
}

// 8D-ext-MM byPair-preview cosmetic: label for ONE grouped (pairingId, dstLang)
// row. Joins the N source weights that fan into the single dst, e.g.
// "Whitney Book, Whitney Medium → MHei Medium (en→zh-CN)". Non-MM 1:1 groups
// have one srcWeight → reads like the old per-pair label. `g` is a
// FontMappingPairs.groupByPairKey() entry.
function __bpGroupLabel(g) {
    var srcLang = (g.srcWeights && g.srcWeights[0]) ? g.srcWeights[0].srcLang : "";
    var srcParts = [];
    for (var i = 0; i < (g.srcWeights ? g.srcWeights.length : 0); i++) {
        var s = g.srcWeights[i];
        srcParts.push(s.srcFont + " " + s.srcWeight);
    }
    return srcParts.join(", ") + " → " + g.dstFont + " " + g.dstWeight
        + " (" + srcLang + "→" + g.dstLang + ")";
}

// Importer M4/M5 mode + langs + runEnforcer + per-pair skip dialog.
// opts: { defaultMode, hint, srcLang, tgtLang, brandConfig }
// Returns { mode, sourceLanguage, targetLanguage, runEnforcer, skipDecisions }
// or null on cancel.
// ── import_integrated: inline font-mapping UI (no-config branch) ──
// When no brand_config was picked OR discovered, let the user map the source
// doc's used fonts → installed target fonts here, producing a brand_config the
// byPair projection consumes. A LEAN HTML dialog (NOT the full font_apply_panel
// React app — that re-host is a later stage); enough to create the source→target
// pairs this import needs. Returns a brand_config-shaped object, or null (skip).
async function __showFontMappingUI(opts) {
    if (typeof document === "undefined") return null;
    opts = opts || {};
    var srcLang = opts.srcLang || "";
    var tgtLang = opts.tgtLang || "";
    var idApp = require("indesign").app;
    // distinct used fonts in the source doc (family + style)
    var usedFonts = [];
    try {
        var df = opts.sourceDoc.fonts;
        var seen = {};
        for (var i = 0; i < df.length; i++) {
            var f = df.item(i);
            var fam = ""; try { fam = String(f.fontFamily || ""); } catch (e1) {}
            var sty = "Regular"; try { sty = String(f.fontStyleName || "Regular"); } catch (e2) {}
            var k = fam + "\t" + sty;
            if (fam && !seen[k]) { seen[k] = true; usedFonts.push({ family: fam, style: sty }); }
        }
    } catch (eUF) {}
    if (!usedFonts.length) return null;
    // installed families (target dropdown options)
    var installed = [];
    try {
        var af = idApp.fonts;
        var sf = {};
        for (var j = 0; j < af.length; j++) {
            var fm = ""; try { fm = String(af.item(j).fontFamily || ""); } catch (e3) {}
            if (fm && !sf[fm]) { sf[fm] = true; installed.push(fm); }
        }
        installed.sort();
    } catch (eIF) {}
    function __fmOptsFor(sel) {
        var h = "";
        for (var i = 0; i < installed.length; i++) {
            h += '<option value="' + __bpEscHtml(installed[i]) + '"' + (installed[i] === sel ? " selected" : "") + ">" + __bpEscHtml(installed[i]) + "</option>";
        }
        return h;
    }
    var rows = "";
    for (var r = 0; r < usedFonts.length; r++) {
        var uf = usedFonts[r];
        rows += '<div class="field-row">'
            + '<label for="fm-tgt-' + r + '" style="min-width:260px">' + __bpEscHtml(uf.family + " " + uf.style) + " &rarr;</label>"
            + '<select id="fm-tgt-' + r + '" data-srcfam="' + __bpEscHtml(uf.family) + '" data-srcsty="' + __bpEscHtml(uf.style) + '">'
            + __fmOptsFor(uf.family) + "</select>"
            + "</div>";
    }
    var dlg = document.createElement("dialog");
    dlg.className = "bp-dlg";
    dlg.innerHTML = "<style>" + __BP_DIALOG_STYLES + "</style>"
        + '<div class="bp-body">'
        + "  <h2>Font Mapping (" + __bpEscHtml(srcLang || "?") + " &rarr; " + __bpEscHtml(tgtLang || "?") + ")</h2>"
        + "  <p>No brand_config selected — map this document's fonts to target fonts. Leave a row unchanged to keep its font.</p>"
        + rows
        + '  <div class="footer">'
        + '    <button id="fm-skip-btn" type="button">Skip (no mapping)</button>'
        + '    <button id="fm-ok-btn" type="button" class="primary">OK</button>'
        + "  </div>"
        + "</div>";
    document.body.appendChild(dlg);
    var resolveOuter;
    var resultPromise = new Promise(function (res) { resolveOuter = res; });
    dlg.querySelector("#fm-ok-btn").addEventListener("click", function () {
        var pairs = [];
        var sels = dlg.querySelectorAll('select[id^="fm-tgt-"]');
        for (var i = 0; i < sels.length; i++) {
            var srcFam = sels[i].getAttribute("data-srcfam");
            var srcSty = sels[i].getAttribute("data-srcsty");
            var tgtFam = sels[i].value;
            if (tgtFam && tgtFam !== srcFam) {
                pairs.push({ members: [
                    { lang: srcLang, font: srcFam, weight: srcSty },
                    { lang: tgtLang, font: tgtFam, weight: srcSty }
                ] });
            }
        }
        var config = pairs.length ? { brand_name: "inline-font-map", langScriptTable: {}, fonts_by_language: {}, pairs: pairs } : null;
        try { dlg.close("ok"); } catch (e) {}
        resolveOuter(config);
    });
    dlg.querySelector("#fm-skip-btn").addEventListener("click", function () {
        try { dlg.close("skip"); } catch (e) {}
        resolveOuter(null);
    });
    try {
        var sm = dlg.showModal();
        if (sm && typeof sm.then === "function") sm.catch(function () { resolveOuter(null); });
    } catch (eShow) { resolveOuter(null); }
    var out = await resultPromise;
    try { dlg.remove(); } catch (e) {}
    return out;
}

async function __showByPairImportDialog(opts) {
    if (typeof document === "undefined") return null;
    opts = opts || {};
    var hasBrand = !!(opts.brandConfig && Array.isArray(opts.brandConfig.pairs)
        && opts.brandConfig.pairs.length);

    // Source/Target language are <select> dropdowns (not free-text) — populate
    // from the brand_config's known langs (pairs' member langs + langScriptTable
    // keys) unioned with a standard set, so the user PICKS instead of typing
    // (typed/empty langs were the common cause of projected=0 → no font swap).
    var __bpLangSet = { "en": 1, "fr": 1, "es": 1, "de": 1, "zh-CN": 1, "zh-TW": 1, "zh-HK": 1, "ja": 1, "ko": 1, "th": 1, "ar": 1 };
    if (opts.brandConfig) {
        var __bcp = opts.brandConfig.pairs;
        if (Array.isArray(__bcp)) {
            for (var __pi = 0; __pi < __bcp.length; __pi++) {
                var __mem = __bcp[__pi] && __bcp[__pi].members;
                if (Array.isArray(__mem)) {
                    for (var __mi = 0; __mi < __mem.length; __mi++) {
                        if (__mem[__mi] && __mem[__mi].lang) __bpLangSet[__mem[__mi].lang] = 1;
                    }
                }
            }
        }
        var __lst = opts.brandConfig.langScriptTable;
        if (__lst) { for (var __lk in __lst) { if (Object.prototype.hasOwnProperty.call(__lst, __lk)) __bpLangSet[__lk] = 1; } }
    }
    var __bpLangs = [];
    for (var __lg in __bpLangSet) { if (Object.prototype.hasOwnProperty.call(__bpLangSet, __lg)) __bpLangs.push(__lg); }
    __bpLangs.sort();
    function __bpLangOptions(selected) {
        var h = '<option value="">— select —</option>';
        for (var i = 0; i < __bpLangs.length; i++) {
            h += '<option value="' + __bpEscHtml(__bpLangs[i]) + '"'
                + (__bpLangs[i] === selected ? ' selected' : '') + '>'
                + __bpEscHtml(__bpLangs[i]) + '</option>';
        }
        return h;
    }

    // Strictness ladder radios — reuse reorganize_dialog_v2's STRICTNESS_LADDER
    // (+ buildPayloadFromLadder downstream) for the style-reorganize half of
    // this UNIFIED settings dialog (import_integrated merges the reorganize
    // panel + the font-mapping panel into one screen).
    var __ladder = (ReorganizeDialog && ReorganizeDialog.STRICTNESS_LADDER) || [];
    var __ladderDefault = (ReorganizeDialog && typeof ReorganizeDialog.STRICTNESS_DEFAULT_INDEX === "number") ? ReorganizeDialog.STRICTNESS_DEFAULT_INDEX : 0;
    var __strictRadios = "";
    for (var __li = 0; __li < __ladder.length; __li++) {
        var __le = __ladder[__li] || {};
        __strictRadios += '<div class="opt-row">'
            + '<input type="radio" name="bp-strict" id="bp-strict-' + __li + '" value="' + __li + '"' + (__li === __ladderDefault ? ' checked' : '') + '>'
            + '<label for="bp-strict-' + __li + '"><b>' + __bpEscHtml(__le.title || ("Level " + __li)) + '</b> — ' + __bpEscHtml(__le.sub || "") + '</label>'
            + '</div>';
    }

    var dlg = document.createElement("dialog");
    dlg.className = "bp-dlg";
    dlg.innerHTML = '<style>' + __BP_DIALOG_STYLES + '</style>'
        + '<div class="bp-shell">'
        + '<div class="bp-body">'
        + '  <h2>Import Settings — Reorganize &amp; Font Mapping</h2>'
        + (opts.hint ? '<p class="bp-hint-warn">' + __bpEscHtml(opts.hint) + '</p>' : '')
        + '  <h3>Config files</h3>'
        + '  <div class="field-row">'
        + '    <label>Font config:</label>'
        + '    <span id="bp-bc-path" style="flex:1;opacity:.75;font-size:12px">none — font-mapping panel opens if blank</span>'
        + '    <button id="bp-bc-browse" type="button">Browse…</button>'
        + '  </div>'
        + '  <div class="field-row">'
        + '    <label>Style config:</label>'
        + '    <span id="bp-ps-path" style="flex:1;opacity:.75;font-size:12px">none</span>'
        + '    <button id="bp-ps-browse" type="button">Browse…</button>'
        + '  </div>'
        + '  <h3>Style reorganize</h3>'
        + '  <div class="field-row"><label>Merge strictness:</label></div>'
        + __strictRadios
        + '  <div class="opt-row"><input type="checkbox" id="bp-edit-mode"><label for="bp-edit-mode">Edit mode (skip winner overrides)</label></div>'
        + '  <div class="opt-row"><input type="checkbox" id="bp-force-full"><label for="bp-force-full">Force full pipeline (ignore import-state label)</label></div>'
        + '  <h3>Font mapping</h3>'
        // 8D-ext-UNIFY-core piece 2 (minimal MD): the M4/M5 dropdown + CJK
        // auto-switch hint are DELETED — mode is the DERIVED default (now brand-
        // CJK-aware via the F4 lattice); the dialog no longer inputs it.
        + '  <div class="field-row bp-cols">'
        + '    <div>'
        + '      <label for="bp-src-lang">Source language:</label>'
        + '      <select id="bp-src-lang">' + __bpLangOptions(opts.srcLang || "") + '</select>'
        + '    </div>'
        + '    <div>'
        + '      <label for="bp-tgt-lang">Target language:</label>'
        + '      <select id="bp-tgt-lang">' + __bpLangOptions(opts.tgtLang || "") + '</select>'
        + '    </div>'
        + '  </div>'
        + '  <div class="opt-row">'
        + '    <input type="checkbox" id="bp-run-enforcer" checked>'
        + '    <label for="bp-run-enforcer">Run script-font enforcer (fix designer-CS CJK/Latin fonts)</label>'
        + '  </div>'
        // Font-pairs skip list — only meaningful when pairs are already known
        // (brand_config resolved). The unified dialog runs BEFORE config resolves
        // (deferPairs), where it was just an info line → hide it there entirely;
        // the skip UI still renders on the non-deferred (fallback) path.
        + (opts.deferPairs ? '' : ('  <div class="field-row">'
            + '    <label>Font pairs (check to SKIP):</label>'
            + '    <div class="bp-pairs-box" id="bp-pairs"></div>'
            + '  </div>'))
        + '  <h3>Project metadata</h3>'
        + '  <div class="field-row">'
        + '    <label for="bp-project-name">Project name:</label>'
        + '    <input type="text" id="bp-project-name" maxlength="200" value="' + __bpEscHtml(opts.projectName || "") + '" placeholder="Project name">'
        + '  </div>'
        + '  <div class="field-row bp-cols">'
        + '    <div>'
        + '      <label for="bp-workflow">Workflow:</label>'
        + '      <select id="bp-workflow">'
        + '        <option value="translation"' + ((opts.workflow || "translation") === "translation" ? " selected" : "") + '>translation</option>'
        + '        <option value="edit-only"' + (opts.workflow === "edit-only" ? " selected" : "") + '>edit-only</option>'
        + '        <option value="bilingual"' + (opts.workflow === "bilingual" ? " selected" : "") + '>bilingual</option>'
        + '      </select>'
        + '    </div>'
        + '    <div>'
        + '      <label for="bp-deadline">Deadline:</label>'
        + '      <input type="text" id="bp-deadline" maxlength="30" value="' + __bpEscHtml(opts.deadline || "") + '" placeholder="YYYY-MM-DD">'
        + '    </div>'
        + '    <div>'
        + '      <label for="bp-designer">Designer:</label>'
        + '      <input type="text" id="bp-designer" maxlength="200" value="' + __bpEscHtml(opts.designer || "") + '" placeholder="Your name">'
        + '    </div>'
        + '  </div>'
        + '  <div class="footer">'
        + '    <button id="bp-cancel-btn" type="button">Cancel</button>'
        + '    <button id="bp-ok-btn" type="button" class="primary">OK</button>'
        + '  </div>'
        + '</div>'   // .bp-body
        + '</div>';  // .bp-shell
    document.body.appendChild(dlg);

    // F1/piece 2: no mode selector — mode comes from the derivation.
    var srcInput = dlg.querySelector("#bp-src-lang");
    var tgtInput = dlg.querySelector("#bp-tgt-lang");
    var pmNameInput = dlg.querySelector("#bp-project-name");
    var pmWorkflowInput = dlg.querySelector("#bp-workflow");
    var pmDeadlineInput = dlg.querySelector("#bp-deadline");
    var pmDesignerInput = dlg.querySelector("#bp-designer");
    var enfCheck = dlg.querySelector("#bp-run-enforcer");
    var pairsBox = dlg.querySelector("#bp-pairs");
    var editModeCheck = dlg.querySelector("#bp-edit-mode");
    var forceFullCheck = dlg.querySelector("#bp-force-full");
    // ── config-file Browse (in-panel selection — no alert prompts) ──
    var bcPathEl = dlg.querySelector("#bp-bc-path");
    var psPathEl = dlg.querySelector("#bp-ps-path");
    var __bcPath = opts.brandConfigPath || "";
    var __psPath = opts.presetPath || "";
    function __baseName(p) { return p ? String(p).replace(/^.*[\\/]/, "") : ""; }
    function __renderCfgPaths() {
        if (bcPathEl) bcPathEl.textContent = __bcPath ? __baseName(__bcPath) : "none — font-mapping panel opens if blank";
        if (psPathEl) psPathEl.textContent = __psPath ? __baseName(__psPath) : "none";
    }
    __renderCfgPaths();
    var __bcBrowse = dlg.querySelector("#bp-bc-browse");
    if (__bcBrowse) __bcBrowse.addEventListener("click", async function () {
        try { var f = await lfs.getFileForOpening({ types: ["json"] }); if (f) { __bcPath = f.nativePath; __renderCfgPaths(); } } catch (eBc) {}
    });
    var __psBrowse = dlg.querySelector("#bp-ps-browse");
    if (__psBrowse) __psBrowse.addEventListener("click", async function () {
        try { var f = await lfs.getFileForOpening({ types: ["json"] }); if (f) { __psPath = f.nativePath; __renderCfgPaths(); } } catch (ePs) {}
    });
    function __readLadderIdx() {
        var sel = dlg.querySelector('input[name="bp-strict"]:checked');
        if (!sel) return __ladderDefault;
        var v = parseInt(sel.value, 10);
        return isNaN(v) ? __ladderDefault : v;
    }

    function renderPairs() {
        if (!pairsBox) return;   // Font-pairs section hidden on the deferred (unified) path
        var src = (srcInput.value || "").replace(/^\s+|\s+$/g, "");
        var tgt = (tgtInput.value || "").replace(/^\s+|\s+$/g, "");
        if (opts.deferPairs) {
            // Unified dialog shown BEFORE brand_config is resolved (the config
            // file is picked / auto-discovered after the source doc resolves):
            // pairs can't be projected yet, so they apply automatically later.
            pairsBox.innerHTML = '<p>Font pairs apply automatically during import (from the picked / auto-discovered brand_config). Pick the config when prompted after this dialog.</p>';
            return;
        }
        if (!hasBrand) {
            pairsBox.innerHTML = '<p>No brand_config found — font mapping disabled for this import.</p>';
            return;
        }
        if (!src || !tgt) {
            pairsBox.innerHTML = '<p>Enter BOTH source and target language to project font pairs.</p>';
            return;
        }
        var projected = FontMappingPairs.projectByPairWithIndex(opts.brandConfig.pairs, src, tgt, opts.brandConfig);
        if (!projected.length) {
            pairsBox.innerHTML = '<p>No pairs project for ' + __bpEscHtml(src) + ' → ' + __bpEscHtml(tgt) + '.</p>';
            return;
        }
        // byPair-preview cosmetic (8D-ext-MM): render ONE checkbox per
        // (pairingId, dstLang) GROUP, not per fan-out row. The skip key the OK
        // handler emits stays `pairingId|dstLang` (group-level — same contract),
        // so one checkbox honestly skips all N source weights that map to the
        // one dst. Non-MM 1:1 pairings → one group, one weight (unchanged look).
        var groups = FontMappingPairs.groupByPairKey(projected);
        var html = "";
        for (var i = 0; i < groups.length; i++) {
            var g = groups[i];
            html += '<div class="opt-row">'
                + '<input type="checkbox" class="bp-skip" id="bp-skip-' + i + '"'
                + ' data-pid="' + __bpEscHtml(g.pairingId) + '"'
                + ' data-dstlang="' + __bpEscHtml(g.dstLang) + '">'
                + '<label for="bp-skip-' + i + '">' + __bpEscHtml(__bpGroupLabel(g)) + '</label>'
                + '</div>';
        }
        pairsBox.innerHTML = html;
    }
    // 8D-ext-UNIFY-core piece 2: the CJK→M5 auto-switch is DELETED. Its job
    // (CJK routing) now lives in the derivation (resolveImporterModeDefault F4
    // lattice), brand-config-aware: CJK + resolvable brand → M4 (rebuild lands
    // brand CJK); CJK + no brand → M5. The old auto-switch was brand-blind
    // (forced M5 on every CJK target → made piece-1 injection inert).
    srcInput.addEventListener("change", renderPairs);
    tgtInput.addEventListener("change", function () { renderPairs(); });
    renderPairs();

    var resolveOuter;
    var resultPromise = new Promise(function (r) { resolveOuter = r; });

    dlg.querySelector("#bp-ok-btn").addEventListener("click", function () {
        var skipDecisions = {};
        var boxes = dlg.querySelectorAll(".bp-skip");
        for (var i = 0; i < boxes.length; i++) {
            if (boxes[i].checked) {
                skipDecisions[ByPairWiring.buildSkipKey(
                    boxes[i].getAttribute("data-pid"),
                    boxes[i].getAttribute("data-dstlang"))] = "skip";
            }
        }
        var result = {
            // piece 2: mode is no longer read for routing (derivation is
            // authoritative); kept cosmetically as the derived default passthrough.
            mode: (opts.defaultMode === "M5") ? "M5" : "M4",
            sourceLanguage: (srcInput.value || "").replace(/^\s+|\s+$/g, ""),
            targetLanguage: (tgtInput.value || "").replace(/^\s+|\s+$/g, ""),
            project_name: pmNameInput ? (pmNameInput.value || "").replace(/^\s+|\s+$/g, "") : "",
            workflow_mode: pmWorkflowInput ? (pmWorkflowInput.value || "translation") : "translation",
            deadline: pmDeadlineInput ? (pmDeadlineInput.value || "").replace(/^\s+|\s+$/g, "") : "",
            designer: pmDesignerInput ? (pmDesignerInput.value || "").replace(/^\s+|\s+$/g, "") : "",
            runEnforcer: !!enfCheck.checked,
            skipDecisions: skipDecisions,
            // unified-dialog: style-reorganize half (consumed via
            // ReorganizeDialog.buildPayloadFromLadder at the call site)
            ladderIdx: __readLadderIdx(),
            editMode: !!(editModeCheck && editModeCheck.checked),
            forceFullImport: !!(forceFullCheck && forceFullCheck.checked),
            // config files selected via the in-panel Browse buttons
            brandConfigPath: __bcPath || "",
            presetPath: __psPath || ""
        };
        try { dlg.close("ok"); } catch (e) {}
        resolveOuter(result);
    });
    dlg.querySelector("#bp-cancel-btn").addEventListener("click", function () {
        try { dlg.close("cancel"); } catch (e) {}
        resolveOuter(null);
    });

    try {
        var sm = dlg.showModal();
        if (sm && typeof sm.then === "function") {
            sm.catch(function () { resolveOuter(null); });
        }
    } catch (eShow) {
        resolveOuter(null);
    }

    var out = await resultPromise;
    try { dlg.remove(); } catch (e) {}
    return out;
}

// M4 CJK hazard modal — Continue / Cancel. Returns true when the operator
// explicitly accepts that the listed CJK byPair entries will NOT apply.
async function __showM4CJKHazardDialog(hazards) {
    if (typeof document === "undefined") return false;
    var dlg = document.createElement("dialog");
    dlg.className = "bp-dlg";
    var listHtml = "";
    for (var i = 0; i < hazards.length; i++) {
        listHtml += '<div>' + __bpEscHtml(__bpPairLabel(hazards[i])) + '</div>';
    }
    dlg.innerHTML = '<style>' + __BP_DIALOG_STYLES + '</style>'
        + '<div class="bp-body">'
        + '  <h2>M4 CJK Font-Pair Warning</h2>'
        + '  <p>M4 rebuilds CJK cluster fonts (force-SHS); these CJK byPair entries will NOT apply:</p>'
        + '  <div class="warn-list">' + listHtml + '</div>'
        + '  <p>Use M5 if you need char-level CJK font swaps.</p>'
        + '  <div class="footer">'
        + '    <button id="bp-hz-cancel-btn" type="button">Cancel import</button>'
        + '    <button id="bp-hz-continue-btn" type="button" class="primary">Continue</button>'
        + '  </div>'
        + '</div>';
    document.body.appendChild(dlg);

    var resolveOuter;
    var resultPromise = new Promise(function (r) { resolveOuter = r; });
    dlg.querySelector("#bp-hz-continue-btn").addEventListener("click", function () {
        try { dlg.close("ok"); } catch (e) {}
        resolveOuter(true);
    });
    dlg.querySelector("#bp-hz-cancel-btn").addEventListener("click", function () {
        try { dlg.close("cancel"); } catch (e) {}
        resolveOuter(false);
    });
    try {
        var sm = dlg.showModal();
        if (sm && typeof sm.then === "function") {
            sm.catch(function () { resolveOuter(false); });
        }
    } catch (eShow) {
        resolveOuter(false);
    }
    var out = await resultPromise;
    try { dlg.remove(); } catch (e) {}
    return out;
}

// ── 8D-ext-bypair-tofu-ux: shared tofu-resolution dialog (Hook A + Hook B) ──
// Lists each tofu-risk font (unowned CJK run on a font in no pair) + per-font:
//   add pair (pick a target CJK font/weight) | accept tofu (skip) ; footer:
//   Apply & continue | Accept all as tofu | Cancel.
// 闸门4: ALL clickable = <div role="button">; <select> for the target font (host-
// renderable, proven in the existing dialogs); plain px/colors, no var/calc/min.
// opts: { kind:'early'|'late', unowned:[{sourceFont,sourceWeight,count?}],
//         cjkFonts:[{font,weight}] (fonts_by_language[tgt] or fallback roster),
//         srcLang, tgtLang }
// Returns { cancel:bool, addPairs:[{srcFont,srcWeight,dstFont,dstWeight}],
//           skips:[{srcFont,srcWeight}] }. Headless → null (caller skips).
async function __showTofuResolutionDialog(opts) {
    if (typeof document === "undefined") return null;
    if (AutomationBridge.isAutomatedRun("import_integrated")) return null;
    opts = opts || {};
    var unowned = Array.isArray(opts.unowned) ? opts.unowned : [];
    if (!unowned.length) return { cancel: false, addPairs: [], skips: [] };
    var cjkFonts = Array.isArray(opts.cjkFonts) ? opts.cjkFonts : [];
    var hasRoster = cjkFonts.length > 0;
    var srcLang = opts.srcLang || "en";
    var tgtLang = opts.tgtLang || "zh-CN";

    function __optsHtml(srcWeight) {
        var def = ByPairWiring.nearestCjkWeightDefault(srcWeight, cjkFonts, DocScan.styleAlias);
        var h = "";
        for (var i = 0; i < cjkFonts.length; i++) {
            var f = cjkFonts[i];
            var val = f.font + "\t" + f.weight;
            var sel = (def && f.font === def.font && f.weight === def.weight) ? " selected" : "";
            h += '<option value="' + __bpEscHtml(val) + '"' + sel + '>'
                + __bpEscHtml(f.font + " " + f.weight) + '</option>';
        }
        return h;
    }
    var rowsHtml = "";
    for (var r = 0; r < unowned.length; r++) {
        var u = unowned[r];
        var used = (typeof u.count === "number" && u.count > 0) ? (" — used by " + u.count + " run(s)") : "";
        rowsHtml += '<div class="tf-row" data-idx="' + r + '" data-skip="0"'
            + ' data-srcfont="' + __bpEscHtml(u.sourceFont) + '"'
            + ' data-srcweight="' + __bpEscHtml(u.sourceWeight) + '">'
            + '  <div class="tf-name">' + __bpEscHtml(u.sourceFont + " " + u.sourceWeight) + __bpEscHtml(used) + '</div>'
            + (hasRoster
                ? '  <div class="tf-act"><span class="tf-arrow">&rarr;</span>'
                    + '<select class="tf-sel">' + __optsHtml(u.sourceWeight) + '</select>'
                    + '<div class="tf-skip" role="button" tabindex="0">Accept tofu</div></div>'
                : '  <div class="tf-act"><span class="tf-noroster">No target CJK font available — tofu is the only option</span></div>')
            + '</div>';
    }
    var extraCss = [
        '.tf-row { padding: 8px 0; border-bottom: 1px solid #3a3a3a; }',
        '.tf-name { font-size: 12px; color: #e6e6e6; margin-bottom: 5px; }',
        '.tf-act { display: flex; align-items: center; gap: 8px; }',
        '.tf-arrow { color: #9b9b9b; font-size: 12px; }',
        '.tf-act select { flex: 1; padding: 4px 7px; font-size: 12px; background: #2a2a2a; color: #e6e6e6; border: 1px solid #5a5a5a; border-radius: 2px; }',
        '.tf-skip { background: #393939; color: #e6e6e6; border: 1px solid #5a5a5a; border-radius: 3px; padding: 4px 12px; font-size: 12px; cursor: pointer; }',
        '.tf-row[data-skip="1"] .tf-skip { background: #b86d2a; border-color: #b86d2a; color: #fff; }',
        '.tf-row[data-skip="1"] select { opacity: 0.4; }',
        '.tf-noroster { font-size: 12px; color: #f5a142; }',
        '.tf-divbtn { background: #393939; color: #e6e6e6; border: 1px solid #5a5a5a; border-radius: 3px; padding: 6px 16px; font-size: 12px; cursor: pointer; }',
        '.tf-divbtn.primary { background: #2680eb; border-color: #2680eb; color: #fff; }',
        '.tf-footer { margin-top: 16px; display: flex; justify-content: flex-end; gap: 8px; }'
    ].join("\n");

    var dlg = document.createElement("dialog");
    dlg.className = "bp-dlg";
    dlg.innerHTML = '<style>' + __BP_DIALOG_STYLES + "\n" + extraCss + '</style>'
        + '<div class="bp-shell"><div class="bp-body">'
        + '  <h2>Tofu risk (' + __bpEscHtml(srcLang) + ' &rarr; ' + __bpEscHtml(tgtLang) + ')</h2>'
        + '  <p>These fonts carry CJK text but belong to no pairing, so saving will render them as tofu boxes. Give each one a target CJK font, or accept tofu.</p>'
        + '  <div class="tf-list">' + rowsHtml + '</div>'
        + '  <div class="tf-footer">'
        + '    <div id="tf-cancel" class="tf-divbtn" role="button" tabindex="0">Cancel import</div>'
        + '    <div id="tf-acceptall" class="tf-divbtn" role="button" tabindex="0">Accept tofu for all</div>'
        + '    <div id="tf-apply" class="tf-divbtn primary" role="button" tabindex="0">Apply and continue</div>'
        + '  </div>'
        + '</div></div>';
    document.body.appendChild(dlg);

    // per-row "accept tofu" toggle (div-button — host <button> CSS/pointer broken, 闸门4)
    var rowEls = dlg.querySelectorAll(".tf-row");
    for (var ri = 0; ri < rowEls.length; ri++) {
        (function (rowEl) {
            var skipBtn = rowEl.querySelector(".tf-skip");
            if (!skipBtn) return;
            function toggle() {
                rowEl.setAttribute("data-skip", rowEl.getAttribute("data-skip") === "1" ? "0" : "1");
            }
            skipBtn.addEventListener("click", toggle);
            skipBtn.addEventListener("keydown", function (e) {
                if (e && (e.key === "Enter" || e.key === " " || e.key === "Spacebar")) { e.preventDefault(); toggle(); }
            });
        })(rowEls[ri]);
    }

    var resolveOuter;
    var resultPromise = new Promise(function (res) { resolveOuter = res; });
    function collect() {
        var addPairs = [], skips = [];
        var rows = dlg.querySelectorAll(".tf-row");
        for (var i = 0; i < rows.length; i++) {
            var el = rows[i];
            var sf = el.getAttribute("data-srcfont"), sw = el.getAttribute("data-srcweight");
            var sel = el.querySelector(".tf-sel");
            // no roster, or row toggled to accept → skip; else add the selected pair
            if (!sel || el.getAttribute("data-skip") === "1") {
                skips.push({ sourceFont: sf, sourceWeight: sw });
            } else {
                var v = String(sel.value || "").split("\t");
                if (v[0] && v[1]) addPairs.push({ srcFont: sf, srcWeight: sw, dstFont: v[0], dstWeight: v[1] });
                else skips.push({ sourceFont: sf, sourceWeight: sw });   // defensive: bad value → skip
            }
        }
        return { cancel: false, addPairs: addPairs, skips: skips };
    }
    function bindBtn(id, handler) {
        var b = dlg.querySelector(id);
        if (!b) return;
        b.addEventListener("click", handler);
        b.addEventListener("keydown", function (e) {
            if (e && (e.key === "Enter" || e.key === " " || e.key === "Spacebar")) { e.preventDefault(); handler(); }
        });
    }
    bindBtn("#tf-apply", function () { var out = collect(); try { dlg.close("apply"); } catch (e) {} resolveOuter(out); });
    bindBtn("#tf-acceptall", function () {
        var skips = [], rows = dlg.querySelectorAll(".tf-row");
        for (var i = 0; i < rows.length; i++) {
            skips.push({ sourceFont: rows[i].getAttribute("data-srcfont"), sourceWeight: rows[i].getAttribute("data-srcweight") });
        }
        try { dlg.close("acceptall"); } catch (e) {}
        resolveOuter({ cancel: false, addPairs: [], skips: skips });
    });
    bindBtn("#tf-cancel", function () { try { dlg.close("cancel"); } catch (e) {} resolveOuter({ cancel: true, addPairs: [], skips: [] }); });

    try {
        var sm = dlg.showModal();
        if (sm && typeof sm.then === "function") sm.catch(function () { resolveOuter({ cancel: true, addPairs: [], skips: [] }); });
    } catch (eShow) { resolveOuter({ cancel: true, addPairs: [], skips: [] }); }
    var result = await resultPromise;
    try { dlg.remove(); } catch (e) {}
    return result;
}

// __tofuCjkRoster — build the add-pair dst <select> roster for a target lang:
// fonts_by_language[canonTgt] (primary), else the byPair dst set (§4.2 fallback),
// else [] (caller hides add-pair → accept/cancel only). Pure host-free helper.
function __tofuCjkRoster(brandConfig, canonTgt, byPair) {
    var out = [], seen = {};
    var fbl = (brandConfig && brandConfig.fonts_by_language && brandConfig.fonts_by_language[canonTgt]) || [];
    for (var i = 0; i < fbl.length; i++) {
        var f = fbl[i];
        if (f && f.font) { var k = f.font + "\t" + f.weight; if (!seen[k]) { seen[k] = 1; out.push({ font: f.font, weight: f.weight }); } }
    }
    if (out.length) return out;
    var bp = Array.isArray(byPair) ? byPair : [];
    for (var j = 0; j < bp.length; j++) {
        var e = bp[j];
        if (e && e.dstFont) { var k2 = e.dstFont + "\t" + e.dstWeight; if (!seen[k2]) { seen[k2] = 1; out.push({ font: e.dstFont, weight: e.dstWeight }); } }
    }
    return out;
}

// __tofuDedupeUnowned — dedupe unowned diag entries by (sourceFont, sourceWeight)
// with an occurrence count (for the dialog "用于 N 处" display).
function __tofuDedupeUnowned(unownedArr) {
    var seen = {}, out = [];
    var arr = Array.isArray(unownedArr) ? unownedArr : [];
    for (var i = 0; i < arr.length; i++) {
        var e = arr[i] || {};
        var key = (e.sourceFont || "?") + "|" + (e.sourceWeight || "");
        if (!seen[key]) { seen[key] = { sourceFont: e.sourceFont || "?", sourceWeight: e.sourceWeight || "", count: 0 }; out.push(seen[key]); }
        seen[key].count++;
    }
    return out;
}

// Top-level await — IIFE breaks lfs.getFileForOpening.
// #5 fix: wrap in try/finally so userInteractionLevel + enableRedraw
// always restored even on uncaught throws inside main(). main() itself
// flips between INTERACT_WITH_ALL and NEVER_INTERACT during pipeline
// stages; if it throws between NEVER_INTERACT (line ~568) and the
// pre-save restore (line ~744), we'd leave the InDesign session stuck
// in NEVER_INTERACT (silently swallows showAlert + future dialogs).
var __origIntLvl = null;
try { __origIntLvl = app.scriptPreferences.userInteractionLevel; } catch (eIL0) {}
// #25 fix: capture caller's enableRedraw before main() can force it
// false, so the finally restores the caller's setting instead of
// unconditionally true (mirrors reorganize_styles_inplace.idjs #11 fix).
// Hoisted to module scope so main() can read/update via closure.
var origEnableRedraw = null;
try { origEnableRedraw = app.scriptPreferences.enableRedraw; } catch (eED0) {}
try {
    await main();
} finally {
    // 兜底关 ProcessingDialog（main 抛 fatal 或 return 早退时可能漏关）
    if (__topLevelProcessing) {
        try { __topLevelProcessing.close(); } catch (eCl) {}
        __topLevelProcessing = null;
    }
    try {
        if (__origIntLvl !== null) {
            app.scriptPreferences.userInteractionLevel = __origIntLvl;
        }
    } catch (eIL1) {}
    try {
        if (origEnableRedraw !== null) {
            app.scriptPreferences.enableRedraw = origEnableRedraw;
        } else {
            app.scriptPreferences.enableRedraw = true;
        }
    } catch (eED) {}
}
