    var i, row;

    lines.push("tid_total\t" + state.tidTotal);
    lines.push("tid_fallback\t" + state.tidFallback);
    lines.push("tid_fallback_ratio\t" + ratio.toFixed(6));
    lines.push("tid_fallback_ratio_human\t" + pctText(ratio));
    lines.push("tid_fallback_block_ratio\t" + state.tidFallbackBlockRatio.toFixed(6));
    lines.push("");
    lines.push("story_id\tparagraph_index\tstatus\tmethod\ttid\tmessage");

    for (i = 0; i < state.tidDiagnostics.length; i++) {
        row = state.tidDiagnostics[i];
        lines.push(
            String(row.story_id) + "\t" +
            String(row.paragraph_index) + "\t" +
            String(row.status) + "\t" +
            String(row.method) + "\t" +
            String(row.tid || "").replace(/\t/g, " ") + "\t" +
