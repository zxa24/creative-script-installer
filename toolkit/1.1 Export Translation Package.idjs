            task_id: taskId,
            page: pageLabel,
            page_index: pageIdx,
            object_id: objectId,
            graphic_id: graphicId,
            asset_name: assetName,
            link_state: linkState,
            link_status_raw: linkStatusRaw,
            link_needed_raw: linkNeededRaw,
