    var includeAsAi, placedBounds, pageBounds, placedBoundsNorm, linkStatusRaw, linkNeededRaw, recoverability;
    var pathExists, canUnembed;

    for (i = 0; i < graphics.length; i++) {
        g = getCollectionItem(graphics, i);
        if (!g || !g.isValid) {
            continue;
        }

        link = null;
        hasLink = false;
        linkType = "";
        assetName = "";
        linkStatus = "";
        linkPath = "";
        linkStatusRaw = "";
        linkNeededRaw = "";
