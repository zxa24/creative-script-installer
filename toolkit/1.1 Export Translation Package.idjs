// Canonical source/target language options for the export dialog — codes from
// lib/lang_script_table.js (single source of truth, shared with the webapp's
// PROJECT_LANGUAGES); names are cosmetic labels mirroring the webapp display.
var __LANG_NAMES = {
    en: "English", fr: "French", es: "Spanish", de: "German",
    "zh-CN": "Chinese Simplified", "zh-TW": "Chinese Traditional", "zh-HK": "Chinese Traditional (HK)",
    ja: "Japanese", ko: "Korean", th: "Thai", ar: "Arabic"
};
function __buildLangOptions() {
    var codes = Object.keys(LangScriptTable.LANG_SCRIPT_TABLE || {});
    var out = [];
    for (var i = 0; i < codes.length; i++) {
        out.push({ code: codes[i], label: (__LANG_NAMES[codes[i]] || codes[i]) + " (" + codes[i] + ")" });
    }
    return out;
}
var ProcessingDialog = require("./lib/processing_dialog.js");
var ScriptLogPaths = require("./lib/script_log_paths.js");

// 模块级 processing 句柄 —— main() 把自己的 ProcessingDialog 实例
// 暴露到这里，万一 main 抛 fatal，顶层 finally 也能兜底关掉，不让
// "Processing..." 弹窗一直挂着。
var __topLevelProcessing = null;

// Unpack common functions used throughout
var readUtf8File = common.readUtf8File;
var writeUtf8File = common.writeUtf8File;
var normalizeSoftBreaks = common.normalizeSoftBreaks;
var hashDjb2Hex = common.hashDjb2Hex;
var normalizeText = common.normalizeText;
var sourceHashForText = common.sourceHashForText;
var isSpecialControlCharCode = common.isSpecialControlCharCode;
var isAnchoredObjectOnlyText = common.isAnchoredObjectOnlyText;
var paragraphTextNoReturn = common.paragraphTextNoReturn;
var objectTypeName = common.objectTypeName;
var isTypeName = common.isTypeName;
var findAncestorByType = common.findAncestorByType;
var getPageIndexFromContainer = common.getPageIndexFromContainer;
var detectTableCellMetaForParagraph = common.detectTableCellMetaForParagraph;
var buildTableCellMetaFromObjects = common.buildTableCellMetaFromObjects;
var tableCellSyntheticIndex = common.tableCellSyntheticIndex;
var getXmlAttr = common.getXmlAttr;
var pad2 = common.pad2;
var pad3 = common.pad3;
var utcIsoNow = common.utcIsoNow;
var compactTimestampNow = common.compactTimestampNow;

var SCHEMA_VERSION = "translation-mvp-1";
var EXPORT_SCRIPT_REV = "2026-02-24-table-cells-v7";
var XML_TAG_NAME = "TranslationSegment";
var XML_TID_ATTR = "tid";
var TID_FALLBACK_BLOCK_RATIO = 0.05;
var _masterPageMap = null;

// JSONUtil removed — UXP has native JSON.parse/JSON.stringify
// ==================== Helpers ====================

function stripFileExtension(name) {
    var idx = name.lastIndexOf(".");
    if (idx > 0) {
        return name.substring(0, idx);
    }
    return name;
}

function sanitizeForPath(name) {
    return name.replace(/[\\\/:\*\?"<>\|]/g, "_");
}

function toFiniteNumber(v) {
    var n = Number(v);
    return isFinite(n) ? n : NaN;
}

function uniqueSortedNumbers(arr) {
    var seen = {};
    var out = [];
    var i, key;
    for (i = 0; i < arr.length; i++) {
        key = String(arr[i]);
        if (!seen[key]) {
            seen[key] = true;
            out.push(arr[i]);
        }
    }
    out.sort(function (a, b) { return a - b; });
    return out;
}

// normalizeForHash removed -- use normalizeText from translation_common.jsxinc
// (unified: strips BOM + zero-width + U+0007 + soft breaks, consistent with import side)

// hashDjb2Hex, normalizeText, sourceHashForText -> translation_common.jsxinc

function ensureFolder(folder) {
    if (!folder.exists) {
        return folder.create();
    }
    return true;
}

// writeUtf8File, normalizeSoftBreaks, isSpecialControlCharCode -> translation_common.jsxinc

function isWhitespaceCharCode(code) {
    return code === 9 || code === 10 || code === 13 || code === 32 || code === 160;
}

function isControlOnlyText(text) {
    var s = safeString(text);
    var hasControl = false;
    var i, code;
    for (i = 0; i < s.length; i++) {
        code = s.charCodeAt(i);
        if (isSpecialControlCharCode(code)) {
            hasControl = true;
            continue;
        }
        if (isWhitespaceCharCode(code)) {
            continue;
        }
        return false;
    }
    return hasControl;
}

// isAnchoredObjectOnlyText -> translation_common.jsxinc

function detectSegmentKindFromText(text) {
    var s = safeString(text);
    // U+FFFC = anchored inline object (chart, table, image) - non-translatable
    if (isAnchoredObjectOnlyText(s)) {
        return "control_anchor";
    }
    if (!isControlOnlyText(s)) {
        return "text";
    }
    if (s.indexOf(String.fromCharCode(0x16)) >= 0) {
        return "table_anchor";
    }
    return "control_anchor";
}

// isTypeName, findAncestorByType -> translation_common.jsxinc

// detectTableCellMetaForParagraph -> translation_common.jsxinc
// buildTableCellMetaFromObjects -> translation_common.jsxinc
// (export uses _masterPageMap global; getPageIndexFromContainer in common takes it as param)

// getPageIndexFromContainer: export callers pass _masterPageMap as 2nd arg

function paragraphStableKey(para, storyId, paraIdx) {
    var paraId = "";
    var idx = Number(paraIdx);
    var cellMeta = arguments.length > 3 ? arguments[3] : null;
    var tableId = Number(cellMeta && cellMeta.table_id);
    var tableIndex = Number(cellMeta && cellMeta.table_index);
    var row = Number(cellMeta && cellMeta.cell_row);
    var col = Number(cellMeta && cellMeta.cell_col);
    var cp = Number(cellMeta && cellMeta.cell_para_index);
    var tableKey = "";
    var tableKeyPart = "";
    if (isFinite(tableId) && tableId >= 0 && isFinite(row) && row >= 0 && isFinite(col) && col >= 0) {
        tableKeyPart = "id_" + String(tableId);
    } else if (isFinite(tableIndex) && tableIndex >= 0 && isFinite(row) && row >= 0 && isFinite(col) && col >= 0) {
        tableKeyPart = "idx_" + String(tableIndex);
    }
    if (tableKeyPart) {
        tableKey = "table_" + tableKeyPart;
        if (!isFinite(cp) || cp < 0) {
            cp = isFinite(idx) && idx >= 0 ? idx : 0;
        }
        return "story_" + safeString(storyId) + "_" + tableKey + "_r" + String(row) + "_c" + String(col) + "_p" + String(cp);
    }
    try {
        paraId = safeString(para.id);
    } catch (e0) {
        paraId = "";
    }
    if (paraId) {
        return "pid_" + paraId;
    }
    return "story_" + safeString(storyId) + "_para_" + safeString(paraIdx);
}

// tableCellSyntheticIndex -> translation_common.js (shared with v2_pipeline label writer)

function paragraphIndexHintForTid(para, fallbackIdx) {
    var idx = Number(fallbackIdx);
    var paraIdNum = NaN;
    var paraIdxNum = NaN;
    var cellMeta = arguments.length > 2 ? arguments[2] : null;
    if (!isFinite(idx) || idx < 0) {
        idx = 0;
    }
    if (cellMeta) {
        return tableCellSyntheticIndex(cellMeta, idx);
    }
    try {
        paraIdNum = Number(para.id);
    } catch (e0) {
        paraIdNum = NaN;
    }
    if (isFinite(paraIdNum) && paraIdNum >= 0) {
        return paraIdNum;
    }
    try {
        paraIdxNum = Number(para.index);
    } catch (e1) {
        paraIdxNum = NaN;
    }
    if (isFinite(paraIdxNum) && paraIdxNum >= 0) {
        return paraIdxNum;
    }
    return idx;
}

function storyIdForParagraph(para, fallbackStoryId) {
    var storyIdNum = Number(fallbackStoryId);
    var s = null;
    var candidate = NaN;
    if (!isFinite(storyIdNum)) {
        storyIdNum = -1;
    }
    try {
        s = para.parentStory;
    } catch (e0) {
        s = null;
    }
    if (s && s.isValid) {
        try {
            candidate = Number(s.id);
        } catch (e1) {
            candidate = NaN;
        }
        if (isFinite(candidate)) {
            storyIdNum = candidate;
        }
    }
    return storyIdNum;
}

function paragraphUidForParagraph(para) {
    var uid = NaN;
    try {
        uid = Number(para.id);
    } catch (e0) {
        uid = NaN;
    }
    if (isFinite(uid) && uid >= 0) {
        return uid;
    }
    return -1;
}

function segmentParagraphIndexForOutput(para, fallbackIdx, tableCellMeta) {
    var idx = Number(fallbackIdx);
    if (tableCellMeta) {
        return paragraphIndexHintForTid(para, fallbackIdx, tableCellMeta);
    }
    if (!isFinite(idx) || idx < 0) {
        return 0;
    }
    return idx;
}

function lineRectsForTableCellParagraph(para) {
    var rects = [];
    var table = null;
    var story = null;
    var frame = null;
    var gb = null;

    if (!para || !para.isValid) {
        return rects;
    }

    table = findAncestorByType(para, "Table", 14);
    if (table && table.isValid) {
        try {
            story = table.parentStory;
        } catch (e0) {
            story = null;
        }
    }

    if (story && story.isValid) {
        try {
            if (story.textContainers && story.textContainers.length > 0) {
                frame = getCollectionItem(story.textContainers, 0);
            }
        } catch (e1) {
            frame = null;
        }
    }

    if (!frame || !frame.isValid) {
        try {
            if (para.parentTextFrames && para.parentTextFrames.length > 0) {
                frame = para.parentTextFrames[0];
            }
        } catch (e2) {
            frame = null;
        }
    }

    if (!frame || !frame.isValid) {
        return rects;
    }

    try {
        gb = frame.geometricBounds;
        if (gb && gb.length >= 4) {
            rects.push({
                page_index: getPageIndexFromContainer(frame, _masterPageMap),
                x0: toFiniteNumber(gb[1]),
                y0: toFiniteNumber(gb[0]),
                x1: toFiniteNumber(gb[3]),
                y1: toFiniteNumber(gb[2])
            });
        }
    } catch (e3) {}

    return rects;
}

function pageIndexesFromLineRects(rects) {
    var pageIndexes = [];
    var i;
    if (!rects) {
        return pageIndexes;
    }
    for (i = 0; i < rects.length; i++) {
        pageIndexes.push(rects[i].page_index);
    }
    return uniqueSortedNumbers(pageIndexes);
}

function attachTableCellMetaToSegment(segObj, tableCellMeta) {
    if (!segObj || !tableCellMeta) {
        return;
    }
    segObj.table_id = tableCellMeta.table_id;
    segObj.table_index = tableCellMeta.table_index;
    segObj.table_uid = tableCellMeta.table_uid;
    segObj.cell_uid = tableCellMeta.cell_uid;
    segObj.cell_row = tableCellMeta.cell_row;
    segObj.cell_col = tableCellMeta.cell_col;
    segObj.row_span = tableCellMeta.row_span;
    segObj.col_span = tableCellMeta.col_span;
    segObj.cell_para_index = tableCellMeta.cell_para_index;
    segObj.cell_para_count = tableCellMeta.cell_para_count;
}

// Capture paragraph-level leading. Returns:
//   { leading_pt, leading_ratio, leading_auto }
//   - leading_pt > 0 and leading_ratio === 0: explicit absolute leading in pt
//   - leading_pt === 0 and leading_ratio > 0: AUTO leading with resolved ratio
//   - both zero: unreadable (rare; only when both para.leading and the style's
//     autoLeadingPercentage are inaccessible)
//
// Strategy: try to parse para.leading as a sane pt number (0 < n < 1000).
// Anything else — AUTO sentinels (FourCC 1635019116), enum objects, NothingEnum
// for mixed leading, throws — routes to AUTO and resolves the ratio from the
// applied paragraph style's autoLeadingPercentage (default 120). This is more
// robust than enum-identity comparison, which behaves inconsistently in UXP.
function captureLeading(para) {
    var leadingPt = 0;
    var leadingRatio = 0;
    var isAuto = false;
    var raw;
    var rawIsSanePt = false;
    try {
        raw = para.leading;
        var n = toFiniteNumber(raw);
        if (isFinite(n) && n > 0 && n < 1000) {
            leadingPt = n;
            rawIsSanePt = true;
        }
    } catch (e0) {}
    if (!rawIsSanePt) {
        // Treat anything that isn't a normal pt number as AUTO and resolve via
        // the applied paragraph style. Fall back to 120% (InDesign default) if
        // the style or its property is inaccessible.
        isAuto = true;
        var pct = 120;
        try {
            var styled = para.appliedParagraphStyle;
            if (styled) {
                var p = toFiniteNumber(styled.autoLeadingPercentage);
                if (isFinite(p) && p > 0) pct = p;
            }
        } catch (e1) {}
        leadingRatio = pct / 100;
    }
    if (!isFinite(leadingPt) || leadingPt <= 0) leadingPt = 0;
    if (!isFinite(leadingRatio) || leadingRatio <= 0) leadingRatio = 0;
    return { leading_pt: leadingPt, leading_ratio: leadingRatio, leading_auto: isAuto };
}

// #34 G1 (export side): doc-level hyperlink index. Built once per
// extractSegments() invocation, keyed by storyId (as string). Each
// entry is an array of hyperlink records:
//   { storyStartIdx, storyEndIdx, url, name, text }
//
// Filled by _collectDocHyperlinksByStory(doc) before the per-paragraph
// loop; consumed by buildSegmentObjectFromParagraph to attach
// `source_links[]` (paragraph-relative offsets) to each segment so the
// webapp can render them as underlined anchors on the source side.
//
// Only HyperlinkTextSource → HyperlinkURLDestination links are
// captured for v1 — PageItem-source / Text-destination / Page-
// destination need re-targeting we don't have yet.
var _docHyperlinkByStory = null;

function _collectDocHyperlinksByStory(doc) {
    var byStory = {};
    var hl;
    try { hl = doc.hyperlinks; } catch (e) { return byStory; }
    var n = 0; try { n = hl.length; } catch (e2) {}
    for (var i = 0; i < n; i++) {
        var h;
        try { h = hl.item(i); } catch (e3) { continue; }
        if (!h) continue;
        var srcKind = ""; try { srcKind = h.source && h.source.constructor.name; } catch (e4) {}
        if (srcKind !== "HyperlinkTextSource") continue;
        var destKind = ""; try { destKind = h.destination && h.destination.constructor.name; } catch (e5) {}
        if (destKind !== "HyperlinkURLDestination") continue;
        var url = ""; try { url = String(h.destination.destinationURL); } catch (e6) {}
        if (!url) continue;
        var rec = {
            name:           "",
            url:            url,
            storyStartIdx:  -1,
            storyEndIdx:    -1,
            text:           ""
        };
        try { rec.name = String(h.name); } catch (e7) {}
        var sid = "";
        try {
            var st = h.source.sourceText;
            if (!st) continue;
            try { sid = String(st.parentStory.id); } catch (e8) {}
            if (!sid) continue;
            try { rec.storyStartIdx = st.characters.item(0).index; } catch (e9) {}
            try {
                var nc = st.characters.length;
                if (nc > 0) rec.storyEndIdx = st.characters.item(nc - 1).index;
            } catch (e10) {}
            try { rec.text = String(st.contents); } catch (e11) {}
        } catch (e12) { continue; }
        if (rec.storyStartIdx < 0 || rec.storyEndIdx < 0) continue;
        if (!byStory[sid]) byStory[sid] = [];
        byStory[sid].push(rec);
    }
    return byStory;
}

// Find hyperlinks that intersect a paragraph's story-relative char
// range, then project to paragraph-relative offsets. Records output
// shape: { offset, length, url, name, text }.
function _linksForParagraph(para, storyId) {
    if (!_docHyperlinkByStory) return [];
    var key = String(storyId);
    var bucket = _docHyperlinkByStory[key];
    if (!bucket || !bucket.length) return [];
    var paraStart = -1, paraEnd = -1;
    try { paraStart = para.characters.item(0).index; } catch (e) { return []; }
    try {
        var nch = para.characters.length;
        if (nch > 0) paraEnd = para.characters.item(nch - 1).index;
    } catch (e2) { return []; }
    if (paraStart < 0 || paraEnd < paraStart) return [];
    var out = [];
    for (var i = 0; i < bucket.length; i++) {
        var rec = bucket[i];
        // Skip hyperlinks that don't overlap the paragraph at all.
        if (rec.storyEndIdx < paraStart) continue;
        if (rec.storyStartIdx > paraEnd) continue;
        // Clamp to paragraph boundary (rare: hyperlink crosses para break)
        var clampedStart = Math.max(rec.storyStartIdx, paraStart);
        var clampedEnd   = Math.min(rec.storyEndIdx,   paraEnd);
        if (clampedEnd < clampedStart) continue;
        var paraOffset = clampedStart - paraStart;
        var paraLength = clampedEnd - clampedStart + 1;   // inclusive endIdx
        if (paraLength <= 0) continue;
        out.push({
            offset:  paraOffset,
            length:  paraLength,
            url:     rec.url,
            name:    rec.name,
            // sourceText slice corresponding to clamped range — useful for
            // sanity-checking webapp render against actual contents
            text:    rec.text.slice(clampedStart - rec.storyStartIdx, clampedEnd - rec.storyStartIdx + 1),
            // #E2E-4: visual_underline = the link should display with a
            // visible underline on import, even when the source paragraph's
            // character.underline is false. InDesign auto-underlines
            // hyperlinks in PDF export, so users expect the round-trip to
            // preserve that visual. Always true for now (no per-link DOM
            // signal distinguishes "designer wanted no underline" from
            // "InDesign default underline"); import side honors this by
            // applying `range.underline=true` as a character-level override.
            visual_underline: true
        });
    }
    // #E2E-5: Merge adjacent same-URL links into a single record. Designers
    // sometimes split one logical link into multiple Hyperlink objects on
    // contiguous ranges (we saw this on Client-A Product-3: "Client-A Product-3...Elite" +
    // "®*万事达卡®*" → two records with identical URL). Keeping them split
    // forces the webapp / import to handle them separately and produces
    // visually inconsistent underline runs. Merging is purely cosmetic for
    // the export contract but improves downstream UX.
    out.sort(function (a, b) { return a.offset - b.offset; });
    var merged = [];
    for (var mi = 0; mi < out.length; mi++) {
        var cur = out[mi];
        var prev = merged[merged.length - 1];
        if (prev && prev.url === cur.url && prev.offset + prev.length === cur.offset) {
            prev.length += cur.length;
            prev.text   = (prev.text || "") + (cur.text || "");
            // visual_underline = prev OR cur (if either side requested it)
            if (cur.visual_underline) prev.visual_underline = true;
            // keep prev.name (first wins)
        } else {
            merged.push(cur);
        }
    }
    return merged;
}

function buildSegmentObjectFromParagraph(para, storyId, paraIdx, tid, tableCellMeta) {
    var src = paragraphTextNoReturn(para);
    var paraStyle = "[None]";
    var rects = lineRectsForParagraph(para);
    var inlineStyles = extractInlineStyles(para);
    var norm = normalizeText(src);
    var hiddenMeta = hiddenStateForParagraph(para);
    var pointSize = 0;
    var leading = captureLeading(para);
    var segmentKind;
    var translatable;
    var targetPolicy;
    var segObj;

    if ((!rects || rects.length === 0) && tableCellMeta) {
        rects = lineRectsForTableCellParagraph(para);
    }
    if (!rects) {
        rects = [];
    }

    try {
        paraStyle = para.appliedParagraphStyle.name;
    } catch (e0) {}

    try {
        if (para && para.characters && para.characters.length > 0) {
            var _charCount = para.characters.length;
            var _scanLimit = _charCount < 8 ? _charCount : 8;
            for (var _ci = 0; _ci < _scanLimit; _ci++) {
                try {
                    var _ch = getCollectionItem(para.characters, _ci);
                    if (!_ch) continue;
                    var _ps = toFiniteNumber(_ch.pointSize);
                    if (isFinite(_ps) && _ps > 0) {
                        pointSize = _ps;
                        break;
                    }
                } catch (ePSc) {}
            }
        }
        if ((!isFinite(pointSize) || pointSize <= 0) && para && para.appliedParagraphStyle) {
            pointSize = toFiniteNumber(para.appliedParagraphStyle.pointSize);
        }
    } catch (ePS) {}
    if (!isFinite(pointSize) || pointSize <= 0) pointSize = 0;

    if (tableCellMeta && !isControlOnlyText(src)) {
        segmentKind = "table_cell";
    } else {
        segmentKind = detectSegmentKindFromText(src);
    }
    translatable = isSegmentKindTranslatable(segmentKind);
    targetPolicy = targetPolicyForSegmentKind(segmentKind);
    if (hiddenMeta && hiddenMeta.hidden) {
        translatable = false;
        targetPolicy = "preserve_source";
    }

    // Phase 1: visual snapshots — character-level (format) + paragraph-level
    var formatSnapshot = null;
    var paragraphSnapshot = null;
    try { formatSnapshot = VisualSnapshot.captureFormatSnapshot(para); } catch (eFS) { formatSnapshot = null; }
    try { paragraphSnapshot = VisualSnapshot.captureParagraphSnapshot(para); } catch (ePS2) { paragraphSnapshot = null; }

    // #34: project any doc-level hyperlinks intersecting this para
    // into paragraph-relative offsets so the webapp can render them
    // as underlined anchors on the source side. Empty when no link
    // touches this para or the doc-hyperlink index hasn't been built
    // (legacy call paths). Output shape: [{offset,length,url,name,text}].
    var sourceLinks = [];
    try { sourceLinks = _linksForParagraph(para, storyId); } catch (eLk) {}

    segObj = {
        tid: tid,
        story_id: storyId,
        paragraph_index: segmentParagraphIndexForOutput(para, paraIdx, tableCellMeta),
        paragraph_uid: paragraphUidForParagraph(para),
        source_text: src,
        segment_kind: segmentKind,
        translatable: translatable,
        target_policy: targetPolicy,
        paragraph_style: paraStyle,
        page_indexes: pageIndexesFromLineRects(rects),
        line_rects: rects,
        line_rects_norm: [],
        point_size: pointSize,
        leading_pt: leading.leading_pt,
        leading_ratio: leading.leading_ratio,
        leading_auto: leading.leading_auto,
        inline_styles: inlineStyles,
        format_snapshot: formatSnapshot,
        paragraph_snapshot: paragraphSnapshot,
        source_hash: hashDjb2Hex(norm),
        is_hidden_object: !!(hiddenMeta && hiddenMeta.hidden),
        hidden_reason: hiddenMeta && hiddenMeta.reason ? hiddenMeta.reason : "",
        source_links: sourceLinks
    };
    // char_rects_norm (contract §10): raw per-char rects, only for translatable
    // non-empty segments (spec §6). Normalized + CR-1-aligned later in
    // attachNormalizedCharRects (shares line_rects' per-page mode). `_char_rects_raw`
    // is a transient field, deleted after normalization (never serialized).
    if (translatable && src && src.length > 0) {
        try { segObj._char_rects_raw = charRectsForParagraph(para); }
        catch (eCRR) { segObj._char_rects_raw = null; }
    }
    if (tableCellMeta) {
