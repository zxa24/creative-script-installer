function log(text) {
    lines.push(utils.getTimestamp() + " " + String(text));
}

var getOutputDirectory = FileUtils.getOutputDirectory;
var getOutputFileNameWithoutExtension = FileUtils.getOutputFileNameWithoutExtension;
var writeJsonFile = FileUtils.writeJsonFile;
var writeTextFile = FileUtils.writeTextFile;
var getLastFileUtilsError = FileUtils.getLastFileUtilsError;

function describeLastFileUtilsError() {
    var err = null;
    try { err = getLastFileUtilsError(); } catch (e0) {}
    if (!err) {
        return "";
    }
    return [
        safe(err.operation),
        safe(err.path),
        safe(err.code),
        safe(err.message)
    ].join(" | ");
}

function recordWriteFailure(kind, pathValue, error) {
    var detail = safe(error && error.message ? error.message : error);
    var lastErr = describeLastFileUtilsError();
    log("WRITE FAILED [" + safe(kind) + "]: " + safe(pathValue) + (detail ? " error=" + detail : ""));
    if (lastErr) {
        log("WRITE FAILED DETAIL [" + safe(kind) + "]: " + lastErr);
    }
}

function writeJsonFileObserved(pathValue, payload, kind) {
    try {
        writeJsonFile(pathValue, payload);
        return true;
    } catch (e0) {
        recordWriteFailure(kind || "json", pathValue, e0);
    }
    return false;
}

function writeTextFileObserved(pathValue, contents, kind) {
    if (writeTextFile(pathValue, contents)) {
        return true;
    }
    recordWriteFailure(kind || "text", pathValue, null);
    return false;
}

function ensureAcceptanceBundle() {
    var outDir;
    var outBase;
    if (acceptanceBundle) {
        return acceptanceBundle;
    }
    outDir = getOutputDirectory(OUT_PATH);
    outBase = getOutputFileNameWithoutExtension(OUT_PATH) + ACCEPTANCE_BUNDLE_SUFFIX;
    acceptanceBundle = {
        schemaVersion: 2,
        generatedAt: new Date().toISOString ? new Date().toISOString() : String(new Date()),
        logPath: OUT_PATH,
        outputDir: outDir,
        bundleBase: outBase,
        imageOutputDir: outDir,
        documentName: "",
        pages: {},
        storyIds: [],
        stories: [],
        images: [],
        exports: [],
        errors: [],
        summary: {
            pass: false,
            issues: []
        },
        geometryRestoredFrameIds: {}
    };
    return acceptanceBundle;
}

function pushBundleIssue(message) {
    var bundle = ensureAcceptanceBundle();
    pushUnique(bundle.summary.issues, safe(message));
}

function ensureBundlePage(pageName) {
    var bundle = ensureAcceptanceBundle();
    var key = safe(pageName);
    if (!bundle.pages[key]) {
        bundle.pages[key] = {
            pass: true,
            issues: [],
            frames: [],
            geometrySplitUnresolved: []
        };
    }
    return bundle.pages[key];
}

function pushPageGeometrySplitUnresolved(pageName, frameId) {
    var pageRecord = ensureBundlePage(pageName);
    if (!pageRecord.geometrySplitUnresolved) {
        pageRecord.geometrySplitUnresolved = [];
    }
    pushUnique(pageRecord.geometrySplitUnresolved, "geometry-split-unresolved frame " + safe(frameId));
    log("geometry-split-unresolved frame " + safe(frameId) + " on page " + safe(pageName) + " (manual review required, not counted as issue)");
}

function pushPageIssue(pageName, message) {
    var pageRecord = ensureBundlePage(pageName);
    pageRecord.pass = false;
    pushUnique(pageRecord.issues, safe(message));
    pushBundleIssue("page " + safe(pageName) + ": " + safe(message));
}

function captureFrameAcceptanceRecord(frameSnapshot) {
    if (!frameSnapshot) {
        return null;
    }
    return {
        frameId: safe(frameSnapshot.id),
        page: safe(frameSnapshot.pageName),
        firstParaStart: frameSnapshot.firstParaStart,
        lastParaStart: frameSnapshot.lastParaStart,
        firstParaOrdinal: frameSnapshot.firstParaOrdinal,
        lastParaOrdinal: frameSnapshot.lastParaOrdinal,
        firstChar: frameSnapshot.firstCharIdx,
        lastChar: frameSnapshot.lastCharIdx,
        lineCount: frameSnapshot.lineCount,
        firstLine: safe(frameSnapshot.firstLine),
        lastLine: safe(frameSnapshot.lastLine),
        hasObjectMarker: !!frameSnapshot.hasObjectMarker,
        overflows: !!frameSnapshot.overflows
    };
}

function getBeforeFrameRecord(pageRecord, frameId) {
    var j;
    var entry;
    for (j = 0; j < pageRecord.frames.length; j++) {
        entry = pageRecord.frames[j];
        if (entry.data && String(entry.data.frameId) === String(frameId) &&
                entry.stage && entry.stage.indexOf("_before") >= 0) {
            return entry.data;
        }
    }
    return null;
}

function recordSnapshotForAcceptance(stage, snapshot) {
    var bundle = ensureAcceptanceBundle();
    var i;
    var frameRecord;
    var pageRecord;
    var beforeRec;
    var isAfterRepair;
    var bFirst;
    var aFirst;
    var delta;
    if (!snapshot || !snapshot.frames) {
        return;
    }
    isAfterRepair = stage && stage.indexOf("_after_repair") >= 0;
    for (i = 0; i < snapshot.frames.length; i++) {
        frameRecord = captureFrameAcceptanceRecord(snapshot.frames[i]);
        if (!frameRecord) {
            continue;
        }
        if (ACCEPTANCE_WATCH_PAGES.indexOf(frameRecord.page) < 0) {
            continue;
        }
        pageRecord = ensureBundlePage(frameRecord.page);
        pageRecord.frames.push({
            stage: stage,
            data: frameRecord
        });

        // M1-2: distinguish pre-existing overflow from script-introduced overflow
        if (frameRecord.overflows) {
            beforeRec = getBeforeFrameRecord(pageRecord, frameRecord.frameId);
            if (beforeRec && beforeRec.overflows) {
                log("pre-existing-overflow frame " + frameRecord.frameId + " during " + stage);
            } else {
                pushPageIssue(frameRecord.page, "overflow in frame " + frameRecord.frameId + " during " + stage);
            }
        }

        // M1-1 / P3-2: compare _after_repair against _before for boundary delta
        // Use firstParaOrdinal when available (stable across text replacement); fall back to firstChar.
        if (isAfterRepair) {
            beforeRec = getBeforeFrameRecord(pageRecord, frameRecord.frameId);
            if (beforeRec) {
                var useOrdinal = (beforeRec.firstParaOrdinal !== undefined && beforeRec.firstParaOrdinal !== null &&
                    frameRecord.firstParaOrdinal !== undefined && frameRecord.firstParaOrdinal !== null);
                if (useOrdinal) {
                    bFirst = beforeRec.firstParaOrdinal;
                    aFirst = frameRecord.firstParaOrdinal;
                    if (bFirst !== -1 && aFirst === -1) {
                        log("boundary-lost frame " + frameRecord.frameId + " firstParaOrdinal before=" + bFirst + " after=-1 during " + stage);
                        if (bundle.geometryRestoredFrameIds && bundle.geometryRestoredFrameIds[String(frameRecord.frameId)]) {
                            pushPageGeometrySplitUnresolved(frameRecord.page, frameRecord.frameId);
                        } else {
                            pushPageIssue(frameRecord.page, "boundary-lost frame " + frameRecord.frameId + " during " + stage);
                        }
                    } else if (bFirst !== -1 && aFirst !== -1 && aFirst !== bFirst) {
                        log("boundary-delta frame " + frameRecord.frameId + " firstParaOrdinal before=" + bFirst + " after=" + aFirst + " delta=" + (aFirst - bFirst) + " during " + stage);
                        pushPageIssue(frameRecord.page, "boundary-delta frame " + frameRecord.frameId + " paraOrdinal delta=" + (aFirst - bFirst) + " during " + stage);
                    }
                } else {
                    bFirst = beforeRec.firstChar;
                    aFirst = frameRecord.firstChar;
                    if (bFirst !== -1 && aFirst === -1) {
                        log("boundary-lost frame " + frameRecord.frameId + " firstChar before=" + bFirst + " after=-1 during " + stage);
                        if (bundle.geometryRestoredFrameIds && bundle.geometryRestoredFrameIds[String(frameRecord.frameId)]) {
                            pushPageGeometrySplitUnresolved(frameRecord.page, frameRecord.frameId);
                        } else {
                            pushPageIssue(frameRecord.page, "boundary-lost frame " + frameRecord.frameId + " during " + stage);
                        }
                    } else if (bFirst !== -1 && aFirst !== -1) {
                        delta = aFirst - bFirst;
                        if (delta < 0) { delta = -delta; }
                        if (delta > 2) {
                            log("boundary-delta frame " + frameRecord.frameId + " firstChar before=" + bFirst + " after=" + aFirst + " delta=" + (aFirst - bFirst) + " during " + stage);
                            pushPageIssue(frameRecord.page, "boundary-delta frame " + frameRecord.frameId + " firstChar delta=" + (aFirst - bFirst) + " during " + stage);
                        }
                    }
                }
            }
        }
    }
    pushUnique(bundle.storyIds, safe(snapshot.storyId));
}

function buildAcceptanceFilePath(suffix, extension) {
    var bundle = ensureAcceptanceBundle();
    return joinWindowsPath(bundle.outputDir, bundle.bundleBase + suffix + extension);
}

function countIssuesMatching(bundle, prefix) {
    var i;
    var count = 0;
    var issues = bundle.summary.issues;
    for (i = 0; i < issues.length; i++) {
        if (String(issues[i]).indexOf(prefix) >= 0) {
            count += 1;
        }
    }
    return count;
}

function buildAcceptanceSummaryPayload(bundle) {
    var pageSummary = {};
    var manualReviewRequired = [];
    var storyRepair = {
        totalStories: 0,
        storiesWithRepairFailures: 0,
        attempted: 0,
        fixed: 0,
        failed: 0,
        skipped: 0,
        aborted: 0
    };
    var i;
    var key;
    var storyEntry;
    var summary;
    var pageRec;
    var geometrySplitUnresolvedCount = 0;

    for (key in bundle.pages) {
        if (!bundle.pages.hasOwnProperty(key)) {
            continue;
        }
        pageRec = bundle.pages[key];
        pageSummary[key] = {
            pass: !!pageRec.pass,
            issueCount: pageRec.issues.length,
            issues: pageRec.issues.slice(0),
            frameSampleCount: pageRec.frames.length,
            geometrySplitUnresolved: pageRec.geometrySplitUnresolved ? pageRec.geometrySplitUnresolved.slice(0) : []
        };
        if (pageRec.geometrySplitUnresolved && pageRec.geometrySplitUnresolved.length) {
            pushUnique(manualReviewRequired, "page " + key);
            geometrySplitUnresolvedCount += pageRec.geometrySplitUnresolved.length;
        }
    }

    for (i = 0; i < bundle.stories.length; i++) {
        storyEntry = bundle.stories[i];
        if (!storyEntry || !storyEntry.repair) {
            continue;
        }
        storyRepair.totalStories += 1;
        storyRepair.attempted += Number(storyEntry.repair.attempted || 0);
        storyRepair.fixed += Number(storyEntry.repair.fixed || 0);
        storyRepair.failed += Number(storyEntry.repair.failed || 0);
        storyRepair.skipped += Number(storyEntry.repair.skipped || 0);
        if (storyEntry.repair.aborted) {
            storyRepair.aborted += 1;
        }
        if (storyEntry.repair.failed || storyEntry.repair.aborted) {
            storyRepair.storiesWithRepairFailures += 1;
        }
    }

    summary = {
        schemaVersion: bundle.schemaVersion,
        generatedAt: bundle.generatedAt,
        documentName: bundle.documentName,
        logPath: bundle.logPath,
        outputDir: bundle.outputDir,
        status: {
            pass: !!bundle.summary.pass,
            issueCount: bundle.summary.issues.length,
            fatalErrorCount: bundle.errors.length,
            boundaryLostCount: countIssuesMatching(bundle, "boundary-lost"),
            boundaryDeltaCount: countIssuesMatching(bundle, "boundary-delta"),
            geometrySplitUnresolvedCount: geometrySplitUnresolvedCount
        },
        manualReviewRequired: manualReviewRequired,
        watchPages: pageSummary,
        repair: storyRepair,
        files: {
            watchPagesJson: buildAcceptanceFilePath("_watch_pages", ".json"),
            imageDir: bundle.imageOutputDir,
            imageCount: bundle.images.length,
            exportCount: bundle.exports.length
        },
        issues: bundle.summary.issues.slice(0, 20),
        errors: bundle.errors.slice(0, 10)
    };
    return summary;
}

function finalizeAcceptanceBundle(targetDoc) {
    var bundle = ensureAcceptanceBundle();
    var summaryPath;
    var watchPath;
    var summaryPayload;
    var i;
    var pageName;
    if (acceptanceBundleFinalized) {
        return;
    }
    if (targetDoc) {
        bundle.documentName = safe(targetDoc.name);
    }
    bundle.summary.pass = bundle.summary.issues.length === 0;
    summaryPath = buildAcceptanceFilePath("_summary", ".json");
    watchPath = buildAcceptanceFilePath("_watch_pages", ".json");
    summaryPayload = buildAcceptanceSummaryPayload(bundle);
    writeJsonFileObserved(summaryPath, summaryPayload, "acceptance-summary");
    writeJsonFileObserved(watchPath, {
        documentName: bundle.documentName,
        watchPages: ACCEPTANCE_WATCH_PAGES,
        imageOutputDir: bundle.imageOutputDir,
        images: bundle.images,
        exports: bundle.exports,
        pages: bundle.pages
    }, "acceptance-watch-pages");
    log("Acceptance bundle summary: " + summaryPath);
    log("Acceptance watch pages: " + watchPath);
    for (i = 0; i < ACCEPTANCE_WATCH_PAGES.length; i++) {
        pageName = ACCEPTANCE_WATCH_PAGES[i];
        if (bundle.pages[pageName] && bundle.pages[pageName].issues.length) {
            log("Acceptance page " + pageName + " issues: " + bundle.pages[pageName].issues.join(" | "));
        }
    }
    acceptanceBundleFinalized = true;
}

var safe = utils.safe;
var pushUnique = utils.pushUnique;

function safeStoryId(story) {
    try {
        if (!story) {
            return "";
        }
        return safe(story.id);
    } catch (e0) {}
    return "";
}

function getSelectionStory() {
    var sel;
    var item;
    try {
        sel = app.selection;
        if (!sel || !sel.length) {
            return null;
        }
        item = sel.item ? sel.item(0) : sel[0];
        if (!item) {
            return null;
        }
        if (item.parentStory) {
            return item.parentStory;
        }
        if (item.constructor && item.constructor.name === "TextFrame" && item.parentStory) {
            return item.parentStory;
        }
    } catch (e0) {}
    return null;
}

var isUsableStoryObject = StoryUtils.isUsableStoryObject;

function collectRepairableStories(doc) {
    return StoryUtils.collectRepairableStories(doc, log);
}

var resolveLiveStoryById = StoryUtils.resolveLiveStoryById;

function sameName(a, b) {
    return safe(a).toLowerCase() === safe(b).toLowerCase();
}

function getFieldValue(obj, key) {
    try {
        if (!obj) {
            return null;
        }
        return obj[key];
    } catch (e0) {}
    return null;
}

var trySet = utils.trySet;

function mergeCjkFields(sourceStyle, targetStyle) {
    var i;
    var key;
    var value;
    var props;
    var propCount;
    var applied = 0;
    var skipped = 0;
    var failed = 0;
    var batchErrMsg = "";
    var perFieldErrs = [];

    // Collect fields to apply
    props = {};
    propCount = 0;
    for (i = 0; i < CJK_FIELD_NAMES.length; i++) {
        key = CJK_FIELD_NAMES[i];
        value = getFieldValue(sourceStyle, key);
        if (value === null || typeof value === "undefined") {
            skipped += 1;
            continue;
        }
        props[key] = value;
        propCount += 1;
    }

    if (propCount === 0) {
        return { applied: applied, skipped: skipped, failed: failed, perFieldErrs: perFieldErrs };
    }

    // Batch assignment: one bridge call -> one layout invalidation instead of 10.
    try {
        targetStyle.properties = props;
        return { applied: propCount, skipped: skipped, failed: failed, perFieldErrs: perFieldErrs };
    } catch (eBatch) {
        batchErrMsg = safe(eBatch && eBatch.message ? eBatch.message : eBatch);
    }

    // Fallback: set fields individually with per-field error capture
    for (key in props) {
        if (props.hasOwnProperty(key)) {
            try {
                targetStyle[key] = props[key];
                applied += 1;
            } catch (ePF) {
                failed += 1;
                perFieldErrs.push(safe(key) + ": " + safe(ePF && ePF.message ? ePF.message : ePF));
            }
        }
    }
    if (batchErrMsg) {
        perFieldErrs.unshift("batch: " + batchErrMsg);
    }
    return { applied: applied, skipped: skipped, failed: failed, perFieldErrs: perFieldErrs };
}

function getParagraphStyleName(styleObj) {
    try {
        if (styleObj && styleObj.name !== undefined && styleObj.name !== null) {
            return safe(styleObj.name);
        }
    } catch (e0) {}
    return "";
}

function collectStoryParagraphStyles(story, importedSourceStyle) {
    var out = [];
    var seen = {};

    function pushParaStyle(styleObj) {
        var styleName = getParagraphStyleName(styleObj);
        if (!styleName) return;
        if (importedSourceStyle && sameName(styleName, getParagraphStyleName(importedSourceStyle))) return;
        if (seen[styleName]) return;
        seen[styleName] = true;
        out.push(styleObj);
    }

    function walkParagraphs(paragraphs) {
        if (!paragraphs || !paragraphs.length) return;
        for (var i = 0; i < paragraphs.length; i++) {
            var para = typeof paragraphs.item === "function" ? paragraphs.item(i) : paragraphs[i];
            if (!para) continue;
            var styleObj = null;
            try { styleObj = para.appliedParagraphStyle; } catch (e0) {}
            pushParaStyle(styleObj);
        }
    }

    if (!story) return out;

    // Story-level paragraphs (regular text frames)
    walkParagraphs(story.paragraphs);

    // #CJK-TABLE-CELLS (2026-05-26): table cell paragraphs live OUTSIDE
    // story.paragraphs in story.tables[].cells[].paragraphs. The
    // original collection walk missed them, so the CJK field merge
    // never reached styles used only inside tables — visible symptom:
    // table content keeps Source Han composer/language/mojikumi while
    // body text gets the CJK upgrade.
    try {
        var tables = story.tables;
        var nT = 0;
        try { nT = tables.length; } catch (eTL) {}
        for (var ti = 0; ti < nT; ti++) {
            var tbl = null;
            try { tbl = (typeof tables.item === "function") ? tables.item(ti) : tables[ti]; } catch (eTI) {}
            if (!tbl) continue;
            var cells = null;
            try { cells = tbl.cells; } catch (eCC) {}
            var nC = 0;
            try { nC = cells.length; } catch (eCL) {}
            for (var ci = 0; ci < nC; ci++) {
                var cell = null;
                try { cell = (typeof cells.item === "function") ? cells.item(ci) : cells[ci]; } catch (eCI) {}
                if (!cell) continue;
                try { walkParagraphs(cell.paragraphs); } catch (eCP) {}
            }
        }
    } catch (eTabs) {}

    return out;
}

var getCollectionItem = utils.getCollectionItem;

function restoreTargetDocumentFocus(targetDoc) {
    var win = null;

    if (!targetDoc) {
        return false;
    }

    try {
        if (targetDoc.layoutWindows && targetDoc.layoutWindows.length) {
            win = getCollectionItem(targetDoc.layoutWindows, 0);
        }
    } catch (e0) {}

    if (!win) {
        try {
            if (targetDoc.windows && targetDoc.windows.length) {
                win = getCollectionItem(targetDoc.windows, 0);
            }
        } catch (e1) {}
    }

    if (win) {
        try {
            if (typeof win.activate === "function") {
                win.activate();
                return true;
            }
        } catch (e2) {}
        try {
            app.activeWindow = win;
            return true;
        } catch (e3) {}
    }

    try {
        if (typeof targetDoc.activate === "function") {
            targetDoc.activate();
            return true;
        }
    } catch (e4) {}

    return false;
}

function showStatusDialog(messageText) {
    var dlg;
    var col;
    var parts;
    var i;

    if (RunnerConfig.shouldSuppressDialogs(app)) {
        return false;
    }

    try {
        dlg = app.dialogs.add({ name: "CJK Style Apply" });
        col = dlg.dialogColumns.add();
        parts = String(messageText).split(/\r?\n|\r/);
        for (i = 0; i < parts.length; i++) {
            col.staticTexts.add({ staticLabel: parts[i] });
        }
        dlg.show();
        dlg.destroy();
        return true;
    } catch (e0) {
        try {
            if (dlg) {
                dlg.destroy();
            }
        } catch (e1) {}
    }

    try {
        alert(messageText);
        return true;
    } catch (e2) {}

    return false;
}

function buildStatusText() {
    var preview = [];
    var i;
    if (cjkImportBroken) {
        preview.push("⚠⚠ CJK IMPORT BROKEN — KINSOKU (line-breaking rules) NOT APPLIED ⚠⚠");
        preview.push(cjkImportBrokenDetail);
        preview.push("Donor style lost its CJK config on import. Fix lib/CJK.idml: the donor");
        preview.push("paragraph style must self-define CJK fields LOCALLY (not via root inheritance).");
        preview.push("");
    }
    preview.push("CJK style apply finished.");
    preview.push(statusLine || "Done.");
    preview.push("Output:");
    preview.push(OUT_PATH);
    if (acceptanceBundle) {
        preview.push("Acceptance:");
        preview.push(buildAcceptanceFilePath("_summary", ".json"));
    }
    preview.push("");
    preview.push("Preview:");
    for (i = 0; i < lines.length && i < 10; i++) {
        preview.push(lines[i]);
    }
    return preview.join("\r");
}

var captureStorySnapshot = SnapshotUtils.captureStorySnapshot;

function logStorySnapshot(prefix, snapshot) {
    SnapshotUtils.logStorySnapshot(prefix, snapshot, log);
    recordSnapshotForAcceptance(prefix, snapshot);
}

var serializeStorySnapshot = SnapshotUtils.serializeStorySnapshot;

function saveBeforeSnapshot(targetDoc, storyIds) {
    var snapshots = {};
    var storyOrder = [];
    var i, storyId, liveStory, snap, outJson;

    for (i = 0; i < storyIds.length; i++) {
        storyId = storyIds[i];
        liveStory = resolveLiveStoryById(targetDoc, storyId);
        if (!isUsableStoryObject(liveStory)) {
            log("saveBeforeSnapshot skip storyId=" + storyId + " reason=invalid");
            continue;
        }
        snap = captureStorySnapshot(liveStory);
        SnapshotUtils.expandGeometrySplitFramesPreApply(liveStory, snap, "snapshot[" + i + "]", log);
        snapshots[storyId] = serializeStorySnapshot(snap);
        storyOrder.push(storyId);
    }

    outJson = {
        schemaVersion: 1,
        capturedAt: new Date().toISOString ? new Date().toISOString() : String(new Date()),
        documentName: safe(targetDoc.name),
        storyCount: storyOrder.length,
        storyOrder: storyOrder,
        stories: snapshots
    };

    var snapshotPaths = SnapshotWriter.buildSnapshotPaths(targetDoc.name, DATA_DIR);
    var snapshotJson = JSON.stringify(outJson, null, 2);

    if (writeTextFileObserved(snapshotPaths.docSpecific, snapshotJson, "before-snapshot-doc")) {
        log("Before-snapshot saved: " + snapshotPaths.docSpecific);
    }
    if (writeTextFileObserved(snapshotPaths.latest, snapshotJson, "before-snapshot-latest")) {
        log("Before-snapshot saved (latest): " + snapshotPaths.latest + " (" + storyOrder.length + " stories)");
    }
    return storyOrder.length;
}

function processStory(targetStory, importedSourceStyle, labelPrefix) {
    var beforeSnapshot;
    var afterSnapshot;
    var targetStyles;
    var mergeTotals;
    var mergeResult;
    var styleObj;
    var i;

    beforeSnapshot = captureStorySnapshot(targetStory);
    if (!isUsableStoryObject(targetStory)) {
        log("Acceptance story skip: " + labelPrefix + " reason=invalid story object");
        pushBundleIssue(labelPrefix + " invalid story object");
        return;
    }

    log("Acceptance story start: " + labelPrefix + " storyId=" + safeStoryId(targetStory));
    logStorySnapshot(labelPrefix + "_before", beforeSnapshot);

    SnapshotUtils.expandGeometrySplitFramesPreApply(targetStory, beforeSnapshot, labelPrefix, log);

    targetStyles = collectStoryParagraphStyles(targetStory, importedSourceStyle);
    mergeTotals = { styles: targetStyles.length, applied: 0, skipped: 0, failed: 0 };
    for (i = 0; i < targetStyles.length; i++) {
        styleObj = targetStyles[i];
        var sn = getParagraphStyleName(styleObj);
        if (sn && mergedStyleNames[sn]) {
            mergeTotals.skipped += CJK_FIELD_NAMES.length;
            continue;
        }
        mergeResult = mergeCjkFields(importedSourceStyle, styleObj);
        if (sn) {
            mergedStyleNames[sn] = true;
        }
        mergeTotals.applied += mergeResult.applied;
        mergeTotals.skipped += mergeResult.skipped;
        mergeTotals.failed += mergeResult.failed;
    }
    log(labelPrefix + " merged target styles: " + safe(mergeTotals.styles));
    log(labelPrefix + " merged CJK fields applied: " + safe(mergeTotals.applied));
    log(labelPrefix + " merged CJK fields skipped: " + safe(mergeTotals.skipped));
    log(labelPrefix + " merged CJK fields failed: " + safe(mergeTotals.failed));

    try {
        targetStory.recompose();
    } catch (e0) {}
    log(labelPrefix + " target story recomposed after merge.");

    afterSnapshot = captureStorySnapshot(targetStory);
    logStorySnapshot(labelPrefix + "_after_apply", afterSnapshot);

    // Repair is now handled by repair_after_apply.idjs (ordinalRepairPass)
    // which runs after all stories are processed and text cleanup is complete.

    log("Acceptance story finish: " + labelPrefix + " storyId=" + safe(beforeSnapshot.storyId));
}

// langDefault = CjkLanguageProfile.defaultFromLabels(...) (#148): where the target-language dropdown starts.
async function askCleanupOptions(langDefault, scopeLine) {
    langDefault = langDefault || { lang: "zh-CN", source: "default", known: false, note: "" };
    var dlg;
    var col;
    var cbSoft;
    var cbSpaces;
    var cbCollapse;
    var confirmed;
    var result;

    // #AUTO-CJK-CLEANUP (2026-05-26): AutomationBridge pre-seed for the
    // Text Pre-processing dialog. When MCP / bridge run with
    // automationOptions = { removeSoftReturns, removeSpaces,
    // collapseEmptyLines } the dialog is fully skipped (defaults true if
    // any field omitted).
    var autoOpts = cjkAutoOpts;   // read once in main() — never read again here
    // owner 2026-10-01 ②b: onlyParagraphs = [{ text, storyId? }] ⇒ text cleanup on ONLY
    // those paragraphs (lib/targeted_text_cleanup.js); no style-level CJK fields, no
    // frame repair, every other paragraph untouched. Only cleanups set to true run.
    if (autoOpts && Array.isArray(autoOpts.onlyParagraphs)) {
        return {
            onlyParagraphs: autoOpts.onlyParagraphs,
            removeSpaces: autoOpts.removeSpaces === true,
            removeSoftReturns: autoOpts.removeSoftReturns === true,
            collapseEmptyLines: false
        };
    }
    // targetLanguage (2026-09-22): picks the kinsoku/mojikumi profile
    // (lib/cjk_language_profile.js). Omitted => "zh-CN" = previous behaviour.
    if (autoOpts && (
        Object.prototype.hasOwnProperty.call(autoOpts, "removeSoftReturns") ||
        Object.prototype.hasOwnProperty.call(autoOpts, "removeSpaces") ||
        Object.prototype.hasOwnProperty.call(autoOpts, "collapseEmptyLines") ||
        Object.prototype.hasOwnProperty.call(autoOpts, "targetLanguage"))) {
        return {
            removeSoftReturns:  (autoOpts.removeSoftReturns !== false),
            removeSpaces:       (autoOpts.removeSpaces !== false),
            collapseEmptyLines: (autoOpts.collapseEmptyLines !== false),
            // explicit option wins; omitted => the document's own recorded language (#148), zh-CN only when none is recorded
            targetLanguage:     (typeof autoOpts.targetLanguage === "string" && autoOpts.targetLanguage) ? autoOpts.targetLanguage : langDefault.lang
        };
    }

    if (RunnerConfig.isRunnerActive(app)) {
        result = RunnerConfig.getCleanupOptions(app, {
            removeSoftReturns: true,
            removeSpaces: true,
            collapseEmptyLines: true
        });
        if (result && !result.targetLanguage) result.targetLanguage = langDefault.lang;
        return result;
    }

    // With automation options in hand this dialog is never opened (arch 2026-10-04): a modal on
    // a bridge-driven host kills the bridge until a person clicks. Options without any of the
    // cleanup fields (e.g. only targetPath) ⇒ the documented defaults.
    // No options ⇒ this is a run from the Scripts panel and the dialog is the right thing. (No
    // extra "marked automated" test here: the options were read a few lines up in main(), so
    // that mark without options could only come from state left by an EARLIER run — and then
    // refusing would break the manual run.)
    if (autoOpts) {
        return { removeSoftReturns: true, removeSpaces: true, collapseEmptyLines: true, targetLanguage: langDefault.lang };
    }

    var ddLang;
    try {
        dlg = app.dialogs.add({ name: "Text Pre-processing" });
        col = dlg.dialogColumns.add();
        col.staticTexts.add({ staticLabel: "Target language (line-breaking rules):" });
        var __ldIdx = CjkLanguageProfile.LANGUAGES.indexOf(langDefault.lang);
        ddLang     = col.dropdowns.add({ stringList: CjkLanguageProfile.LANGUAGES, selectedIndex: __ldIdx >= 0 ? __ldIdx : 0 });
        // say where the starting value came from, so a default never passes for a reading (#148)
        col.staticTexts.add({ staticLabel: langDefault.known
            ? "Starts at " + langDefault.lang + " (from the " + langDefault.source + ")."
            : "Starts at " + langDefault.lang + " (default). " + (langDefault.note || "") });
        if (scopeLine) col.staticTexts.add({ staticLabel: scopeLine });   // #147: say what the cleanup will touch
        col.staticTexts.add({ staticLabel: "Options (all enabled by default):" });
        cbSoft     = col.checkboxControls.add({ staticLabel: "Remove soft line breaks (Shift+Enter)",       checkedState: true });
        cbCollapse = col.checkboxControls.add({ staticLabel: "Collapse consecutive empty lines (spaces too)", checkedState: true });
        cbSpaces   = col.checkboxControls.add({ staticLabel: "Remove spaces between CJK and ASCII",          checkedState: true });
        confirmed = dlg.show();
        result = confirmed
            ? {
                removeSoftReturns: !!cbSoft.checkedState,
                removeSpaces: !!cbSpaces.checkedState,
                collapseEmptyLines: !!cbCollapse.checkedState,
                targetLanguage: CjkLanguageProfile.LANGUAGES[ddLang.selectedIndex] || langDefault.lang
            }
            : null;
        dlg.destroy();
        return result;
    } catch (e0) {
        try { if (dlg) { dlg.destroy(); } } catch (e1) {}
        return { removeSoftReturns: true, removeSpaces: true, collapseEmptyLines: true, targetLanguage: langDefault.lang };
    }
}

async function main() {
    var targetDoc;
    var targetStory;
    var targetStories;
    var liveStory;
    var sourceStyleNames;
    var sourceStyleName;
    var importedSourceStyle;
    var cleanupOpts;
    var cleanupSoftCount;
    var cleanupSpaceCount;
    var cleanupSymbolPunctCount;
    var cleanupCollapseCount;
    var i;
    var runnerActive;

    // UXP panel-double-click bootstrap: when __dirname is unavailable in the
    // Adobe native idjs loader, lib/runtime_paths.js can't auto-derive
    // BASE_DIR at module-load time. Resolve it now from app.activeScript
    // (async, only available inside main()), then RECOMPUTE the path
    // constants captured at top-of-module.
    if (!RuntimePaths.getBaseDir()) {
        await RuntimePaths.bootstrap();
        try {
            var __diag = RuntimePaths.getBootstrapDiag && RuntimePaths.getBootstrapDiag();
            if (__diag) {
                log("BOOTSTRAP DIAG: hasApp=" + safe(__diag.hasApp)
                    + " hasActiveScript=" + safe(__diag.hasActiveScript)
                    + " awaitedType=" + safe(__diag.awaitedType)
                    + " keys=" + safe(__diag.awaitedKeys)
                    + " pathRaw=" + safe(__diag.pathRaw)
                    + " pathFinal=" + safe(__diag.pathFinal)
                    + " err=" + safe(__diag.err));
            }
        } catch (eDiag) { log("BOOTSTRAP DIAG read err: " + safe(eDiag.message)); }
        BASE_DIR = RuntimePaths.getBaseDir();
        DATA_DIR = RuntimePaths.getDataDir();
        SOURCE_FILE_PATH = joinWindowsPath(joinWindowsPath(BASE_DIR, "lib"), "CJK.idml");
        DEFAULT_OUT_PATH = joinWindowsPath(RuntimePaths.getLogDir(), "cjk_style_apply_output.txt");
        OUT_PATH = RunnerConfig.getOutputPath(app, DEFAULT_OUT_PATH);
        log("BOOTSTRAP RESULT: BASE_DIR=" + safe(BASE_DIR) + " SOURCE=" + safe(SOURCE_FILE_PATH));
    }

    log("=== CJK Style Apply ===");

    if (!app.documents.length) {
        statusLine = "No open document.";
        log(statusLine);
        return;
    }

    // targetPath guard (arch 2026-10-03). This script works on app.activeDocument; an
    // automated run on a host that also has production documents open — with the SAME
    // file names as the development copies — would change whichever document happened to
    // be in front, and the log (it prints the name) could not tell the two apart.
    // automationOptions.targetPath (or sourcePath) names the document by path: not open ⇒
    // refuse; not active ⇒ activate; then the active path is read back. Refused ⇒ return
    // before anything is read or written. A run from the Scripts panel passes no options
    // and is unchanged.
    try { cjkAutoOpts = await AutomationBridge.readAutomationOptions("cjk_style_apply"); } catch (eGO) { cjkAutoOpts = null; }
    var __guardOpts = cjkAutoOpts;
    var __guardPath = (__guardOpts && (typeof __guardOpts.targetPath === "string" && __guardOpts.targetPath
        || typeof __guardOpts.sourcePath === "string" && __guardOpts.sourcePath)) || "";
    if (__guardPath) {
        var __guard = await AutoSourceGuard.enforceActive(app, __guardPath);
        if (!__guard.ok) {
            guardRefused = __guard.message;
            statusLine = "REFUSED: " + __guard.message;
            log(statusLine);
            log("open documents: " + __guard.openDocuments.map(function (d) { return (d.active ? "* " : "") + d.path; }).join(" | "));
            return;
        }
        log("targetPath guard: " + __guard.action + " — " + __guardPath);
    }

    targetDoc = app.activeDocument;
    targetDocRef = targetDoc;
    ensureAcceptanceBundle().documentName = safe(targetDoc.name);
    runnerActive = RunnerConfig.isRunnerActive(app);
    log("Target document: " + safe(targetDoc.name));
    try { var __tdFn = await targetDoc.fullName; log("Target document path: " + safe(__tdFn && __tdFn.nativePath ? __tdFn.nativePath : __tdFn)); } catch (eTdP) {}

    // §19.1 (arch 2026-10-06): the soft breaks the import put into the header-bar product names must
    // survive 'Remove soft line breaks'. Recognise the header bar the way the import does (structure,
    // not text) and keep those stories' breaks. Headings: the code has no reliable way to tell a
    // heading (font_mapping's per_role was never built) — NOT protected, and the log says so.
    var __hbSkipStories = [], __hbScanErr = null;
    try {
        var __hbScan = HeaderBar.scanDocument(targetDoc);
        (__hbScan.product_frames || []).concat(__hbScan.two_cell || []).forEach(function (f) { if (f && f.story_id != null && __hbSkipStories.indexOf(f.story_id) < 0) __hbSkipStories.push(f.story_id); });
        log("header bar: pages=" + __hbScan.pages + " bars=" + __hbScan.bars + " product_frames=" + (__hbScan.product_frames || []).length + " two_cell=" + (__hbScan.two_cell || []).length
            + " — soft breaks kept in story(ies) [" + __hbSkipStories.join(",") + "]; headings NOT protected (no reliable heading recognition in code)");
    } catch (eHB) { __hbScanErr = String(eHB && eHB.message ? eHB.message : eHB); log("header bar: scan failed — " + __hbScanErr + "; soft-break removal will NOT spare the header bar"); }

    // #148 (owner 2026-10-19, A): start the language at the one this document was imported for.
    // Labels are read from the document itself (project_meta_v1, then package_seq_v1); none readable => zh-CN,
    // shown as a default in the dialog and said in the log.
    var __langDefault;
    try {
        var __pmLabel = null, __psLabel = null;
        try { __pmLabel = ProjectMetaLabel.read(targetDoc); } catch (ePm) {}
        try { var __psRaw = targetDoc.extractLabel("package_seq_v1"); if (__psRaw && typeof __psRaw.then !== "function" && String(__psRaw).replace(/\s+/g, "")) __psLabel = JSON.parse(String(__psRaw)); } catch (ePs) {}
        __langDefault = CjkLanguageProfile.defaultFromLabels({ projectMeta: __pmLabel, packageSeq: __psLabel, written: WrittenParagraphs.read(targetDoc) });
    } catch (eLD) { __langDefault = CjkLanguageProfile.defaultFromLabels({}); }
    log("Target language default: " + __langDefault.lang + " (" + __langDefault.source + (__langDefault.known ? "" : "; " + __langDefault.note) + ")");

    // #147 (owner 2026-10-19): the cleanup acts on the CHANGED content only: paragraphs the last import wrote
    // and nobody has edited since (lib/written_paragraphs.js). No import record => the whole document (the old
    // behaviour, owner answer 3B). automationOptions.cleanupScope "document" asks for the whole document explicitly.
    var __scopeInfo = { mode: "document", reason: "no import record" }, __scopeEntries = null, __scopeRecord = null, __scopeStory = null;
    var __scopeTextOf = function (p) { return TargetedTextCleanup.paraText(p.para); };
    var __resolveScope = function () {
        var selStory = (runnerActive ? null : getSelectionStory());
        var selId = null; try { selId = selStory ? String(selStory.id) : null; } catch (eSelId) { selId = null; }
        return WrittenParagraphs.resolveScope({
            record: WrittenParagraphs.read(targetDoc), paragraphs: TargetedTextCleanup.collectParagraphs(targetDoc), textOf: __scopeTextOf,
            selectedStoryId: selId, selectionMode: CLEANUP_SELECTION_MODE,
            wantDocument: !!(cjkAutoOpts && cjkAutoOpts.cleanupScope === "document")
        });
    };
    try {
        var __rs = __resolveScope();
        __scopeInfo = __rs.info; __scopeEntries = __rs.entries; __scopeRecord = __rs.record; __scopeStory = __rs.info.storyId || null;
    } catch (eScope) { __scopeInfo = { mode: "document", reason: "import record unreadable" }; __scopeEntries = null; log("Cleanup scope: reading the import record threw: " + safe(eScope && eScope.message ? eScope.message : eScope)); }
    log("Cleanup scope: " + WrittenParagraphs.describeScope(__scopeInfo));

    cleanupOpts = await askCleanupOptions(__langDefault, WrittenParagraphs.describeScope(__scopeInfo));
    if (!cleanupOpts) {
        statusLine = "Cancelled.";
        log(statusLine);
        return;
    }

    if (cleanupOpts.onlyParagraphs) {
        // ②b: only the named paragraphs, text cleanup only — then stop.
        log("Mode: only " + cleanupOpts.onlyParagraphs.length + " named paragraph(s); removeSpaces="
            + cleanupOpts.removeSpaces + " removeSoftReturns=" + cleanupOpts.removeSoftReturns
            + " (no style-level CJK fields, no frame repair)");
        try {
            app.doScript(function () {
                targetedCleanupResult = TargetedTextCleanup.run(targetDoc, cleanupOpts.onlyParagraphs,
                    { removeSpaces: cleanupOpts.removeSpaces, removeSoftReturns: cleanupOpts.removeSoftReturns, skipSoftReturnStoryIds: __hbSkipStories }, TextCleanup);
            }, ScriptLanguage.JAVASCRIPT, undefined, UndoModes.ENTIRE_SCRIPT, "CJK Style Apply — named paragraphs");
        } catch (eTc) {
            statusLine = "FAILED: targeted cleanup: " + safe(eTc && eTc.message ? eTc.message : eTc);
            pushBundleIssue(statusLine);
            log(statusLine);
            return;
        }
        targetedCleanupResult.processed.forEach(function (p) {
            log("Cleaned (story " + safe(p.storyId) + "): spaces=" + p.spaces + " symbolPunct=" + p.symbol_punct_spaces
                + " softReturns=" + p.soft_returns + " → \"" + safe(p.after) + "\"");
        });
        targetedCleanupResult.problems.forEach(function (p) {
            var m = "named paragraph NOT cleaned (" + p.reason + "): \"" + safe(p.spec && p.spec.text) + "\"";
            log(m);
            pushBundleIssue(m);
        });
        runOk = targetedCleanupResult.problems.length === 0;
        statusLine = "Cleaned " + targetedCleanupResult.processed.length + " of " + cleanupOpts.onlyParagraphs.length
            + " named paragraph(s): " + targetedCleanupResult.totals.spaces + " CJK–Latin space(s), "
            + targetedCleanupResult.totals.symbol_punct_spaces + " symbol/punctuation space(s), "
            + targetedCleanupResult.totals.soft_returns + " soft return(s) removed"
            + (targetedCleanupResult.problems.length ? "; " + targetedCleanupResult.problems.length + " not found / ambiguous (listed)" : "") + ".";
        log(statusLine);
        return;
    }

    targetStory = runnerActive ? null : getSelectionStory();
    if (runnerActive) {
        targetStories = collectRepairableStories(targetDoc);
        log("Mode: all repairable stories (runner mode)");
        log("Repairable stories: " + safe(targetStories.length));
        if (!targetStories.length) {
            statusLine = "No repairable stories found.";
            log(statusLine);
            return;
        }
    } else if (targetStory) {
        targetStories = [safe(targetStory.id)];
        log("Mode: selected story");
    } else {
        targetStories = collectRepairableStories(targetDoc);
        log("Mode: all repairable stories");
        log("Repairable stories: " + safe(targetStories.length));
        if (!targetStories.length) {
            statusLine = "No repairable stories found.";
            log(statusLine);
            return;
        }
    }

    log("Source file: " + SOURCE_FILE_PATH);
    try {
        sourceDoc = StyleImport.openSourceDocument(SOURCE_FILE_PATH);
    } catch (e0) {
        statusLine = "Failed to open source document.";
        log(statusLine);
        log("Open error: " + safe(e0 && e0.message ? e0.message : e0));
        return;
    }
    log("Source document opened.");

    sourceStyleNames = StyleImport.listParagraphStyles(sourceDoc, true);
    log("Source styles: " + sourceStyleNames.length);
    if (!sourceStyleNames.length) {
        statusLine = "No non-default paragraph styles in source.";
        log(statusLine);
        return;
    }

    sourceStyleName = DEFAULT_SOURCE_STYLE_NAME;
    if (sourceStyleNames.indexOf(sourceStyleName) < 0) {
        sourceStyleName = sourceStyleNames[0];
    }
    log("Selected source style: " + sourceStyleName);

    // #CJK-LANG-PROFILE (2026-09-22; moved into the donor document 2026-09-29,
    // TODO #118): the only donor is Simplified Chinese. The kinsokuSet/mojikumi
    // override for the target language is written HERE, on the donor inside
    // CJK.idml (which holds every kinsoku/mojikumi table), and the donor is
    // saved as a carrier .indd that the import reads — the table travels with
    // the style. Writing it on the donor after import only works if the target
    // document already has that table; Client-A DocX-1 has none ⇒ silent NOTHING.
    var importSourcePath = SOURCE_FILE_PATH;
    var __lp = CjkLanguageProfile.resolve(cleanupOpts.targetLanguage);
    if (!__lp.known) {
        log("CJK language profile: UNKNOWN targetLanguage '" + safe(cleanupOpts.targetLanguage)
            + "' — donor (Simplified Chinese) rules kept.");
        pushBundleIssue("unknown targetLanguage '" + safe(cleanupOpts.targetLanguage) + "': Simplified-Chinese kinsoku/mojikumi kept");
    } else if (__lp.profile) {
        var __lpFail = null;
        try {
            var __donorInSource = StyleImport.findParagraphStyleByName(sourceDoc, sourceStyleName);
            if (!__donorInSource) {
                __lpFail = "donor style '" + safe(sourceStyleName) + "' not found in " + SOURCE_FILE_PATH;
            } else {
                __donorInSource.kinsokuSet = CjkLanguageProfile.enumOrName(indesign.KinsokuSet, __lp.profile.kinsokuSet);
                __donorInSource.mojikumi = CjkLanguageProfile.enumOrName(indesign.MojikumiTableDefaults, __lp.profile.mojikumi);
                var __ksSrc = CjkFieldCheck.normalizeFieldValue(getFieldValue(__donorInSource, "kinsokuSet"));
                var __mjSrc = CjkFieldCheck.normalizeFieldValue(getFieldValue(__donorInSource, "mojikumi"));
                log("CJK language profile (donor document): " + safe(cleanupOpts.targetLanguage)
                    + " kinsokuSet=" + safe(__ksSrc) + " mojikumi=" + safe(__mjSrc));
                if (!CjkLanguageProfile.readBackMatches(__lp.profile, __ksSrc, __mjSrc)) {
                    __lpFail = "not accepted by the donor document: kinsokuSet=" + safe(__ksSrc) + " mojikumi=" + safe(__mjSrc);
                } else {
                    tempDonorPath = joinWindowsPath(DATA_DIR, "cjk_donor_" + CjkLanguageProfile.donorFileTag(cleanupOpts.targetLanguage) + ".indd");
                    var __prevUil = app.scriptPreferences.userInteractionLevel;
                    app.scriptPreferences.userInteractionLevel = indesign.UserInteractionLevels.NEVER_INTERACT;
                    try { await sourceDoc.save(tempDonorPath); }
                    finally { app.scriptPreferences.userInteractionLevel = __prevUil; }
                    importSourcePath = tempDonorPath;
                    log("CJK language profile: donor carrier saved: " + tempDonorPath);
                }
            }
        } catch (eLpSrc) {
            __lpFail = "donor carrier failed: " + safe(eLpSrc && eLpSrc.message ? eLpSrc.message : eLpSrc);
        }
        if (__lpFail) {
            statusLine = "FAILED: CJK language profile " + safe(cleanupOpts.targetLanguage) + " — " + __lpFail
                + ". Nothing was changed in the document.";
            log(statusLine);
            pushBundleIssue(statusLine);
            return;
        }
    } else {
        log("CJK language profile: " + safe(cleanupOpts.targetLanguage) + " = donor as-is.");
    }

    StyleImport.closeDocNoSave(sourceDoc);
    sourceDoc = null;
    log("Source document closed.");
    log("Target focus restored after close: " + safe(restoreTargetDocumentFocus(targetDoc)));

    // === Single-undo wrap (2026-05-27): everything that mutates the doc
    // — style import, text cleanup, per-story CJK field merge, and the
    // delegated frame repair — runs inside one `app.doScript(ENTIRE_SCRIPT)`
    // block so a single Ctrl/Cmd+Z reverts the whole CJK style apply.
    //
    // Previously: importTextStylesOfficial + N cleanup ops + N processStory
    // calls + a SEPARATE runRepair (which opens its own ENTIRE_SCRIPT) each
    // produced their own undo history items (6+ entries for a 4-story doc).
    // Switched runRepair → runRepairCore for the same reason: runRepairCore
    // is the caller-wrapped variant that skips its own doScript open.
    //
    // Async-safety: every operation inside the wrap is synchronous in UXP
    // (style import, find/changeText, paragraph-style property writes,
    // FrameRepair's main()). The source-doc open/close + snapshot writes
    // remain ASYNC and live outside the wrap.
    var __abortReason = null;
    var __doScriptOk = true;
    // TODO #124 A: each table cell's composer BEFORE anything below changes it —
    // the reference for putting a Latin-only overset cell back (lib/cell_composer_restore.js).
    var __cellComposerSnap = null;
    try { __cellComposerSnap = CellComposerRestore.snapshotCellComposers(targetDoc); }
    catch (eSnap) { log("Cell composer snapshot FAILED: " + safe(eSnap && eSnap.message ? eSnap.message : eSnap)); }
    try {
        app.doScript(function () {
            StyleImport.importTextStylesOfficial(targetDoc, importSourcePath);
            log("Imported text styles from: " + importSourcePath);
            log("Official text style import complete.");
            log("Target focus restored after import: " + safe(restoreTargetDocumentFocus(targetDoc)));

            importedSourceStyle = StyleImport.findParagraphStyleByName(targetDoc, sourceStyleName);
            if (!importedSourceStyle) {
                __abortReason = "Imported source style not found in target document. Expected: " + sourceStyleName;
                return;
            }

            // #CJK-IMPORT-GUARD (2026-06-29): importStyles rebases the donor's
            // BasedOn to the target's Latin [No paragraph style], so any CJK
            // config the donor only INHERITED from the source root is dropped.
            // CJK.idml's donor style is authored to self-define its CJK fields
            // locally so the config survives import. This guard reads the
            // post-import donor and turns the otherwise-silent "merged N/0/0 but
            // every field empty" failure LOUD if that self-definition is ever
            // lost (e.g. a future template edit reverts to root inheritance).
            try {
                var __cjkRaw = {};
                for (var __ci = 0; __ci < CJK_FIELD_NAMES.length; __ci++) {
                    __cjkRaw[CJK_FIELD_NAMES[__ci]] = getFieldValue(importedSourceStyle, CJK_FIELD_NAMES[__ci]);
                }
                var __cjkDx = CjkFieldCheck.diagnoseCjkImport(__cjkRaw);
                log("CJK donor import check: kinsokuSet=" + safe(__cjkDx.kinsokuSet)
                    + " composer=" + safe(__cjkDx.composer)
                    + " appliedLanguage=" + safe(__cjkDx.appliedLanguage)
                    + " mojikumi=" + safe(__cjkDx.mojikumi)
                    + " kinsokuType=" + safe(CjkFieldCheck.normalizeFieldValue(__cjkRaw.kinsokuType))
                    + " kinsokuHangType=" + safe(CjkFieldCheck.normalizeFieldValue(__cjkRaw.kinsokuHangType))
                    + " bunriKinshi=" + safe(CjkFieldCheck.normalizeFieldValue(__cjkRaw.bunriKinshi))
                    + " rensuuji=" + safe(CjkFieldCheck.normalizeFieldValue(__cjkRaw.rensuuji))
                    + " treatIdeographicSpaceAsSpace=" + safe(CjkFieldCheck.normalizeFieldValue(__cjkRaw.treatIdeographicSpaceAsSpace))
                    + " allowArbitraryHyphenation=" + safe(CjkFieldCheck.normalizeFieldValue(__cjkRaw.allowArbitraryHyphenation)));
                if (__cjkDx.broken) {
                    cjkImportBroken = true;
                    cjkImportBrokenDetail = "kinsokuSet=" + safe(__cjkDx.kinsokuSet)
                        + " composer=" + safe(__cjkDx.composer)
                        + " appliedLanguage=" + safe(__cjkDx.appliedLanguage);
                    log("CJK IMPORT BROKEN: donor style '" + safe(sourceStyleName)
                        + "' has NO kinsoku config after import (kinsokuSet=" + safe(__cjkDx.kinsokuSet)
                        + "). Kinsoku (line-breaking rules) will NOT take effect. Fix: ensure lib/CJK.idml's donor"
                        + " style self-defines CJK fields LOCALLY (not via root BasedOn inheritance).");
                    pushBundleIssue("CJK import broken: donor '" + safe(sourceStyleName)
                        + "' lost kinsoku config (kinsokuSet=" + safe(__cjkDx.kinsokuSet) + ")");
                }
            } catch (eGuard) {
                log("CJK donor import check failed: " + safe(eGuard && eGuard.message ? eGuard.message : eGuard));
            }

            // #CJK-LANG-PROFILE read-back (TODO #118): the override was written
            // in the donor document (see main() above); prove it survived the
            // import. A mismatch FAILS the run before any merge — merging would
            // ship Simplified-Chinese (or no) line breaking under a zh-HK/ja/ko
            // label, and a log line alone went unnoticed (Client-A DocX-1).
            if (__lp.known && __lp.profile) {
                var __ksBack = CjkFieldCheck.normalizeFieldValue(getFieldValue(importedSourceStyle, "kinsokuSet"));
                var __mjBack = CjkFieldCheck.normalizeFieldValue(getFieldValue(importedSourceStyle, "mojikumi"));
                var __lpOk = CjkLanguageProfile.readBackMatches(__lp.profile, __ksBack, __mjBack);
                log("CJK language profile: " + safe(cleanupOpts.targetLanguage) + " kinsokuSet=" + safe(__ksBack)
                    + " mojikumi=" + safe(__mjBack) + (__lpOk ? " (read-back OK)" : " (READ-BACK MISMATCH)"));
                if (!__lpOk) {
                    __abortReason = "FAILED: CJK language profile " + safe(cleanupOpts.targetLanguage)
                        + " not applied after import (kinsokuSet=" + safe(__ksBack) + " mojikumi=" + safe(__mjBack)
                        + "). Stopped before merging; only the donor style '" + safe(sourceStyleName) + "' was imported.";
                    pushBundleIssue(__abortReason);
                    return;
                }
            }

            // Snapshot BEFORE cleanup + style apply so repair targets the
            // original layout. Writes JSON to disk (no doc mutation).
            saveBeforeSnapshot(targetDoc, targetStories);

            // Text cleanup: remove soft returns + collapse empty paragraphs
            // + remove CJK-ASCII spaces. Runs after snapshot so repair sees
            // pre-cleanup geometry, before style apply so font-metric reflow
            // is the only remaining delta.
            if (__scopeInfo.mode === "changed") {
                // select again NOW: the paragraph handles taken before the donor import / snapshot are not trusted (gate 12)
                var __wpFresh = __resolveScope();
                if (__wpFresh.info.matched !== __scopeInfo.matched) log("Cleanup scope: " + safe(__wpFresh.info.matched) + " paragraph(s) now, " + safe(__scopeInfo.matched) + " when the options were asked");
                __scopeEntries = __wpFresh.entries; __scopeRecord = __wpFresh.record;
                // changed content only (#147): per paragraph, later paragraphs first; header-bar soft breaks stay (section 19.1);
                // collapse acts inside each paragraph, never across the document (owner answer 2A)
                var __chg = TargetedTextCleanup.runEntries(__scopeEntries, {
                    removeSpaces: !!cleanupOpts.removeSpaces, removeSoftReturns: !!cleanupOpts.removeSoftReturns,
                    collapseEmptyLines: !!cleanupOpts.collapseEmptyLines, skipSoftReturnStoryIds: __hbSkipStories }, TextCleanup);
                cleanupSoftCount = __chg.totals.soft_returns; cleanupSpaceCount = __chg.totals.spaces;
                cleanupSymbolPunctCount = __chg.totals.symbol_punct_spaces; cleanupCollapseCount = __chg.totals.collapsed;
                log("Cleanup (changed paragraphs only, " + safe(__chg.processed.length) + " of them): " + safe(cleanupSoftCount) + " soft line break(s) removed; "
                    + safe(__chg.totals.soft_returns_kept) + " paragraph(s) kept their soft breaks in the header bar; " + safe(cleanupSpaceCount) + " CJK-ASCII space(s) and "
                    + safe(cleanupSymbolPunctCount) + " symbol/punctuation boundary space(s) removed; " + safe(cleanupCollapseCount) + " empty-line run(s) collapsed inside paragraphs; headings not protected.");
                // re-record what was cleaned (their text changed), so a second run still knows them and a later hand edit drops them
                try {
                    var __wpAfter = WrittenParagraphs.rebuildAfterClean(__scopeEntries, __scopeTextOf, new Date().toISOString(), __scopeRecord, __scopeStory);
                    if (__wpAfter && __scopeEntries.length) { var __wpWr = WrittenParagraphs.write(targetDoc, __wpAfter); log("Cleanup scope: record updated " + (__wpWr.ok ? "ok" : "FAILED " + safe(__wpWr.err)) + " (" + safe(__wpAfter.count) + " paragraph(s))"); }
                } catch (eWpRe) { log("Cleanup scope: record update threw: " + safe(eWpRe && eWpRe.message ? eWpRe.message : eWpRe)); }
            } else {
                if (cleanupOpts.removeSoftReturns) {
                    var __srRes = TextCleanup.removeSoftReturnsExcept(targetDoc, { skipStoryIds: __hbSkipStories });
                    cleanupSoftCount = __srRes.removed;
                    log("Cleanup: " + safe(cleanupSoftCount) + " soft line break(s) removed; " + safe(__srRes.kept) + " kept in the header bar"
                        + (__srRes.kept ? " (story: " + Object.keys(__srRes.kept_by_story).map(function (k) { return k + "×" + __srRes.kept_by_story[k]; }).join(", ") + ")" : "") + "; headings not protected.");
                }
                if (cleanupOpts.collapseEmptyLines) {
                    cleanupCollapseCount = TextCleanup.collapseEmptyParagraphs(targetDoc);
                    log("Cleanup: " + safe(cleanupCollapseCount) + " empty-line run(s) collapsed.");
                }
                if (cleanupOpts.removeSpaces) {
                    cleanupSpaceCount = TextCleanup.removeCjkAsciiSpaces(targetDoc);
                    log("Cleanup: " + safe(cleanupSpaceCount) + " CJK-ASCII space(s) removed.");
                    // TODO #20: same default-on `removeSpaces` gate also strips the
                    // half-width-symbol ↔ full-width-punctuation boundary space that
                    // removeCjkAsciiSpaces misses (e.g. ")␣、" -> ")、"). No new toggle.
                    cleanupSymbolPunctCount = TextCleanup.removeSymbolPunctSpaces(targetDoc);
                    log("Cleanup: " + safe(cleanupSymbolPunctCount) + " symbol/punctuation boundary space(s) removed.");
                }
            }

            for (i = 0; i < targetStories.length; i++) {
                log("Story loop enter: index=" + safe(i) + " storyId=" + safe(targetStories[i]));
                try {
                    liveStory = resolveLiveStoryById(targetDoc, targetStories[i]);
                    if (!isUsableStoryObject(liveStory)) {
                        log("Story loop skip: index=" + safe(i) + " storyId=" + safe(targetStories[i]) + " reason=story no longer valid");
                        pushBundleIssue("story[" + i + "] missing live story " + safe(targetStories[i]));
                        continue;
                    }
                    processStory(liveStory, importedSourceStyle, "story[" + i + "]");
                    log("Story loop exit: index=" + safe(i) + " storyId=" + safe(targetStories[i]));
                } catch (eStory) {
                    log("Story loop skip: index=" + safe(i) + " storyId=" + safe(targetStories[i]) + " reason=" + safe(eStory && eStory.message ? eStory.message : eStory));
                    pushBundleIssue("story[" + i + "] skipped after exception");
                }
            }

            // Overwrite para_deltas with empty object so repair uses zero
            // deltas. CJK style merge doesn't change paragraph count.
            var PARA_DELTAS_PATH = joinPath(DATA_DIR, "para_deltas_latest.json");
            if (writeTextFileObserved(PARA_DELTAS_PATH, "{}", "para-deltas-latest")) {
                log("Cleared para_deltas_latest.json (overwritten with empty object).");
            }

            // Delegate frame repair via runRepairCore — the caller-wrapped
            // variant. Skips its own doScript open so its work joins THIS
            // undo block instead of producing a separate history item.
            log("=== Delegating repair to lib/repair_after_apply.js (runRepairCore — inside our undo block) ===");
            try {
                var repairModule = require("./lib/repair_after_apply.js");
                var repairResult = repairModule.runRepairCore({ baseDir: BASE_DIR, dataDir: DATA_DIR });
                log("repair completed: " + safe(repairResult && repairResult.statusLine));
            } catch (eRepair) {
                log("repair FAILED: " + safe(eRepair && eRepair.message ? eRepair.message : eRepair));
                pushBundleIssue("repair failed: " + safe(eRepair && eRepair.message ? eRepair.message : eRepair));
            }
        }, ScriptLanguage.JAVASCRIPT, undefined, UndoModes.ENTIRE_SCRIPT, "CJK Style Apply");
    } catch (eDoScript) {
        __doScriptOk = false;
        var __dsMsg = safe(eDoScript && eDoScript.message ? eDoScript.message : eDoScript);
        log("doScript wrapper FAILED: " + __dsMsg);
        pushBundleIssue("doScript wrapper failed: " + __dsMsg);
    }

    if (__abortReason) {
        statusLine = __abortReason;
        log(statusLine);
        return;
    }

    // TODO #124: switching paragraphs to the Japanese composer can push a table
    // cell's text out of the cell (Select "$1,000": 9.18pt available, fits under
    // the Latin composer, overset under the Japanese one — findings
    // #cell-overset-japanese-composer). Nothing else reports it (frame / story
    // `overflows` stay false, cell.contents reads "").
    var __docLabel = ""; try { __docLabel = String(targetDoc.name); } catch (eDn) {}
    // A (arch 2026-09-30): an overset cell with NO CJK character gets its
    // pre-switch composer back (kinsoku acts only on CJK, nothing lost); a cell
    // with CJK is never changed. Every restore is listed (report + review sheet).
    if (__cellComposerSnap && __doScriptOk) {
        try {
            app.doScript(function () {
                cellComposerRestored = CellComposerRestore.restoreOversetLatinCells(targetDoc, __cellComposerSnap);
            }, ScriptLanguage.JAVASCRIPT, undefined, UndoModes.ENTIRE_SCRIPT, "CJK Style Apply — restore composer in overset Latin-only cells");
        } catch (eRc) { log("Cell composer restore FAILED: " + safe(eRc && eRc.message ? eRc.message : eRc)); pushBundleIssue("cell composer restore did not run"); }
        if (cellComposerRestored) {
            cellComposerRestored.restored.forEach(function (x) { log("Cell composer restored (was overset, fits now): " + __docLabel + " " + x.cell + " \"" + x.text + "\" " + x.from + " → " + x.to); });
            cellComposerRestored.notFitting.forEach(function (x) { log("Cell composer restore did not make it fit — put back: " + __docLabel + " " + x.cell + " \"" + x.text + "\""); });
            cellComposerRestored.errors.forEach(function (x) { pushBundleIssue("cell composer restore error: " + x); });
        }
    }
    // B: whatever is STILL overset is reported, one issue per cell — never hidden.
    var __cellOverset = [];
    try { __cellOverset = PostImportCheck.scanOversetCells(targetDoc); }
    catch (eCo) { log("Cell overset check FAILED to run: " + safe(eCo && eCo.message ? eCo.message : eCo)); pushBundleIssue("cell overset check did not run"); }
    // Not a failure of THIS step (runOk unchanged — arch 2026-09-30: the step ran,
    // a batch must not stop here) but BLOCKING for delivery: hidden text ⇒ someone
    // must handle it before a final PDF. The PDF gate reads automationResult.blocking.
    for (var __co = 0; __co < __cellOverset.length; __co++) {
        var __c = __cellOverset[__co];
        var __msg = "[BLOCKING] table cell text not shown (cell overset): " + __docLabel + " · " + __c.cell + " (" + __c.where + ") \"" + __c.text + "\"";
        log(__msg);
        pushBundleIssue(__msg);
        blockingIssues.push({ kind: "cell_overset", severity: "blocking", document: __docLabel, cell: __c.cell, where: __c.where, text: __c.text });
    }

    finalizeAcceptanceBundle(targetDoc);

    log("Target focus restored at end: " + safe(restoreTargetDocumentFocus(targetDoc)));

    statusLine = "CJK style applied and repaired for " + safe(targetStories.length) + " story(s).";
    if (cellComposerRestored && cellComposerRestored.restored.length) {
        statusLine += " " + cellComposerRestored.restored.length + " table cell(s) without CJK text got their original composer back so the text fits again (listed in cellComposerRestored).";
    }
    if (__cellOverset.length) {
        statusLine = "⚠ " + __cellOverset.length + " table cell(s) no longer show their text (overset after the CJK composer switch) — see issues. [" + statusLine + "]";
    }
    if (cjkImportBroken) {
        // Operator-visible loud failure: the deepest layer of this bug is that
        // an empty merge passed silently behind a "merged N/0/0" fake-green.
        statusLine = "⚠ KINSOKU NOT APPLIED — donor CJK config lost on import ("
            + cjkImportBrokenDetail + "). Kinsoku (line-breaking rules) is not in effect; fix lib/CJK.idml so the donor style carries local CJK fields. ["
            + statusLine + "]";
    }
    if (!__doScriptOk) {
        statusLine = "FAILED: doScript wrapper failed (see log). [" + statusLine + "]";
    }
    runOk = __doScriptOk && !cjkImportBroken;
}

// Best-effort removal of the per-language donor carrier (fs.unlinkSync is not
// available in UXP — lib/file_utils.js). A leftover is overwritten next run.
async function removeTempDonor() {
    if (!tempDonorPath) return;
    try {
        var lfs = require("uxp").storage.localFileSystem;
        var entry = await lfs.getEntryWithUrl("file:" + tempDonorPath.replace(/\\/g, "/"));
        await entry.delete();
        log("Donor carrier removed: " + tempDonorPath);
    } catch (eRm) {
        log("Donor carrier NOT removed (left for next run to overwrite): " + tempDonorPath
            + " — " + safe(eRm && eRm.message ? eRm.message : eRm));
    }
}

// Top-level await — IIFE breaks the bridge runner's async handshake.
await main().catch(function (e) {
    statusLine = "FAILED: " + (e && e.message ? e.message : e);
    log(statusLine);
    try { ensureAcceptanceBundle().errors.push(statusLine); } catch (eAB) {}
    try { pushBundleIssue(statusLine); } catch (ePB) {}
});

try {
    StyleImport.closeDocNoSave(sourceDoc);
} catch (e0) {}
await removeTempDonor();

try {
    if (acceptanceBundle) {
        finalizeAcceptanceBundle(targetDocRef);
    }
} catch (e1) {
    log("Acceptance bundle finalize failed: " + safe(e1 && e1.message ? e1.message : e1));
}

writeTextFileObserved(OUT_PATH, lines.join("\n"), "cjk-style-apply-log");
// Bridge callers read automationResult; before 2026-09-29 it was null and a
// failure was visible only in the log (TODO #118).
if (AutomationBridge.isAutomatedRun("cjk_style_apply")) {
    try {
        await AutomationBridge.recordAutomationResult("cjk_style_apply", {
            ok: runOk,
            refused: guardRefused ? "target_guard" : "",
            statusLine: statusLine,
            issues: acceptanceBundle ? acceptanceBundle.summary.issues : [],
            // TODO #124 A: every cell whose composer was put back (for the review sheet)
            cellComposerRestored: cellComposerRestored ? cellComposerRestored.restored : [],
            cellComposerNotFitting: cellComposerRestored ? cellComposerRestored.notFitting : [],
            // delivery gate (arch): non-empty ⇒ no final PDF until someone handles each
            blocking: blockingIssues,
            // owner 2026-10-01 ②b: onlyParagraphs mode — per paragraph counts + text after, and the misses
            targetedCleanup: targetedCleanupResult,
            logPath: OUT_PATH
        });
    } catch (eAR) {}
}
// Skip the trailing summary dialog when running headlessly. Without this
// the bridge / MCP run blocks on the modal until someone clicks OK.
if (!AutomationBridge.isAutomatedRun("cjk_style_apply")) {
    showStatusDialog(buildStatusText());
}
