var HeaderBar = require("./lib/header_bar.js");   // §19.1: soft breaks in the header bar stay (same recognition as the import)
var targetedCleanupResult = null;   // ②b: onlyParagraphs mode result, reported in automationResult
var cellComposerRestored = null;   // TODO #124 A result, reported in automationResult
