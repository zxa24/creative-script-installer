var SOURCE_FILE_PATH = joinWindowsPath(joinWindowsPath(BASE_DIR, "lib"), "CJK.idml");
var DEFAULT_SOURCE_STYLE_NAME = "CJK_Simplified_Chinese";
var DEFAULT_OUT_PATH = joinWindowsPath(RuntimePaths.getLogDir(), "cjk_style_apply_output.txt");
var OUT_PATH = RunnerConfig.getOutputPath(app, DEFAULT_OUT_PATH);
var ACCEPTANCE_BUNDLE_SUFFIX = "_acceptance_bundle";
var ACCEPTANCE_WATCH_PAGES = ["4", "5", "6"];
// Pre-apply geometry-split frame expansion: frames shorter than this threshold (document units)
// cannot hold a CJK line and will become empty after recompose. Expand them before apply.
var GEOM_SPLIT_HEIGHT_THRESHOLD = 0.15;
var GEOM_SPLIT_EXPAND_HEIGHT = 0.25;
var CJK_FIELD_NAMES = [
    "composer",
    "mojikumi",
    "kinsokuSet",
    "kinsokuType",
    "kinsokuHangType",
    "bunriKinshi",
